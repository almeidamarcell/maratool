---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Energy Converter — Joules, Calories, kWh & BTU | maratool',
  description: 'Convert joules to calories, kWh to BTU, electronvolts, and foot-pounds instantly with NIST factors. Free energy converter, runs in your browser.',
  canonical: 'https://maratool.com/energy-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Energy Converter — Joules, Calories, kWh & BTU',
    url: 'https://maratool.com/energy-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert joules to calories, kWh to BTU, electronvolts, and foot-pounds instantly with NIST factors. Free energy converter, runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Energy Converter — Joules, Calories, kWh & BTU', item: 'https://maratool.com/energy-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert kilocalorie / food calorie to kilojoule?', acceptedAnswer: { '@type': 'Answer', text: '1 kilocalorie / food calorie = 4.184 kilojoule. Choose "Kilocalorie / food Calorie (kcal)" as From and "Kilojoule (kJ)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'Are food Calories the same as calories?', acceptedAnswer: { '@type': 'Answer', text: 'A food Calorie (capital C, on nutrition labels) is one kilocalorie = 4,184 J. The small thermochemical calorie is 4.184 J — a factor of 1,000 apart.' } },
      { '@type': 'Question', name: 'How many BTU are in a kWh?', acceptedAnswer: { '@type': 'Answer', text: '1 kWh = 3,412.14 BTU (International Table). HVAC equipment is rated in BTU/h; multiply by run hours and divide by 3,412 to estimate kWh consumption.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert kilocalorie / food calorie to kilojoule?', a: '1 kilocalorie / food calorie = 4.184 kilojoule. Choose "Kilocalorie / food Calorie (kcal)" as From and "Kilojoule (kJ)" as To, type a value, and the result updates instantly.' },
  { q: 'Are food Calories the same as calories?', a: 'A food Calorie (capital C, on nutrition labels) is one kilocalorie = 4,184 J. The small thermochemical calorie is 4.184 J — a factor of 1,000 apart.' },
  { q: 'How many BTU are in a kWh?', a: '1 kWh = 3,412.14 BTU (International Table). HVAC equipment is rated in BTU/h; multiply by run hours and divide by 3,412 to estimate kWh consumption.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'power-converter', name: 'Power Converter' },
  { slug: 'pressure-converter', name: 'Pressure Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Energy Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="energy-converter" name="Energy Converter — Joules, Calories, kWh & BTU" description="Convert between joules, calories, kilowatt-hours, BTU, foot-pounds, and electronvolts using NIST SP 811 factors." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="enc-from-unit">From</label>
            <select id="enc-from-unit" class="uc-select"></select>
            <input type="number" id="enc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="enc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="enc-to-unit">To</label>
            <select id="enc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="enc-result">&mdash;</div>
            <button class="copy-btn" id="enc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the joule (SI) with conversion factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/energy-converter.js"></script>
