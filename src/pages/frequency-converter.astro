---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Frequency Converter — Hz, kHz, MHz & RPM | maratool',
  description: 'Convert hertz to kilohertz, megahertz, RPM, and radians per second instantly. Free frequency unit converter that runs entirely in your browser.',
  canonical: 'https://maratool.com/frequency-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Frequency Converter — Hz, kHz, MHz & RPM',
    url: 'https://maratool.com/frequency-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert hertz to kilohertz, megahertz, RPM, and radians per second instantly. Free frequency unit converter that runs entirely in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Frequency Converter — Hz, kHz, MHz & RPM', item: 'https://maratool.com/frequency-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert hertz to revolutions per minute?', acceptedAnswer: { '@type': 'Answer', text: '1 hertz = 60 revolutions per minute. Choose "Hertz (Hz)" as From and "Revolutions per minute (RPM)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How do I convert RPM to Hz?', acceptedAnswer: { '@type': 'Answer', text: 'Divide RPM by 60. A motor at 3,000 RPM spins at 50 Hz; a 7,200 RPM hard drive spins at 120 Hz.' } },
      { '@type': 'Question', name: 'What is the difference between Hz and rad/s?', acceptedAnswer: { '@type': 'Answer', text: 'Hz counts full cycles per second; rad/s measures angular velocity. One cycle is 2π radians, so ω (rad/s) = 2π × f (Hz). AC mains at 60 Hz is 376.99 rad/s.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert hertz to revolutions per minute?', a: '1 hertz = 60 revolutions per minute. Choose "Hertz (Hz)" as From and "Revolutions per minute (RPM)" as To, type a value, and the result updates instantly.' },
  { q: 'How do I convert RPM to Hz?', a: 'Divide RPM by 60. A motor at 3,000 RPM spins at 50 Hz; a 7,200 RPM hard drive spins at 120 Hz.' },
  { q: 'What is the difference between Hz and rad/s?', a: 'Hz counts full cycles per second; rad/s measures angular velocity. One cycle is 2π radians, so ω (rad/s) = 2π × f (Hz). AC mains at 60 Hz is 376.99 rad/s.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'angle-converter', name: 'Angle Converter' },
  { slug: 'bandwidth-converter', name: 'Bandwidth Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Frequency Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="frequency-converter" name="Frequency Converter — Hz, kHz, MHz & RPM" description="Convert between hertz, kilohertz, megahertz, gigahertz, RPM, and radians per second." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="fqc-from-unit">From</label>
            <select id="fqc-from-unit" class="uc-select"></select>
            <input type="number" id="fqc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="fqc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="fqc-to-unit">To</label>
            <select id="fqc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="fqc-result">&mdash;</div>
            <button class="copy-btn" id="fqc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the hertz (SI); rotational units use exact 1/60 and 1/(2π) relations per the <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener" target="_blank">BIPM SI Brochure</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/frequency-converter.js"></script>
