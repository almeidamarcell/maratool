---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Compress PDF Online — Reduce File Size | maratool',
  description: 'Compress PDF files online to reduce file size. Shrink documents right in your browser with no upload to servers. Free PDF compressor, no sign-up.',
  canonical: 'https://maratool.com/compress-pdf',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Compress PDF Online',
    url: 'https://maratool.com/compress-pdf',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Compress PDF files online to reduce file size. Shrink documents right in your browser with no upload to servers. Free PDF compressor, no sign-up.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Which compression method should I pick?', acceptedAnswer: { '@type': 'Answer', text: 'Rebuild the file when the PDF is mostly text and you want it to stay selectable and searchable. Flatten pages to images when the file is a scan or is full of photos and you need it under a hard size cap, such as an email attachment limit.' } },
      { '@type': 'Question', name: 'Why did rebuilding barely shrink my PDF?', acceptedAnswer: { '@type': 'Answer', text: 'Rebuilding repacks the file structure with object streams and drops unreferenced objects. It never touches the images, so a file exported by a modern tool is often already at that size. The tool shows the before and after bytes so you can see it, and suggests flattening when there is nothing left to gain.' } },
      { '@type': 'Question', name: 'What does the JPEG quality setting change?', acceptedAnswer: { '@type': 'Answer', text: 'It only applies to the flatten method. Each page is rendered at the resolution you choose and stored as a JPEG at that quality, so 40 makes a far smaller file with visible artefacts and 90 stays close to the original. It does nothing on the rebuild method, which is why it only appears when flattening is selected.' } },
      { '@type': 'Question', name: 'Does my file get uploaded?', acceptedAnswer: { '@type': 'Answer', text: 'No. The PDF is read, rendered and rewritten by JavaScript in your own browser tab, and the bytes never leave the machine.' } },
    ],
  },
}

const howTo = [
  'Drop the PDF in. It is read on your device, not uploaded.',
  'Pick Rebuild to keep the text selectable, or Flatten pages to images and set a JPEG quality and resolution for a much bigger cut.',
  'Click Process, check the before and after sizes, then download.',
]

const faq = [
  { q: 'Which method should I pick?', a: 'Rebuild for text documents you still want to select and search. Flatten to images for scans and photo-heavy files that must fit under a size cap.' },
  { q: 'Why did rebuilding barely shrink my PDF?', a: 'It repacks the file structure but leaves the images alone, so a file that was already exported efficiently has little left to give. The result panel shows the before and after bytes.' },
  { q: 'What does the JPEG quality setting change?', a: 'It applies only to the flatten method: each page becomes a JPEG at that quality and resolution. That is why it stays hidden while Rebuild is selected.' },
  { q: 'Does my file get uploaded?', a: 'No. Everything runs in your browser.' },
]

const relatedTools = [
  { slug: 'crop-pdf', name: 'Crop PDF Pages Online' },
  { slug: 'organize-pdf', name: 'Rearrange PDF Pages' },
  { slug: 'pdf-merge-split', name: 'Merge and Split PDF Pages' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'PDF', href: '/' },
  { label: 'Edit', href: '/' },
  { label: 'Compress PDF Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="compress-pdf" name="Compress PDF Online — Reduce File Size" description="Rebuild the file to keep the text selectable, or flatten the pages to JPEG at a quality you choose when the file has to get much smaller. Nothing is uploaded." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="compress-pdf">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="compress-pdf"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/compress-pdf.js"></script>
