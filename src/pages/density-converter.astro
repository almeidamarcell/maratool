---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Density Converter — kg/m³, g/cm³ & lb/ft³ | maratool',
  description: 'Convert kg/m³ to g/cm³, lb/ft³, lb/in³, and kg/L instantly with exact NIST-derived factors. Free density unit converter in your browser.',
  canonical: 'https://maratool.com/density-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Density Converter — kg/m³, g/cm³ & lb/ft³',
    url: 'https://maratool.com/density-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert kg/m³ to g/cm³, lb/ft³, lb/in³, and kg/L instantly with exact NIST-derived factors. Free density unit converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Density Converter — kg/m³, g/cm³ & lb/ft³', item: 'https://maratool.com/density-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert gram per cubic centimeter to kilogram per cubic meter?', acceptedAnswer: { '@type': 'Answer', text: '1 gram per cubic centimeter = 1000 kilogram per cubic meter. Choose "Gram per cubic centimeter (g/cm³)" as From and "Kilogram per cubic meter (kg/m³)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'What is the density of water in these units?', acceptedAnswer: { '@type': 'Answer', text: 'At 4 °C water is about 1 g/cm³ = 1,000 kg/m³ = 62.43 lb/ft³ = 8.345 lb/gal. Most quick calculations use exactly 1,000 kg/m³.' } },
      { '@type': 'Question', name: 'Are g/mL and g/cm³ the same?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — since 1965 the liter is defined as exactly 1 dm³, so 1 mL = 1 cm³ and the two density units are identical.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert gram per cubic centimeter to kilogram per cubic meter?', a: '1 gram per cubic centimeter = 1000 kilogram per cubic meter. Choose "Gram per cubic centimeter (g/cm³)" as From and "Kilogram per cubic meter (kg/m³)" as To, type a value, and the result updates instantly.' },
  { q: 'What is the density of water in these units?', a: 'At 4 °C water is about 1 g/cm³ = 1,000 kg/m³ = 62.43 lb/ft³ = 8.345 lb/gal. Most quick calculations use exactly 1,000 kg/m³.' },
  { q: 'Are g/mL and g/cm³ the same?', a: 'Yes — since 1965 the liter is defined as exactly 1 dm³, so 1 mL = 1 cm³ and the two density units are identical.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'volume-converter', name: 'Volume Converter' },
  { slug: 'molar-mass-converter', name: 'Molar Mass Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Density Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="density-converter" name="Density Converter — kg/m³, g/cm³ & lb/ft³" description="Convert between kg/m³, g/cm³, g/mL, lb/ft³, and lb/in³ using exact NIST-derived factors." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="dnc-from-unit">From</label>
            <select id="dnc-from-unit" class="uc-select"></select>
            <input type="number" id="dnc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="dnc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="dnc-to-unit">To</label>
            <select id="dnc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="dnc-result">&mdash;</div>
            <button class="copy-btn" id="dnc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through kg/m³ (SI) with factors derived exactly from NIST mass and volume definitions in <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/density-converter.js"></script>
