---
import Base from '../../layouts/Base.astro'
import Layout from '../../components/Layout.astro'
import HubPage from '../../components/HubPage.astro'
import { toolsByCategory, toolsFlatByCategory, subcategoryOrderByCategory, buildToolItemList } from '../../data/tools'

export function getStaticPaths() {
  const subs = subcategoryOrderByCategory.Converter ?? []
  const catTools = toolsByCategory.Converter ?? {}

  const descriptions: Record<string, { title: string; description: string; intro: string }> = {
    format: {
      title: 'Format Converter Tools — maratool',
      description: 'Free browser-based format converters. Convert CSV to JSON, HTML to Markdown, Base64 encode/decode, and text to binary — no sign-up, runs in your browser.',
      intro: 'Convert between data formats instantly — CSV, JSON, HTML, Markdown, Base64, and binary.',
    },
    document: {
      title: 'Document Converter Tools — maratool',
      description: 'Free browser-based document converters. Convert DOCX to PDF, EPUB to HTML, ODT to Markdown, and more — no upload to servers, runs in your browser.',
      intro: 'Convert between document formats — DOCX, EPUB, HTML, Markdown, ODT, RTF, and more.',
    },
    media: {
      title: 'Media File Converter Tools — maratool',
      description: 'Free browser-based file converters for images, audio, video, and documents. Convert 180+ formats locally with WebAssembly — no server upload.',
      intro: 'Convert images, audio, video, and documents in your browser — powered by ImageMagick, FFmpeg, and Pandoc WASM.',
    },
    unit: {
      title: 'Unit Converter Tools — maratool',
      description: 'Free browser-based unit converters. Convert area, volume, pressure, energy, power, fuel economy, timestamps, and more — no sign-up, runs in your browser.',
      intro: 'Convert between physical units and representations quickly in your browser.',
    },
    science: {
      title: 'Scientific Unit Converters — maratool',
      description: 'Free scientific unit converters — moles, molar mass, dynamic and kinematic viscosity, mass and volumetric flow rates. NIST factors, runs in your browser.',
      intro: 'Chemistry and fluid-dynamics unit conversions with NIST-audited factors.',
    },
    electrical: {
      title: 'Electrical Unit Converters — maratool',
      description: 'Free electrical unit converters — capacitance, charge, current, voltage, conductance, resistance, and inductance. Exact SI prefixes, runs in your browser.',
      intro: 'Convert electrical quantities across SI prefixes and CGS units.',
    },
    magnetism: {
      title: 'Magnetism Unit Converters — maratool',
      description: 'Free magnetism unit converters — tesla to gauss, oersted to A/m, weber to maxwell, and gilberts. Exact SI/CGS relations, runs in your browser.',
      intro: 'Bridge SI and CGS magnetic units with exact conversion relations.',
    },
    light: {
      title: 'Light & Photometry Unit Converters — maratool',
      description: 'Free photometry converters — lux to foot-candles, nits to foot-lamberts, lumens, candela, and luminous energy. NIST factors, runs in your browser.',
      intro: 'Photometric unit conversions for lighting, displays, and photography.',
    },
    radiation: {
      title: 'Radiation Unit Converters — maratool',
      description: 'Free radiation unit converters — gray to rad, sievert to rem, becquerel to curie. Exact regulatory factors, runs in your browser. Not medical advice.',
      intro: 'Convert radiation dose and activity units with exact regulatory factors.',
    },
    sizing: {
      title: 'Sizing Converters & Calculators — maratool',
      description: 'Free sizing tools — tire size comparison, TV and monitor dimensions, clothing sizes across US/EU/UK, and hat sizes. Runs entirely in your browser.',
      intro: 'Real-world sizing: tires, screens, clothing, and hats.',
    },
  }

  return subs.map(sub => {
    const slug = sub.toLowerCase()
    const meta = descriptions[slug] ?? {
      title: `${sub} Tools — maratool`,
      description: `Free browser-based ${sub.toLowerCase()} tools — no sign-up, runs entirely in your browser.`,
      intro: `${sub} tools that run locally in your browser.`,
    }
    return {
      params: { subcategory: slug },
      props: { sub, subTools: catTools[sub] ?? [], ...meta },
    }
  })
}

const { subcategory } = Astro.params
const { sub, subTools, title, description, intro } = Astro.props
const allTools = toolsFlatByCategory.Converter ?? []
const subcategories = subcategoryOrderByCategory.Converter ?? []
const liveSubTools = subTools.filter((tool: { live: boolean }) => tool.live)

const seo = {
  title,
  description,
  canonical: `https://maratool.com/converter/${subcategory}`,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${sub} Converter Tools`,
    url: `https://maratool.com/converter/${subcategory}`,
    description,
    hasPart: liveSubTools.map((tool: { name: string; slug: string }) => ({
      '@type': 'SoftwareApplication',
      name: tool.name,
      url: `https://maratool.com/${tool.slug}`,
      applicationCategory: 'DeveloperApplication',
    })),
    mainEntity: buildToolItemList(liveSubTools, `${sub} Converter Tools`),
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: sub, item: `https://maratool.com/converter/${subcategory}` },
    ],
  },
}
---
<Base {...seo} scope="subcategory">
  <Layout scope="subcategory">
    <HubPage
      category="Converter"
      categorySlug="converter"
      title={`${sub} converter tools`}
      subtitle={intro}
      tools={allTools}
      subcategories={subcategories}
      activeSubcategory={sub}
      basePath="/converter"
    />
  </Layout>
</Base>
