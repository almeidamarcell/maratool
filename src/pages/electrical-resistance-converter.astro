---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Resistance Converter — Ohms, kΩ & MΩ | maratool',
  description: 'Convert electrical resistance between ohms, kiloohms, megaohms, and gigaohms instantly. Free resistance unit converter that runs in your browser.',
  canonical: 'https://maratool.com/electrical-resistance-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Electrical Resistance Converter — Ohms, kΩ & MΩ',
    url: 'https://maratool.com/electrical-resistance-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert electrical resistance between ohms, kiloohms, megaohms, and gigaohms instantly. Free resistance unit converter that runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Electrical', item: 'https://maratool.com/converter/electrical' },
      { '@type': 'ListItem', position: 4, name: 'Electrical Resistance Converter — Ohms, kΩ & MΩ', item: 'https://maratool.com/electrical-resistance-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert kiloohm to ohm?', acceptedAnswer: { '@type': 'Answer', text: '1 kiloohm = 1000 ohm. Choose "Kiloohm (kΩ)" as From and "Ohm (Ω)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'What does 4K7 mean on a schematic?', acceptedAnswer: { '@type': 'Answer', text: 'The letter marks the decimal point: 4K7 = 4.7 kΩ = 4,700 Ω. Similarly 2M2 = 2.2 MΩ and R47 = 0.47 Ω.' } },
      { '@type': 'Question', name: 'When do milliohms matter?', acceptedAnswer: { '@type': 'Answer', text: 'Current-sense shunts, PCB traces, and battery internal resistance all live in the mΩ range — a 10 mΩ shunt at 10 A drops 100 mV and dissipates 1 W.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert kiloohm to ohm?', a: '1 kiloohm = 1000 ohm. Choose "Kiloohm (kΩ)" as From and "Ohm (Ω)" as To, type a value, and the result updates instantly.' },
  { q: 'What does 4K7 mean on a schematic?', a: 'The letter marks the decimal point: 4K7 = 4.7 kΩ = 4,700 Ω. Similarly 2M2 = 2.2 MΩ and R47 = 0.47 Ω.' },
  { q: 'When do milliohms matter?', a: 'Current-sense shunts, PCB traces, and battery internal resistance all live in the mΩ range — a 10 mΩ shunt at 10 A drops 100 mV and dissipates 1 W.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'electrical-conductance-converter', name: 'Conductance Converter' },
  { slug: 'electric-current-converter', name: 'Electric Current' },
  { slug: 'electric-potential-converter', name: 'Electric Potential' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Electrical', href: '/converter/electrical' },
  { label: 'Resistance Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="electrical-resistance-converter" name="Electrical Resistance Converter — Ohms, kΩ & MΩ" description="Convert between ohms, milliohms, kiloohms, megaohms, and gigaohms." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="erc-from-unit">From</label>
            <select id="erc-from-unit" class="uc-select"></select>
            <input type="number" id="erc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="erc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="erc-to-unit">To</label>
            <select id="erc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="erc-result">&mdash;</div>
            <button class="copy-btn" id="erc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the ohm using exact SI prefixes; CGS units use factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/electrical-resistance-converter.js"></script>
