---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Electric Charge Converter — Coulombs, Ah & mAh | maratool',
  description: 'Convert electric charge between coulombs, ampere-hours, and milliamp-hours instantly. Free charge unit converter for battery and electronics work.',
  canonical: 'https://maratool.com/electric-charge-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Electric Charge Converter — Coulombs, Ah & mAh',
    url: 'https://maratool.com/electric-charge-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert electric charge between coulombs, ampere-hours, and milliamp-hours instantly. Free charge unit converter for battery and electronics work.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Electrical', item: 'https://maratool.com/converter/electrical' },
      { '@type': 'ListItem', position: 4, name: 'Electric Charge Converter — Coulombs, Ah & mAh', item: 'https://maratool.com/electric-charge-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert milliampere-hour to coulomb?', acceptedAnswer: { '@type': 'Answer', text: '1 milliampere-hour = 3.6 coulomb. Choose "Milliampere-hour (mAh)" as From and "Coulomb (C)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many coulombs are in a 3000 mAh battery?', acceptedAnswer: { '@type': 'Answer', text: '3,000 mAh × 3.6 = 10,800 C. Each mAh is exactly 3.6 coulombs (0.001 A × 3600 s).' } },
      { '@type': 'Question', name: 'Is mAh a measure of energy?', acceptedAnswer: { '@type': 'Answer', text: 'No — it is charge. Energy = charge × voltage: a 3,000 mAh cell at 3.7 V holds 11.1 Wh. Comparing batteries by mAh only works at the same voltage.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert milliampere-hour to coulomb?', a: '1 milliampere-hour = 3.6 coulomb. Choose "Milliampere-hour (mAh)" as From and "Coulomb (C)" as To, type a value, and the result updates instantly.' },
  { q: 'How many coulombs are in a 3000 mAh battery?', a: '3,000 mAh × 3.6 = 10,800 C. Each mAh is exactly 3.6 coulombs (0.001 A × 3600 s).' },
  { q: 'Is mAh a measure of energy?', a: 'No — it is charge. Energy = charge × voltage: a 3,000 mAh cell at 3.7 V holds 11.1 Wh. Comparing batteries by mAh only works at the same voltage.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'electric-current-converter', name: 'Electric Current' },
  { slug: 'capacitance-converter', name: 'Capacitance Converter' },
  { slug: 'energy-converter', name: 'Energy Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Electrical', href: '/converter/electrical' },
  { label: 'Electric Charge' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="electric-charge-converter" name="Electric Charge Converter — Coulombs, Ah & mAh" description="Convert between coulombs, ampere-hours, milliamp-hours, and faradays." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="ecc-from-unit">From</label>
            <select id="ecc-from-unit" class="uc-select"></select>
            <input type="number" id="ecc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="ecc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="ecc-to-unit">To</label>
            <select id="ecc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="ecc-result">&mdash;</div>
            <button class="copy-btn" id="ecc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the coulomb (1 A·s) using exact time factors and constants from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/electric-charge-converter.js"></script>
