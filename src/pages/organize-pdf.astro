---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const desc = 'Rearrange PDF pages online — drag to reorder, rotate pages 90°, and delete pages you don\'t need. Free, runs in your browser with no upload needed.'

const seo = {
  title: 'Rearrange PDF Pages — Reorder, Rotate & Delete Online | maratool',
  description: 'Rearrange PDF pages online — drag to reorder, rotate pages 90°, and delete pages you don\'t need. Free, runs in your browser with no upload needed.',
  canonical: 'https://maratool.com/organize-pdf',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Rearrange PDF Pages — Reorder, Rotate & Delete',
    url: 'https://maratool.com/organize-pdf',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: desc,
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'PDF', item: 'https://maratool.com/pdf' },
      { '@type': 'ListItem', position: 3, name: 'Edit', item: 'https://maratool.com/pdf/edit' },
      { '@type': 'ListItem', position: 4, name: 'Rearrange PDF Pages', item: 'https://maratool.com/organize-pdf' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I change the order of pages in a PDF?', acceptedAnswer: { '@type': 'Answer', text: 'Upload the PDF, then drag the page thumbnails into the order you want — or use the arrow buttons on each page. Click "Download PDF" to save the result.' } },
      { '@type': 'Question', name: 'Can I rotate just one page in a PDF?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Click the rotate button on that page\'s thumbnail; each click turns it 90° clockwise. Other pages are left untouched.' } },
      { '@type': 'Question', name: 'Is my PDF uploaded to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Rendering uses pdf.js and editing uses pdf-lib, both running locally in your browser. The file never leaves your device.' } },
      { '@type': 'Question', name: 'Does rearranging or rotating pages reduce quality?', acceptedAnswer: { '@type': 'Answer', text: 'No. Pages are copied into the new PDF without re-rendering, and rotation is stored as page metadata — text, images, and vector content stay identical.' } },
    ],
  },
}

const howTo = [
  'Drop a PDF to see every page as a thumbnail.',
  'Drag pages into a new order, or use the rotate and delete buttons on each page.',
  'Click "Download PDF" to save the reorganized file — nothing leaves your browser.',
]

const faq = [
  { q: 'How do I change the order of pages in a PDF?', a: 'Upload the PDF, then drag the page thumbnails into the order you want — or use the arrow buttons on each page. Click "Download PDF" to save the result.' },
  { q: 'Can I rotate just one page in a PDF?', a: 'Yes. Click the rotate button on that page\'s thumbnail; each click turns it 90° clockwise. Other pages are left untouched.' },
  { q: 'Is my PDF uploaded to a server?', a: 'No. Rendering uses pdf.js and editing uses pdf-lib, both running locally in your browser. The file never leaves your device.' },
  { q: 'Does rearranging or rotating pages reduce quality?', a: 'No. Pages are copied into the new PDF without re-rendering, and rotation is stored as page metadata — text, images, and vector content stay identical.' },
]

const relatedTools = [
  { slug: 'pdf-merge-split', name: 'Merge and Split PDF Pages' },
  { slug: 'crop-pdf', name: 'Crop PDF Pages Online' },
  { slug: 'pdf-metadata', name: 'PDF Page Counter & Metadata Viewer' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'PDF', href: '/pdf' },
  { label: 'Edit', href: '/pdf/edit' },
  { label: 'Rearrange PDF Pages' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="organize-pdf" name="Rearrange PDF Pages — Reorder, Rotate & Delete" description={desc} howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:480px;" data-ui="organize-pdf">
        <div class="pdf-dropzone" id="op-dropzone">
          <input type="file" id="op-file" accept="application/pdf" hidden />
          <div class="pdf-dropzone-inner">
            <svg class="pdf-upload-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <p class="pdf-dropzone-title">Drop a PDF here</p>
            <p class="pdf-dropzone-sub">or click to select a file</p>
          </div>
        </div>

        <p id="op-info" class="pdf-file-info"></p>
        <div id="op-progress" class="pdf-progress" style="display:none;"></div>

        <div id="op-toolbar" class="op-toolbar" style="display:none;">
          <span id="op-count" class="op-count"></span>
          <button id="op-rotate-all" class="tool-button tool-button-ghost" type="button">Rotate all 90°</button>
          <button id="op-undo" class="tool-button tool-button-ghost" type="button" disabled>Undo</button>
          <button id="op-reset" class="tool-button tool-button-ghost" type="button">Reset</button>
          <button id="op-download" class="tool-button" type="button">Download PDF</button>
        </div>

        <div id="op-grid" class="op-grid"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .op-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0.75rem 0;
  }
  .op-count {
    font-size: 0.875rem;
    color: var(--text-2);
    margin-right: auto;
  }
  .op-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .op-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    cursor: grab;
  }
  .op-card.op-dragging { opacity: 0.4; }
  .op-card.op-drop-target { border-color: var(--accent); }
  .op-thumb-wrap {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--bg);
    border-radius: 6px;
  }
  .op-thumb-wrap canvas {
    max-width: 100%;
    max-height: 100%;
    transition: transform 0.15s ease;
  }
  .op-page-num {
    font-size: 0.75rem;
    color: var(--text-2);
    text-align: center;
  }
  .op-card-controls {
    display: flex;
    gap: 0.25rem;
    justify-content: center;
  }
  .op-btn {
    width: 30px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    cursor: pointer;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-2);
  }
  .op-btn:hover { background: var(--bg-hover); }
  .op-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .op-btn-del { color: #b91c1c; }
  .op-btn-del:hover { background: var(--error-bg, #fef2f2); }
</style>

<script src="../tools/organize-pdf.js"></script>
