---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Inductance Converter — Henry, mH & µH | maratool',
  description: 'Convert inductance between henries, millihenries, microhenries, and nanohenries instantly. Free inductance unit converter that runs in your browser.',
  canonical: 'https://maratool.com/inductance-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Inductance Converter — Henry, mH & µH',
    url: 'https://maratool.com/inductance-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert inductance between henries, millihenries, microhenries, and nanohenries instantly. Free inductance unit converter that runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Electrical', item: 'https://maratool.com/converter/electrical' },
      { '@type': 'ListItem', position: 4, name: 'Inductance Converter — Henry, mH & µH', item: 'https://maratool.com/inductance-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert millihenry to microhenry?', acceptedAnswer: { '@type': 'Answer', text: '1 millihenry = 1000 microhenry. Choose "Millihenry (mH)" as From and "Microhenry (µH)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many µH are in a mH?', acceptedAnswer: { '@type': 'Answer', text: '1,000 µH. Buck-converter inductors run 1–100 µH, audio chokes 1–100 mH, and RF inductors just a few nH.' } },
      { '@type': 'Question', name: 'What does 4R7 mean on an inductor?', acceptedAnswer: { '@type': 'Answer', text: 'Like resistors, the letter is the decimal point — 4R7 = 4.7 µH on most SMD power inductors (the implied unit is µH). 471 means 470 µH (47 × 10¹).' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert millihenry to microhenry?', a: '1 millihenry = 1000 microhenry. Choose "Millihenry (mH)" as From and "Microhenry (µH)" as To, type a value, and the result updates instantly.' },
  { q: 'How many µH are in a mH?', a: '1,000 µH. Buck-converter inductors run 1–100 µH, audio chokes 1–100 mH, and RF inductors just a few nH.' },
  { q: 'What does 4R7 mean on an inductor?', a: 'Like resistors, the letter is the decimal point — 4R7 = 4.7 µH on most SMD power inductors (the implied unit is µH). 471 means 470 µH (47 × 10¹).' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'capacitance-converter', name: 'Capacitance Converter' },
  { slug: 'magnetic-flux-converter', name: 'Magnetic Flux' },
  { slug: 'frequency-converter', name: 'Frequency Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Electrical', href: '/converter/electrical' },
  { label: 'Inductance Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="inductance-converter" name="Inductance Converter — Henry, mH & µH" description="Convert between henries, millihenries, microhenries, and nanohenries." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="inc-from-unit">From</label>
            <select id="inc-from-unit" class="uc-select"></select>
            <input type="number" id="inc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="inc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="inc-to-unit">To</label>
            <select id="inc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="inc-result">&mdash;</div>
            <button class="copy-btn" id="inc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the henry using exact SI prefixes; CGS units use factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/inductance-converter.js"></script>
