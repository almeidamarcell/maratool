---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Luminous Energy Converter — lm·s & Talbots | maratool',
  description: 'Convert luminous energy between lumen-seconds, talbots, lumen-minutes, and lumen-hours instantly. Free photometry unit converter in your browser.',
  canonical: 'https://maratool.com/luminous-energy-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Luminous Energy Converter — Lumen-Seconds & Talbots',
    url: 'https://maratool.com/luminous-energy-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert luminous energy between lumen-seconds, talbots, lumen-minutes, and lumen-hours instantly. Free photometry unit converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Light', item: 'https://maratool.com/converter/light' },
      { '@type': 'ListItem', position: 4, name: 'Luminous Energy Converter — Lumen-Seconds & Talbots', item: 'https://maratool.com/luminous-energy-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert lumen-hour to lumen-second?', acceptedAnswer: { '@type': 'Answer', text: '1 lumen-hour = 3600 lumen-second. Choose "Lumen-hour (lm·h)" as From and "Lumen-second (lm·s)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'What is a talbot?', acceptedAnswer: { '@type': 'Answer', text: 'The talbot is the historical name for the lumen-second — total light emitted over time, the photometric analog of the joule. The names are exact synonyms.' } },
      { '@type': 'Question', name: 'Where is luminous energy used?', acceptedAnswer: { '@type': 'Answer', text: 'Flash photography (a strobe emits a fixed lm·s per pulse), UV-cure dosing, and integrating light exposure over time. Continuous lighting is quoted in lumens instead.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert lumen-hour to lumen-second?', a: '1 lumen-hour = 3600 lumen-second. Choose "Lumen-hour (lm·h)" as From and "Lumen-second (lm·s)" as To, type a value, and the result updates instantly.' },
  { q: 'What is a talbot?', a: 'The talbot is the historical name for the lumen-second — total light emitted over time, the photometric analog of the joule. The names are exact synonyms.' },
  { q: 'Where is luminous energy used?', a: 'Flash photography (a strobe emits a fixed lm·s per pulse), UV-cure dosing, and integrating light exposure over time. Continuous lighting is quoted in lumens instead.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'luminous-flux-converter', name: 'Luminous Flux' },
  { slug: 'illuminance-converter', name: 'Lux to Foot-Candles' },
  { slug: 'energy-converter', name: 'Energy Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Light', href: '/converter/light' },
  { label: 'Luminous Energy' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="luminous-energy-converter" name="Luminous Energy Converter — Lumen-Seconds & Talbots" description="Convert luminous energy between lumen-seconds (talbots), lumen-minutes, and lumen-hours." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="lec-from-unit">From</label>
            <select id="lec-from-unit" class="uc-select"></select>
            <input type="number" id="lec-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="lec-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="lec-to-unit">To</label>
            <select id="lec-to-unit" class="uc-select"></select>
            <div class="uc-result" id="lec-result">&mdash;</div>
            <button class="copy-btn" id="lec-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Luminous energy is converted through the lumen-second (talbot) with exact time factors per the <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener" target="_blank">BIPM SI Brochure</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/luminous-energy-converter.js"></script>
