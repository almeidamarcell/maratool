---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Sievert to Rem Converter — Equivalent Dose | maratool',
  description: 'Convert equivalent radiation dose between sieverts, millisieverts, and rems instantly — 1 Sv = 100 rem exactly. Free converter in your browser.',
  canonical: 'https://maratool.com/equivalent-dose-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Sievert to Rem Converter — Equivalent Radiation Dose',
    url: 'https://maratool.com/equivalent-dose-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert equivalent radiation dose between sieverts, millisieverts, and rems instantly — 1 Sv = 100 rem exactly. Free converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Radiation', item: 'https://maratool.com/converter/radiation' },
      { '@type': 'ListItem', position: 4, name: 'Sievert to Rem Converter — Equivalent Radiation Dose', item: 'https://maratool.com/equivalent-dose-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert millisievert to millirem?', acceptedAnswer: { '@type': 'Answer', text: '1 millisievert = 100 millirem. Choose "Millisievert (mSv)" as From and "Millirem (mrem)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many mrem is 1 mSv?', acceptedAnswer: { '@type': 'Answer', text: '100 mrem. US dose reports use mrem, international ones mSv — average US background exposure is ~620 mrem/year, i.e. 6.2 mSv.' } },
      { '@type': 'Question', name: 'Does converting Sv to rem change the health meaning?', acceptedAnswer: { '@type': 'Answer', text: 'No — both already include the radiation weighting factor. The conversion is purely numeric (×100). What it does not do is tell you whether a given dose is safe; that depends on context and regulation.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert millisievert to millirem?', a: '1 millisievert = 100 millirem. Choose "Millisievert (mSv)" as From and "Millirem (mrem)" as To, type a value, and the result updates instantly.' },
  { q: 'How many mrem is 1 mSv?', a: '100 mrem. US dose reports use mrem, international ones mSv — average US background exposure is ~620 mrem/year, i.e. 6.2 mSv.' },
  { q: 'Does converting Sv to rem change the health meaning?', a: 'No — both already include the radiation weighting factor. The conversion is purely numeric (×100). What it does not do is tell you whether a given dose is safe; that depends on context and regulation.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'absorbed-dose-converter', name: 'Gray to Rad' },
  { slug: 'radioactivity-converter', name: 'Becquerel to Curie' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Radiation', href: '/converter/radiation' },
  { label: 'Sievert to Rem' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="equivalent-dose-converter" name="Sievert to Rem Converter — Equivalent Radiation Dose" description="Convert equivalent dose between sieverts, millisieverts, microsieverts, rems, and millirems." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="edc-from-unit">From</label>
            <select id="edc-from-unit" class="uc-select"></select>
            <input type="number" id="edc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="edc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="edc-to-unit">To</label>
            <select id="edc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="edc-result">&mdash;</div>
            <button class="copy-btn" id="edc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Equivalent dose is converted through the sievert; the rem relation (1 Sv = 100 rem exactly) follows <a href="https://www.nrc.gov/about-nrc/radiation/health-effects/measuring-radiation.html" rel="noopener" target="_blank">US NRC — Measuring Radiation</a>. <em>Unit conversion only — this does not assess dose, risk, or safety, and is not medical advice.</em></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/equivalent-dose-converter.js"></script>
