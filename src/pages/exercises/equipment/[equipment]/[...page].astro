---
import type { GetStaticPaths, Page } from 'astro'
import Base from '../../../../layouts/Base.astro'
import Layout from '../../../../components/Layout.astro'
import ExerciseHub from '../../../../components/exercises/ExerciseHub.astro'
import { byEquipment, HUB_PAGE_SIZE } from '../../../../data/exercises'
import type { Exercise } from '../../../../data/exercises'

export const getStaticPaths = (({ paginate }) =>
  Object.entries(byEquipment).flatMap(([equipment, list]) =>
    paginate(list, {
      params: { equipment: equipment.replace(/ /g, '-') },
      props: { equipment },
      pageSize: HUB_PAGE_SIZE,
    })
  )) satisfies GetStaticPaths

const { equipment, page } = Astro.props as { equipment: string; page: Page<Exercise> }
const list = byEquipment[equipment]
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)
const slug = equipment.replace(/ /g, '-')
const baseHref = `/exercises/equipment/${slug}/`
const pageHref = (n: number) => (n === 1 ? baseHref : `${baseHref}${n}/`)
const canonical = `https://maratool.com${pageHref(page.currentPage)}`
const pageSuffix = page.currentPage > 1 ? ` — Page ${page.currentPage} of ${page.lastPage}` : ''

// `other` is the generator's fallback for records whose source data names no
// equipment. Rendering it raw gave "Other Exercises" and "205 exercises you
// can do with other", so this facet gets its own copy.
const isOther = equipment === 'other'
const title = isOther ? 'Exercises With No Specific Equipment' : `${cap(equipment)} Exercises`
const subtitle = isOther
  ? `${list.length} exercises whose source data lists no specific equipment — mostly machine and apparatus work that the original dataset left unnamed. Filter by target muscle, then open any exercise for instructions and a muscle map.`
  : `${list.length} exercises using ${equipment}. Filter by target muscle, then open any exercise for instructions and a muscle map.`
const description = isOther
  ? `${list.length} exercises with no specific equipment listed in the source data. Step-by-step instructions, muscles worked, and difficulty level.`
  : `${list.length} exercises you can do with ${equipment}. Step-by-step instructions, muscles worked, and difficulty level.`

const muscleCounts = new Map<string, number>()
for (const ex of list) for (const m of ex.primaryMuscles) muscleCounts.set(m, (muscleCounts.get(m) ?? 0) + 1)
const facets = [...muscleCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([value, count]) => ({
    value,
    label: cap(value),
    count,
    href: `/exercises/muscle/${value.replace(/ /g, '-')}/`,
  }))

const seo = {
  title: `${title} — ${list.length} Exercises${pageSuffix} | maratool`,
  description: description.slice(0, 158),
  canonical,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageSuffix ? `${title}${pageSuffix}` : title,
    url: canonical,
    description,
    hasPart: page.data.map(ex => ({
      '@type': 'HowTo',
      name: ex.name,
      url: `https://maratool.com/exercises/${ex.slug}/`,
    })),
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Exercises', item: 'https://maratool.com/exercises/' },
      { '@type': 'ListItem', position: 3, name: title, item: `https://maratool.com${baseHref}` },
    ],
  },
}
---
<Base {...seo} scope="hub">
  <Layout scope="hub">
    <ExerciseHub
      title={pageSuffix ? `${title}${pageSuffix}` : title}
      subtitle={subtitle}
      exercises={page.data}
      facetLabel="Muscle"
      facets={facets}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      total={page.total}
      start={page.start}
      baseHref={baseHref}
    />
  </Layout>
</Base>
