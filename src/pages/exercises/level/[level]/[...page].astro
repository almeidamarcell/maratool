---
import type { GetStaticPaths, Page } from 'astro'
import Base from '../../../../layouts/Base.astro'
import Layout from '../../../../components/Layout.astro'
import ExerciseHub from '../../../../components/exercises/ExerciseHub.astro'
import { byLevel, HUB_PAGE_SIZE } from '../../../../data/exercises'
import type { Exercise } from '../../../../data/exercises'

export const getStaticPaths = (({ paginate }) =>
  Object.entries(byLevel).flatMap(([level, list]) =>
    paginate(list, {
      params: { level: level.replace(/ /g, '-') },
      props: { level },
      pageSize: HUB_PAGE_SIZE,
    })
  )) satisfies GetStaticPaths

const { level, page } = Astro.props as { level: string; page: Page<Exercise> }
const list = byLevel[level]
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)
const slug = level.replace(/ /g, '-')
const baseHref = `/exercises/level/${slug}/`
const pageHref = (n: number) => (n === 1 ? baseHref : `${baseHref}${n}/`)
const canonical = `https://maratool.com${pageHref(page.currentPage)}`
const pageSuffix = page.currentPage > 1 ? ` — Page ${page.currentPage} of ${page.lastPage}` : ''

const title = `${cap(level)} Exercises`
const description = page.currentPage > 1
  ? `Page ${page.currentPage} of ${page.lastPage}: more exercises rated ${level}, with step-by-step instructions, muscles worked, and equipment needed.`
  : `${list.length} exercises rated ${level}. Step-by-step instructions, muscles worked, and equipment needed. Free, no sign-up.`

const muscleCounts = new Map<string, number>()
for (const ex of list) for (const m of ex.primaryMuscles) muscleCounts.set(m, (muscleCounts.get(m) ?? 0) + 1)
const facets = [...muscleCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([value, count]) => ({
    value,
    label: cap(value),
    count,
    href: `/exercises/muscle/${value.replace(/ /g, '-')}/`,
  }))

const seo = {
  title: `${title} — ${list.length} Exercises${pageSuffix} | maratool`,
  description: description.slice(0, 158),
  canonical,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageSuffix ? `${title}${pageSuffix}` : title,
    url: canonical,
    description,
    hasPart: page.data.map(ex => ({
      '@type': 'HowTo',
      name: ex.name,
      url: `https://maratool.com/exercises/${ex.slug}/`,
    })),
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Exercises', item: 'https://maratool.com/exercises/' },
      { '@type': 'ListItem', position: 3, name: title, item: `https://maratool.com${baseHref}` },
    ],
  },
}
---
<Base {...seo} scope="hub">
  <Layout scope="hub">
    <ExerciseHub
      title={pageSuffix ? `${title}${pageSuffix}` : title}
      subtitle={`${list.length} exercises rated ${level}. Filter by target muscle, then open any exercise for instructions and a muscle map.`}
      exercises={page.data}
      facetLabel="Muscle"
      facets={facets}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      total={page.total}
      start={page.start}
      baseHref={baseHref}
    />
  </Layout>
</Base>
