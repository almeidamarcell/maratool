---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'GIF to Sprite Sheet Online | maratool',
  description: 'Convert a GIF to a sprite sheet online. Lay out every frame of an animated GIF in a grid for games and CSS animation. Free, no upload, no watermark.',
  canonical: 'https://maratool.com/gif-to-sprite',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GIF to Sprite Sheet Online',
    url: 'https://maratool.com/gif-to-sprite',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert a GIF to a sprite sheet online. Lay out every frame of an animated GIF in a grid for games and CSS animation. Free, no upload, no watermark.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What does it output?', acceptedAnswer: { '@type': 'Answer', text: 'One PNG holding every frame in a grid. A sprite sheet is a static image — the animation comes from your engine or from CSS.' } },
      { '@type': 'Question', name: 'How do I animate the sheet in CSS?', acceptedAnswer: { '@type': 'Answer', text: 'Leave columns at 0 so all frames sit in a single row, then paste the steps() snippet the tool prints under the preview.' } },
      { '@type': 'Question', name: 'Does it keep transparency?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, transparent is the default. Pick white or black if your engine needs an opaque sheet.' } },
      { '@type': 'Question', name: 'Is there a size limit?', acceptedAnswer: { '@type': 'Answer', text: 'The sheet has to fit one canvas: 16384 px per side and roughly 100 megapixels. You are told before anything larger is attempted.' } },
    ],
  },
}

const howTo = [
  'Upload the GIF you want laid out as a sheet.',
  'Choose how many columns the grid gets — 0 puts every frame in one row, which is what CSS steps() wants.',
  'Download the PNG and copy the CSS snippet printed under it.',
]

const faq = [
  { q: 'What does it output?', a: 'One PNG holding every frame in a grid. A sprite sheet is a static image — the animation comes from your engine or from CSS.' },
  { q: 'How do I animate the sheet in CSS?', a: 'Leave columns at 0 so all frames sit in a single row, then paste the steps() snippet the tool prints under the preview.' },
  { q: 'Does it keep transparency?', a: 'Yes, transparent is the default. Pick white or black if your engine needs an opaque sheet.' },
  { q: 'Is there a size limit?', a: 'The sheet has to fit one canvas: 16384 px per side and roughly 100 megapixels. You are told before anything larger is attempted.' },
]

const relatedTools = [
  { slug: 'gif-to-frames', name: 'GIF to Frames' },
  { slug: 'gif-split', name: 'Split GIF into Parts' },
  { slug: 'gif-maker', name: 'GIF Maker' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image', href: '/image' },
  { label: 'Animated', href: '/image/animated' },
  { label: 'GIF to Sprite Sheet Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="gif-to-sprite" name="GIF to Sprite Sheet Online" description="GIF to Sprite Sheet Online. Free, runs in your browser — no upload to servers." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="gif-ext">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="gif-to-sprite"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/gif-to-sprite.js"></script>
