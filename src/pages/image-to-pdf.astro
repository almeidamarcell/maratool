---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'JPG to PDF Converter Online — Free, No Upload | maratool',
  description: 'Convert JPG, PNG, and WebP images to a single PDF online. Reorder pages, pick A4, Letter, or fit-to-image, set margins. Free, no upload, no watermark.',
  canonical: 'https://maratool.com/image-to-pdf',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JPG to PDF Converter Online',
    url: 'https://maratool.com/image-to-pdf',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert JPG, PNG, and WebP images to a single PDF online. Reorder pages, pick A4, Letter, or fit-to-image, set margins. Free, no upload, no watermark.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'PDF', item: 'https://maratool.com/pdf' },
      { '@type': 'ListItem', position: 3, name: 'Edit', item: 'https://maratool.com/pdf/edit' },
      { '@type': 'ListItem', position: 4, name: 'JPG to PDF Converter Online', item: 'https://maratool.com/image-to-pdf' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Do my images get uploaded to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. The PDF is built entirely in your browser with pdf-lib — your images never leave your device, and nothing is stored.' } },
      { '@type': 'Question', name: 'Can I combine multiple images into one PDF?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Add as many JPG, PNG, or WebP files as you want, reorder them with the arrow buttons, and each image becomes one page of a single PDF.' } },
      { '@type': 'Question', name: 'What image formats are supported?', acceptedAnswer: { '@type': 'Answer', text: 'JPG, PNG, and WebP. JPG and PNG are embedded directly; WebP is converted to lossless PNG first because the PDF format does not support WebP natively.' } },
      { '@type': 'Question', name: 'Will converting reduce image quality?', acceptedAnswer: { '@type': 'Answer', text: 'No. JPG and PNG bytes are embedded in the PDF without re-encoding, so quality is identical to the originals. WebP is re-encoded losslessly.' } },
    ],
  },
}

const howTo = [
  'Drop JPG, PNG, or WebP images into the upload area, or click to browse — add as many as you want.',
  'Use the arrows to set page order, then pick page size (A4, Letter, or fit to image), orientation, and margin.',
  'Click Convert to PDF and download a single PDF with one image per page.',
]

const faq = [
  { q: 'Do my images get uploaded to a server?', a: 'No. The PDF is built entirely in your browser with pdf-lib — your images never leave your device, and nothing is stored.' },
  { q: 'Can I combine multiple images into one PDF?', a: 'Yes. Add as many JPG, PNG, or WebP files as you want, reorder them with the arrow buttons, and each image becomes one page of a single PDF.' },
  { q: 'What image formats are supported?', a: 'JPG, PNG, and WebP. JPG and PNG are embedded directly; WebP is converted to lossless PNG first because the PDF format does not support WebP natively.' },
  { q: 'Will converting reduce image quality?', a: 'No. JPG and PNG bytes are embedded in the PDF without re-encoding, so quality is identical to the originals. WebP is re-encoded losslessly.' },
]

const relatedTools = [
  { slug: 'pdf-to-jpg', name: 'PDF to JPG' },
  { slug: 'pdf-merge-split', name: 'Merge and Split PDF Pages' },
  { slug: 'compress-pdf', name: 'Compress PDF' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'PDF', href: '/pdf' },
  { label: 'Edit', href: '/pdf/edit' },
  { label: 'JPG to PDF Converter Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="image-to-pdf" name="JPG to PDF Converter Online" description="Convert JPG, PNG, and WebP images into a single PDF. Runs entirely in your browser — no upload, no watermark." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="image-to-pdf">
        <div class="itp-dropzone" id="itp-dropzone">
          <input type="file" id="itp-file" accept="image/jpeg,image/png,image/webp" multiple hidden />
          <div class="pdf-dropzone-inner">
            <svg class="pdf-upload-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p class="pdf-dropzone-title">Drop images here</p>
            <p class="pdf-dropzone-sub">JPG, PNG, or WebP — or click to select files</p>
          </div>
        </div>

        <p id="itp-hint" class="itp-hint" style="display:none;"></p>
        <div id="itp-list" class="itp-list"></div>

        <div id="itp-controls" class="itp-controls" style="display:none;">
          <div class="itp-add-row">
            <label class="tool-button itp-add-btn">
              Add more images
              <input type="file" id="itp-file-more" accept="image/jpeg,image/png,image/webp" multiple hidden />
            </label>
          </div>

          <div class="itp-options">
            <div class="itp-option">
              <label class="tool-label" for="itp-size">Page size</label>
              <select id="itp-size" class="tool-input">
                <option value="fit">Fit to image</option>
                <option value="a4">A4</option>
                <option value="letter">Letter</option>
              </select>
            </div>
            <div class="itp-option" id="itp-orient-wrap" style="display:none;">
              <label class="tool-label" for="itp-orient">Orientation</label>
              <select id="itp-orient" class="tool-input">
                <option value="auto">Auto</option>
                <option value="portrait">Portrait</option>
                <option value="landscape">Landscape</option>
              </select>
            </div>
            <div class="itp-option">
              <label class="tool-label" for="itp-margin">Margin</label>
              <select id="itp-margin" class="tool-input">
                <option value="none">None</option>
                <option value="small">Small</option>
                <option value="big">Large</option>
              </select>
            </div>
          </div>

          <div id="itp-progress" class="pdf-progress" style="display:none;"></div>
          <button id="itp-convert" class="tool-button">Convert to PDF</button>
        </div>

        <div id="itp-result" class="itp-result" style="display:none;">
          <p id="itp-result-info" class="pdf-file-info"></p>
          <div class="itp-result-actions">
            <button id="itp-download" class="tool-button">Download PDF</button>
            <button id="itp-reset" class="tool-button tool-button-ghost">Start over</button>
          </div>
        </div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .itp-dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .itp-dropzone:hover,
  .itp-dropzone.dropzone-active {
    background: var(--bg-hover);
    border-color: var(--accent);
  }
  .itp-hint {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  .itp-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .itp-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .itp-thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--bg);
    display: block;
  }
  .itp-card-meta {
    padding: 0.375rem 0.5rem;
    font-size: 0.75rem;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .itp-card-controls {
    display: flex;
    gap: 0.25rem;
    padding: 0 0.5rem 0.5rem;
  }
  .itp-btn {
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    cursor: pointer;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-2);
  }
  .itp-btn:hover { background: var(--bg-hover); }
  .itp-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .itp-remove { margin-left: auto; color: #b91c1c; }
  .itp-remove:hover { background: var(--error-bg, #fef2f2); }
  .itp-controls { margin-top: 1rem; }
  .itp-add-row { margin-bottom: 0.75rem; }
  .itp-add-btn { cursor: pointer; }
  .itp-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .itp-option {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .itp-option .tool-input { min-width: 140px; }
  .itp-result { margin-top: 1rem; }
  .itp-result-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
</style>

<script src="../tools/image-to-pdf.js"></script>
