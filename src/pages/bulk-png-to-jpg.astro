---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Bulk PNG to JPG Converter | maratool',
  description: 'Convert multiple PNG images to JPG in one batch. Set compression quality, convert in your browser, and download all files. Free, no upload needed.',
  canonical: 'https://maratool.com/bulk-png-to-jpg',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Bulk PNG to JPG Converter',
    url: 'https://maratool.com/bulk-png-to-jpg',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert multiple PNG images to JPG in one batch. Set compression quality, convert in your browser, and download all files. Free, no upload needed.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Can I convert a whole folder of PNGs at once?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Select or drop the batch and every file is converted in one pass, each with its own download plus a download-all.' } },
      { '@type': 'Question', name: 'What happens to transparency?', acceptedAnswer: { '@type': 'Answer', text: 'JPEG has no alpha channel, so transparent areas are composited onto a white background before encoding. If you need the transparency, keep the PNG.' } },
      { '@type': 'Question', name: 'What quality should I pick?', acceptedAnswer: { '@type': 'Answer', text: 'Ninety percent is a good default and is close to visually lossless for photos. Drop to seventy for thumbnails or email attachments where size matters more than detail.' } },
      { '@type': 'Question', name: 'Are my images uploaded anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything runs on a canvas in your browser and no file is sent to a server.' } },
    ],
  },
}

const howTo = [
  'Drop in as many PNG files as you like — the whole batch loads at once.',
  'Set the JPEG quality slider, then click Convert to JPEG.',
  'Download each JPG on its own, or take the whole set with Download all.',
]

const faq = [
  { q: 'Can I convert a whole folder of PNGs at once?', a: 'Yes. Select or drop the batch and every file is converted in one pass, each with its own download plus a download-all.' },
  { q: 'What happens to transparency?', a: 'JPEG has no alpha channel, so transparent areas are composited onto a white background before encoding. If you need the transparency, keep the PNG.' },
  { q: 'What quality should I pick?', a: 'Ninety percent is a good default and is close to visually lossless for photos. Drop to seventy for thumbnails or email attachments where size matters more than detail.' },
  { q: 'Are my images uploaded anywhere?', a: 'No. Everything runs on a canvas in your browser and no file is sent to a server.' },
]

const relatedTools = [
  { slug: 'bulk-jpg-to-png', name: 'Bulk JPG to PNG Converter' },
  { slug: 'image-converter', name: 'Image Converter' },
  { slug: 'image-compressor', name: 'Compress Image Online' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Format', href: '/converter/format' },
  { label: 'Bulk PNG to JPG Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="bulk-png-to-jpg" name="Bulk PNG to JPG Converter" description="Convert a whole batch of PNG files to JPG at once. Every file is re-encoded in your browser and downloads individually or as a set." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="image">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="bulk-png-to-jpg"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/bulk-png-to-jpg.js"></script>
