---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'HEIC to JPG Converter — Convert iPhone Photos Free | maratool',
  description: 'Convert HEIC and HEIF photos from an iPhone to JPG in your browser. Batch several files at once, set JPEG quality, and see the size saved per photo.',
  canonical: 'https://maratool.com/heic-to-jpg',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'HEIC to JPG Converter',
    url: 'https://maratool.com/heic-to-jpg',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert HEIC and HEIF photos from an iPhone to JPG in your browser, in batches, with a quality slider.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Image', item: 'https://maratool.com/image' },
      { '@type': 'ListItem', position: 3, name: 'Transform', item: 'https://maratool.com/image/transform' },
      { '@type': 'ListItem', position: 4, name: 'HEIC to JPG Converter', item: 'https://maratool.com/heic-to-jpg' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Why are my iPhone photos HEIC instead of JPG?', acceptedAnswer: { '@type': 'Answer', text: 'HEIC has been the default camera format on iPhone since iOS 11 in 2017. Apple picked it because it stores roughly the same picture in about half the bytes of a JPEG. To stop it at the source, open Settings, then Camera, then Formats, and choose Most Compatible.' } },
      { '@type': 'Question', name: 'Why will Windows not open a HEIC file?', acceptedAnswer: { '@type': 'Answer', text: 'Windows 10 and 11 ship without the HEVC video extension that decodes HEIC, and Microsoft charges for it in the Store. That paid codec is the reason most people end up converting instead. This page decodes HEIC in JavaScript, so nothing has to be installed.' } },
      { '@type': 'Question', name: 'Can I convert several HEIC files at once?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Drop a whole folder of photos and every file is decoded in turn, with a progress bar showing which one is running. Each result gets its own download button, and Download all saves the batch in one click.' } },
      { '@type': 'Question', name: 'Are my photos uploaded anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. The HEIC decoder is a WebAssembly build that runs inside the page, so the photo bytes stay on your device. After the page and decoder load, the conversion itself works offline.' } },
    ],
  },
}

const howTo = [
  'Drop your HEIC or HEIF photos into the upload area, or click to pick them from a folder.',
  'Set the JPEG quality slider, then click Convert to JPG and watch the progress bar work through the batch.',
  'Check the size saved on each photo and download them one by one, or grab the whole batch at once.',
]

const faq = [
  { q: 'Why are my iPhone photos HEIC instead of JPG?', a: 'HEIC has been the default camera format on iPhone since iOS 11 in 2017, because it stores about the same picture in half the bytes of a JPEG. To stop it at the source: Settings &rarr; Camera &rarr; Formats &rarr; Most Compatible.' },
  { q: 'Why will Windows not open a HEIC file?', a: 'Windows 10 and 11 ship without the HEVC extension that decodes HEIC, and Microsoft charges for it in the Store. That paid codec is the whole reason this search exists. Here the decoding happens in JavaScript, so nothing gets installed.' },
  { q: 'Can I convert several HEIC files at once?', a: 'Yes. Drop a folder of photos and each one is decoded in turn with a progress bar. Every result has its own download button, plus a Download all for the batch.' },
  { q: 'Are my photos uploaded anywhere?', a: 'No. The decoder is a WebAssembly build running inside the page, so the photo bytes never leave your device.' },
]

const relatedTools = [
  { slug: 'image-converter', name: 'Image Converter — HEIC to PNG, PNG to JPEG, WebP' },
  { slug: 'image-compressor', name: 'Compress Image Online — Reduce JPG, PNG & WebP Size' },
  { slug: 'exif-remover', name: 'Remove EXIF Metadata from Images' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image', href: '/image' },
  { label: 'Transform', href: '/image/transform' },
  { label: 'HEIC to JPG Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="heic-to-jpg" name="Convert HEIC to JPG" description="Turn iPhone HEIC and HEIF photos into ordinary JPGs. Several files at a time, with a quality slider and the size saved on each one." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;">
        <div class="hjp-dropzone tool-dropzone" id="hjp-dropzone">
          <input type="file" id="hjp-file" accept=".heic,.heif,image/heic,image/heif,image/heic-sequence,image/heif-sequence" multiple hidden />
          <svg class="hjp-icon" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <p class="hjp-title">Drop HEIC photos here</p>
          <p class="hjp-sub">or click to select — several files at once, straight from your iPhone</p>
        </div>

        <p id="hjp-error" class="tool-error" hidden style="display:none;"></p>

        <div id="hjp-settings" hidden style="display:none;">
          <p class="tool-hint" id="hjp-queue-info"></p>
          <ul class="hjp-queue" id="hjp-queue"></ul>
          <div class="hjp-options">
            <div class="hjp-option">
              <label class="tool-label" for="hjp-quality">JPEG quality: <span id="hjp-quality-val">85%</span></label>
              <input type="range" id="hjp-quality" min="30" max="100" value="85" />
              <p class="hjp-option-note">Lower quality means smaller files. 85% is close to indistinguishable from the original.</p>
            </div>
          </div>
          <div class="hjp-actions">
            <button class="tool-button" id="hjp-convert">Convert to JPG</button>
            <label class="copy-btn hjp-add">
              Add more photos
              <input type="file" id="hjp-file-more" accept=".heic,.heif,image/heic,image/heif,image/heic-sequence,image/heif-sequence" multiple hidden />
            </label>
            <button class="copy-btn" id="hjp-clear">Clear</button>
          </div>
        </div>

        <div id="hjp-progress" class="tool-progress" hidden style="display:none;">
          <p class="tool-progress-text" id="hjp-progress-text">Loading the HEIC decoder…</p>
          <div class="tool-progress-bar"><div class="tool-progress-fill" id="hjp-progress-fill"></div></div>
          <p class="tool-progress-detail">HEIC decoding is heavy. A 12 MP photo takes a second or two.</p>
        </div>

        <div id="hjp-results" hidden style="display:none;">
          <div class="hjp-results-head">
            <p class="hjp-summary" id="hjp-summary"></p>
            <div class="hjp-actions">
              <button class="tool-button" id="hjp-download-all">Download all</button>
              <button class="copy-btn" id="hjp-reset">Convert more photos</button>
            </div>
          </div>
          <ul class="hjp-list" id="hjp-list"></ul>
        </div>
      </div>
    </ToolShell>
  </Layout>
</Base>
<style is:global>
  /* Padding comes from .tool-dropzone in tools.css — no override here. */
  .hjp-icon { color: var(--text-3); margin-bottom: 0.5rem; }
  .hjp-title { font-weight: 600; color: var(--text); margin: 0 0 0.25rem; }
  .hjp-sub { color: var(--text-2); font-size: 0.875rem; margin: 0; }
  .hjp-queue { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; gap: 0.375rem; }
  .hjp-queue li { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.8125rem; color: var(--text-2); border-bottom: 1px solid var(--border); padding-bottom: 0.375rem; }
  .hjp-queue li span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hjp-options { margin-bottom: 1rem; }
  .hjp-option input[type="range"] { width: 100%; max-width: 340px; display: block; }
  .hjp-option-note { font-size: 0.75rem; color: var(--text-3); margin: 0.375rem 0 0; }
  .hjp-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
  .hjp-add { cursor: pointer; }
  .hjp-results-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .hjp-summary { margin: 0; font-size: 0.875rem; color: var(--text-2); }
  .hjp-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .hjp-item { display: flex; gap: 1rem; align-items: center; border: 1px solid var(--border); border-radius: var(--radius); padding: 0.75rem; }
  .hjp-thumb { width: 64px; height: 64px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-soft); flex-shrink: 0; }
  .hjp-item-body { flex: 1; min-width: 0; }
  .hjp-item-name { font-size: 0.875rem; font-weight: 600; color: var(--text); margin: 0 0 0.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hjp-item-meta { font-size: 0.75rem; color: var(--text-2); margin: 0; }
  .hjp-delta { color: var(--text-3); }
  .hjp-delta.saved { color: #276749; }
  .hjp-item-fail .hjp-item-meta { color: #c53030; }
  @media (max-width: 600px) {
    .hjp-item { flex-wrap: wrap; }
    .hjp-actions { width: 100%; }
  }
</style>
<script src="../tools/heic-to-jpg.js"></script>
