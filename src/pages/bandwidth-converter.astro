---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Bandwidth Converter — Mbps, MB/s & Gbps | maratool',
  description: 'Convert Mbps to MB/s, Gbps to Mbps, and MiB/s instantly — decimal and binary prefixes handled correctly. Free bandwidth converter in your browser.',
  canonical: 'https://maratool.com/bandwidth-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Bandwidth Converter — Mbps, MB/s & Gbps',
    url: 'https://maratool.com/bandwidth-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert Mbps to MB/s, Gbps to Mbps, and MiB/s instantly — decimal and binary prefixes handled correctly. Free bandwidth converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Bandwidth Converter — Mbps, MB/s & Gbps', item: 'https://maratool.com/bandwidth-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert megabit per second to megabyte per second?', acceptedAnswer: { '@type': 'Answer', text: '1 megabit per second = 0.125 megabyte per second. Choose "Megabit per second (Mbit/s)" as From and "Megabyte per second (MB/s)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'Why does my 100 Mbps plan download at 12 MB/s?', acceptedAnswer: { '@type': 'Answer', text: 'ISPs sell megabits; download managers show megabytes. 100 Mbps ÷ 8 = 12.5 MB/s — the numbers agree, the units differ.' } },
      { '@type': 'Question', name: 'What is the difference between MB/s and MiB/s?', acceptedAnswer: { '@type': 'Answer', text: 'MB/s uses decimal megabytes (10⁶ bytes); MiB/s uses binary mebibytes (2²⁰ = 1,048,576 bytes). 1 MiB/s ≈ 1.049 MB/s — tools like task managers often display MiB/s.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert megabit per second to megabyte per second?', a: '1 megabit per second = 0.125 megabyte per second. Choose "Megabit per second (Mbit/s)" as From and "Megabyte per second (MB/s)" as To, type a value, and the result updates instantly.' },
  { q: 'Why does my 100 Mbps plan download at 12 MB/s?', a: 'ISPs sell megabits; download managers show megabytes. 100 Mbps ÷ 8 = 12.5 MB/s — the numbers agree, the units differ.' },
  { q: 'What is the difference between MB/s and MiB/s?', a: 'MB/s uses decimal megabytes (10⁶ bytes); MiB/s uses binary mebibytes (2²⁰ = 1,048,576 bytes). 1 MiB/s ≈ 1.049 MB/s — tools like task managers often display MiB/s.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'frequency-converter', name: 'Frequency Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' },
  { slug: 'base-converter', name: 'Number Base Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Bandwidth Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="bandwidth-converter" name="Bandwidth Converter — Mbps, MB/s & Gbps" description="Convert between bits per second and bytes per second across decimal (MB/s) and binary (MiB/s) prefixes." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="bwc-from-unit">From</label>
            <select id="bwc-from-unit" class="uc-select"></select>
            <input type="number" id="bwc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="bwc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="bwc-to-unit">To</label>
            <select id="bwc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="bwc-result">&mdash;</div>
            <button class="copy-btn" id="bwc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every rate is converted through bits per second; byte units multiply by exactly 8, and binary prefixes use exact powers of two per IEC/SI prefix rules in the <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener" target="_blank">BIPM SI Brochure</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/bandwidth-converter.js"></script>
