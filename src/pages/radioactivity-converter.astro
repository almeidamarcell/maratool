---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Becquerel to Curie Converter — Radioactivity | maratool',
  description: 'Convert radioactivity between becquerels, megabecquerels, curies, and millicuries instantly — 1 Ci = 3.7×10¹⁰ Bq. Free converter in your browser.',
  canonical: 'https://maratool.com/radioactivity-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Becquerel to Curie Converter — Radioactivity',
    url: 'https://maratool.com/radioactivity-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert radioactivity between becquerels, megabecquerels, curies, and millicuries instantly — 1 Ci = 3.7×10¹⁰ Bq. Free converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Radiation', item: 'https://maratool.com/converter/radiation' },
      { '@type': 'ListItem', position: 4, name: 'Becquerel to Curie Converter — Radioactivity', item: 'https://maratool.com/radioactivity-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert millicurie to megabecquerel?', acceptedAnswer: { '@type': 'Answer', text: '1 millicurie = 37 megabecquerel. Choose "Millicurie (mCi)" as From and "Megabecquerel (MBq)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many MBq is 1 mCi?', acceptedAnswer: { '@type': 'Answer', text: '37 MBq exactly — the curie is defined as 3.7 × 10¹⁰ decays per second. Nuclear-medicine doses like 10 mCi of Tc-99m are 370 MBq.' } },
      { '@type': 'Question', name: 'Why is radon reported in pCi/L?', acceptedAnswer: { '@type': 'Answer', text: 'US radon guidance uses picocuries per liter; the EPA action level of 4 pCi/L equals 148 Bq/m³. The pCi→Bq factor (0.037) converts the activity part.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert millicurie to megabecquerel?', a: '1 millicurie = 37 megabecquerel. Choose "Millicurie (mCi)" as From and "Megabecquerel (MBq)" as To, type a value, and the result updates instantly.' },
  { q: 'How many MBq is 1 mCi?', a: '37 MBq exactly — the curie is defined as 3.7 × 10¹⁰ decays per second. Nuclear-medicine doses like 10 mCi of Tc-99m are 370 MBq.' },
  { q: 'Why is radon reported in pCi/L?', a: 'US radon guidance uses picocuries per liter; the EPA action level of 4 pCi/L equals 148 Bq/m³. The pCi→Bq factor (0.037) converts the activity part.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'absorbed-dose-converter', name: 'Gray to Rad' },
  { slug: 'equivalent-dose-converter', name: 'Sievert to Rem' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Radiation', href: '/converter/radiation' },
  { label: 'Becquerel to Curie' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="radioactivity-converter" name="Becquerel to Curie Converter — Radioactivity" description="Convert activity between becquerels, kilo/mega/gigabecquerels, curies, millicuries, and dpm." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="rac-from-unit">From</label>
            <select id="rac-from-unit" class="uc-select"></select>
            <input type="number" id="rac-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="rac-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="rac-to-unit">To</label>
            <select id="rac-to-unit" class="uc-select"></select>
            <div class="uc-result" id="rac-result">&mdash;</div>
            <button class="copy-btn" id="rac-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Activity is converted through the becquerel (one decay per second); the curie relation (3.7×10¹⁰ Bq exactly) follows <a href="https://www.nrc.gov/about-nrc/radiation/health-effects/measuring-radiation.html" rel="noopener" target="_blank">US NRC — Measuring Radiation</a>. <em>Unit conversion only — this does not assess dose, risk, or safety, and is not medical advice.</em></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/radioactivity-converter.js"></script>
