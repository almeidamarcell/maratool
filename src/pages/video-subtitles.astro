---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Add Subtitles to Video Online | maratool',
  description: 'Burn subtitles into a video from an SRT or VTT file, or type captions by hand. Set font, size, and position — free and runs entirely in your browser.',
  canonical: 'https://maratool.com/video-subtitles',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Add Subtitles to Video Online',
    url: 'https://maratool.com/video-subtitles',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Burn subtitles into a video from an SRT or VTT file, or type captions by hand. Set font, size, and position — free and runs entirely in your browser.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Do I need a subtitle file?', acceptedAnswer: { '@type': 'Answer', text: 'No. Type the captions straight into the editor, one row per line with its start and end time. Uploading an SRT or VTT is the alternative, not the requirement.' } },
      { '@type': 'Question', name: 'Can I fix a subtitle file that is slightly off?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. An uploaded file fills the editor, so you can correct wording or nudge the timings before burning it in.' } },
      { '@type': 'Question', name: 'What does burning in mean?', acceptedAnswer: { '@type': 'Answer', text: 'The text is drawn into the video frames themselves, so it plays everywhere and cannot be switched off. A soft subtitle track can be toggled but is ignored by many players and by most social platforms.' } },
      { '@type': 'Question', name: 'What time format do the rows take?', acceptedAnswer: { '@type': 'Answer', text: 'Hours, minutes, seconds and milliseconds, as in 00:00:03.500. The end time of one caption can match the start of the next.' } },
    ],
  },
}

const howTo = [
  'Drop in the clip you want captioned.',
  'Type the captions row by row with a start and end time, or upload an existing SRT or VTT file to load them in.',
  'Process to burn the captions into the picture, then download.',
]

const faq = [
  { q: 'Do I need a subtitle file?', a: 'No. Type the captions straight into the editor, one row per line with its start and end time. Uploading an SRT or VTT is the alternative, not the requirement.' },
  { q: 'Can I fix a subtitle file that is slightly off?', a: 'Yes. An uploaded file fills the editor, so you can correct wording or nudge the timings before burning it in.' },
  { q: 'What does burning in mean?', a: 'The text is drawn into the video frames themselves, so it plays everywhere and cannot be switched off. A soft subtitle track can be toggled but is ignored by many players and by most social platforms.' },
  { q: 'What time format do the rows take?', a: 'Hours, minutes, seconds and milliseconds, as in 00:00:03.500. The end time of one caption can match the start of the next.' },
]

const relatedTools = [
  { slug: 'video-to-text', name: 'Video to Text' },
  { slug: 'audio-to-text', name: 'Audio to Text' },
  { slug: 'compress-video', name: 'Compress Video' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Video', href: '/converter/video' },
  { label: 'Add Subtitles to Video Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="video-subtitles" name="Add Subtitles to Video Online" description="Burn captions into a video. Type them with start and end times in the built-in editor, or load an existing SRT or VTT file." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="video-subtitles">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="video-subtitles"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/video-subtitles.js"></script>
