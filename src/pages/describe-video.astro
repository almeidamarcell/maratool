---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Describe Video with AI — Frame-by-Frame Descriptions | maratool',
  description: 'Describe video content with AI — get a text description of every second of your video. Runs locally in your browser, no upload, no signup. Export TXT, VTT, SRT.',
  canonical: 'https://maratool.com/describe-video',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Describe Video with AI',
    url: 'https://maratool.com/describe-video',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'AI video describer that captions sampled frames of a video locally in the browser and exports the descriptions as text, VTT, or SRT.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Video', item: 'https://maratool.com/converter/video' },
      { '@type': 'ListItem', position: 4, name: 'Describe Video with AI', item: 'https://maratool.com/describe-video' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How does the AI video describer work?',
        acceptedAnswer: { '@type': 'Answer', text: 'The tool grabs a frame from your video at a fixed interval (every second by default) and runs each frame through a vision AI model in your browser. With WebGPU it uses Florence-2 for detailed descriptions; otherwise it falls back to a lighter captioning model. The result is a timestamped description of what happens on screen.' },
      },
      {
        '@type': 'Question',
        name: 'Is my video uploaded to a server?',
        acceptedAnswer: { '@type': 'Answer', text: 'No. Frame extraction and the AI model both run entirely on your device. The model files are downloaded once from a CDN and cached — your video never leaves your browser.' },
      },
      {
        '@type': 'Question',
        name: 'What is the difference between this and video-to-text transcription?',
        acceptedAnswer: { '@type': 'Answer', text: 'Video-to-text transcribes the audio — what is said. This tool describes the visuals — what is shown, frame by frame. Use both together for a complete text version of a video: the spoken words plus a description of what happens on screen.' },
      },
      {
        '@type': 'Question',
        name: 'How long does it take to describe a video?',
        acceptedAnswer: { '@type': 'Answer', text: 'Roughly 0.5–2 seconds per frame with WebGPU (Chrome or Edge on desktop), slower on the WebAssembly fallback. A one-minute video sampled every second is about 60 frames. Use a longer interval (2 or 5 seconds) for long videos, and the Stop button ends the run early while keeping everything described so far.' },
      },
    ],
  },
}

const howTo = [
  'Drop a video file (MP4, WebM, or MOV) or click to select one.',
  'Pick how often to sample a frame — every second for detail, every 2–5 seconds for longer videos — and click Describe.',
  'Watch the timestamped descriptions stream in, then copy the transcript or download it as TXT, VTT, or SRT.',
]

const faq = [
  { q: 'How does the AI video describer work?', a: 'It grabs a frame at a fixed interval and runs each one through a vision AI model in your browser. With WebGPU it uses Florence-2 for detailed descriptions; otherwise a lighter captioning model. You get a timestamped description of what happens on screen.' },
  { q: 'Is my video uploaded to a server?', a: 'No. Frame extraction and the AI model run entirely on your device. The model is downloaded once and cached — your video never leaves your browser.' },
  { q: 'What is the difference between this and video-to-text transcription?', a: '<a href="/video-to-text">Video to Text</a> transcribes the audio — what is said. This tool describes the visuals — what is shown, frame by frame. Use both for a complete text version of a video.' },
  { q: 'How long does it take?', a: 'Roughly 0.5–2 seconds per frame with WebGPU (Chrome/Edge desktop), slower on the WebAssembly fallback. Use a longer interval for long videos, and Stop ends the run early while keeping everything described so far.' },
]

const relatedTools = [
  { slug: 'video-to-text', name: 'Video to Text' },
  { slug: 'video-screenshot', name: 'Video Screenshot' },
  { slug: 'alt-text-generator', name: 'Image Alt Text Generator' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Video', href: '/converter/video' },
  { label: 'Describe Video with AI' },
]

const whatIs = 'The <strong>Describe Video with AI</strong> tool turns the visual content of a video into timestamped text. It samples one frame per interval (every second by default), describes each frame with an on-device vision model, and assembles the captions into a scene-by-scene transcript you can copy or download as TXT, VTT, or SRT. Because the model runs in your browser, nothing is uploaded — useful for accessibility audio-description drafts, video search notes, and dataset labeling.'
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="describe-video" name="Describe Video with AI" description="Get a text description of every second of your video — an AI model describes each frame locally in your browser. No upload, no signup." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs} whatIs={whatIs}>
      <div class="tool-container" style="min-height:480px;">
        <div class="pdf-dropzone" id="dv-dropzone">
          <input type="file" id="dv-file" accept="video/mp4,video/webm,video/quicktime" hidden />
          <div class="pdf-dropzone-inner">
            <svg class="pdf-upload-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><polygon points="10 9 15 12 10 15 10 9"/></svg>
            <p class="pdf-dropzone-title">Drop a video here</p>
            <p class="pdf-dropzone-sub">or click to select a file</p>
            <p class="pdf-dropzone-formats">MP4, WebM, MOV — processed locally, never uploaded</p>
          </div>
        </div>

        <div id="dv-settings" style="display:none;">
          <video id="dv-video-preview" class="dv-video-preview" controls muted playsinline></video>
          <div class="dv-settings-row">
            <div>
              <label class="tool-label" for="dv-interval">Describe a frame every</label>
              <select id="dv-interval" class="tool-select">
                <option value="0.5">0.5 seconds</option>
                <option value="1" selected>1 second</option>
                <option value="2">2 seconds</option>
                <option value="5">5 seconds</option>
                <option value="10">10 seconds</option>
              </select>
            </div>
            <button type="button" id="dv-describe" class="tool-button dv-describe-btn">Describe video</button>
          </div>
          <p id="dv-frame-estimate" class="dv-note"></p>
          <p id="dv-engine-note" class="dv-note"></p>
        </div>

        <div id="dv-progress" class="dv-progress" style="display:none;">
          <p id="dv-progress-text" class="dv-progress-text">Loading…</p>
          <div class="dv-progress-track">
            <div id="dv-progress-bar" class="dv-progress-bar"></div>
          </div>
          <button type="button" id="dv-stop" class="tool-button dv-stop-btn" style="display:none;">Stop — keep what's done</button>
        </div>

        <div id="dv-result" style="display:none;">
          <div id="dv-timeline" class="dv-timeline"></div>
          <div class="tool-panel">
            <label class="tool-label" for="dv-transcript">Timestamped transcript</label>
            <textarea id="dv-transcript" class="tool-textarea" rows="8" readonly aria-label="Video description transcript"></textarea>
          </div>
          <div class="dv-actions">
            <button id="dv-copy" class="copy-btn">Copy transcript</button>
            <button id="dv-download-txt" class="tool-button">Download .txt</button>
            <button id="dv-download-vtt" class="tool-button">Download .vtt</button>
            <button id="dv-download-srt" class="tool-button">Download .srt</button>
            <button id="dv-new" class="tool-button">New video</button>
          </div>
        </div>

        <p id="dv-error" class="dv-error" style="display:none;"><span id="dv-error-text"></span></p>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  /* Dropzone styles come from the shared .pdf-dropzone rules in tools.css */
  .dv-video-preview {
    display: block;
    width: 100%;
    max-height: 320px;
    border-radius: var(--radius);
    background: #000;
    margin-bottom: 1rem;
  }
  .dv-settings-row {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .dv-describe-btn {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .dv-describe-btn:hover {
    opacity: 0.9;
  }
  .dv-note {
    font-size: 0.8125rem;
    color: var(--text-2);
    margin: 0.75rem 0 0;
  }
  .dv-progress {
    padding: 1.5rem 0;
    text-align: center;
  }
  .dv-progress-text {
    font-size: 0.875rem;
    color: var(--text-2);
    margin: 0 0 0.75rem;
  }
  .dv-progress-track {
    width: 100%;
    height: 6px;
    background: var(--bg-hover);
    border-radius: 3px;
    overflow: hidden;
  }
  .dv-progress-bar {
    height: 100%;
    background: var(--accent);
    border-radius: 3px;
    width: 0%;
    transition: width 0.3s;
  }
  .dv-stop-btn {
    margin-top: 1rem;
  }
  .dv-timeline {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 420px;
    overflow-y: auto;
    margin-bottom: 1rem;
  }
  .dv-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .dv-item-thumb {
    width: 120px;
    height: auto;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .dv-item-body {
    min-width: 0;
  }
  .dv-item-time {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    margin-bottom: 0.25rem;
  }
  .dv-item-text {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text);
    margin: 0;
  }
  .dv-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .dv-error {
    margin-top: 1rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    color: #b91c1c;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: var(--radius);
  }
  @media (max-width: 640px) {
    .dv-item-thumb { width: 88px; }
  }
</style>

<script src="../tools/describe-video.js"></script>
