---
import HealthCalc from '../components/HealthCalc.astro'

const faq = [
  { q: 'What is the ASCVD risk calculator?', a: 'It implements the ACC/AHA Pooled Cohort Equations (2013) to estimate 10-year risk of a first atherosclerotic cardiovascular disease event — nonfatal myocardial infarction, coronary heart disease death, or fatal or nonfatal stroke.' },
  { q: 'How is the result categorised?', a: 'ACC/AHA bands: low (< 5%), borderline (5–7.4%), intermediate (7.5–19.9%), and high (≥ 20%) 10-year ASCVD risk. Statin therapy discussions usually start in the intermediate band.' },
  { q: 'Who should not use this calculator?', a: 'It applies to adults 40–79 without known ASCVD and with LDL < 190 mg/dL. Patients with established cardiovascular disease, LDL ≥ 190, or on-treatment values need different assessment.' },
  { q: 'ASCVD vs PREVENT — which should I use?', a: 'The newer AHA PREVENT equations (2023) add kidney function, BMI and statin use, drop race, and estimate heart failure too. Recent guidance prefers PREVENT; the Pooled Cohort Equations remain widely used in guidelines and EHRs.' },
]
const references = [
  { citation: 'Goff DC Jr, Lloyd-Jones DM, Bennett G, et al. 2013 ACC/AHA Guideline on the Assessment of Cardiovascular Risk. <em>Circulation</em>. 2014;129(25 Suppl 2):S49-S73.' },
  { citation: 'Grundy SM, Stone NJ, Bailey AL, et al. 2018 AHA/ACC/AACVPR/AAPA/ABC/ACPM/ADA/AGS/APhA/ASPC/NLA/PCNA Guideline on the Management of Blood Cholesterol. <em>Circulation</em>. 2019;139(25):e1082-e1143.' },
  { citation: 'Arnett DK, Blumenthal RS, Albert MA, et al. 2019 ACC/AHA Guideline on the Primary Prevention of Cardiovascular Disease. <em>Circulation</em>. 2019;140(11):e596-e646.' },
]
const relatedTools = [
  { slug: 'prevent-risk-calculator', name: 'PREVENT Risk Calculator' },
  { slug: 'framingham-risk', name: 'Framingham Risk Score' },
  { slug: 'cha2ds2-vasc', name: 'CHA2DS2-VASc' },
]
---
<HealthCalc
  slug="ascvd-risk-calculator"
  name="ASCVD Risk Calculator (10-Year, Pooled Cohort Equations)"
  schemaName="ASCVD Risk Calculator"
  shortDescription="ACC/AHA Pooled Cohort Equations 10-year atherosclerotic cardiovascular disease risk estimate."
  metaTitle="ASCVD Risk Calculator — 10-Year Heart & Stroke Risk | maratool"
  metaDescription="Free ASCVD risk calculator using the ACC/AHA Pooled Cohort Equations. Estimate 10-year risk of heart attack and stroke from cholesterol, BP and more."
  subcategory="Score"
  subcategorySlug="score"
  howTo={[
    'Select sex and race group, then enter age (40–79), total cholesterol, and HDL.',
    'Enter systolic BP and mark BP treatment, diabetes, and current smoking.',
    'The 10-year ASCVD risk percentage and ACC/AHA risk category update instantly.',
  ]}
  faq={faq}
  relatedTools={relatedTools}
  references={references}
  whatIs="The ASCVD Risk Calculator implements the ACC/AHA Pooled Cohort Equations, published with the 2013 ACC/AHA cardiovascular risk guideline. It estimates a patient's 10-year probability of a first hard atherosclerotic cardiovascular disease event — nonfatal myocardial infarction, coronary heart disease death, or fatal or nonfatal stroke. The equations are sex- and race-specific (White or other / African American) and use nine inputs: age, sex, race, total cholesterol, HDL cholesterol, systolic blood pressure, antihypertensive treatment, diabetes, and smoking. The result drives statin and blood-pressure therapy decisions in the 2018 cholesterol and 2019 primary prevention guidelines. It applies to adults 40–79 without known ASCVD. This is a decision-support tool, not a diagnosis — interpret results with a clinician alongside family history, Lp(a), coronary calcium, and other risk enhancers."
>
  <div class="hcalc-inputs cols-2">
    <label class="hcalc-field"><span class="hcalc-label">Sex</span>
      <div class="hcalc-input-wrap"><select id="ascvd-sex"><option value="male" selected>Male</option><option value="female">Female</option></select></div></label>
    <label class="hcalc-field"><span class="hcalc-label">Race group (per PCE derivation)</span>
      <div class="hcalc-input-wrap"><select id="ascvd-race"><option value="white" selected>White / other</option><option value="aa">African American</option></select></div></label>
    <label class="hcalc-field"><span class="hcalc-label">Age (years, 40–79)</span>
      <div class="hcalc-input-wrap"><input id="ascvd-age" type="number" inputmode="numeric" min="40" max="79" step="1" placeholder="e.g. 55" /></div></label>
    <label class="hcalc-field"><span class="hcalc-label">Total cholesterol (mg/dL, 130–320)</span>
      <div class="hcalc-input-wrap"><input id="ascvd-tc" type="number" inputmode="numeric" min="130" max="320" step="1" placeholder="e.g. 213" /></div></label>
    <label class="hcalc-field"><span class="hcalc-label">HDL cholesterol (mg/dL, 20–100)</span>
      <div class="hcalc-input-wrap"><input id="ascvd-hdl" type="number" inputmode="numeric" min="20" max="100" step="1" placeholder="e.g. 50" /></div></label>
    <label class="hcalc-field"><span class="hcalc-label">Systolic BP (mmHg, 90–200)</span>
      <div class="hcalc-input-wrap"><input id="ascvd-sbp" type="number" inputmode="numeric" min="90" max="200" step="1" placeholder="e.g. 120" /></div></label>
    <label class="hcalc-field"><span class="hcalc-label">On BP-lowering treatment</span>
      <div class="hcalc-input-wrap"><input id="ascvd-treated" type="checkbox" style="width:auto;margin:10px 12px" /></div></label>
    <label class="hcalc-field"><span class="hcalc-label">Diabetes</span>
      <div class="hcalc-input-wrap"><input id="ascvd-diabetes" type="checkbox" style="width:auto;margin:10px 12px" /></div></label>
    <label class="hcalc-field"><span class="hcalc-label">Current smoker</span>
      <div class="hcalc-input-wrap"><input id="ascvd-smoker" type="checkbox" style="width:auto;margin:10px 12px" /></div></label>
  </div>
  <div class="hcalc-outputs">
    <div class="hcalc-output"><div class="hcalc-output-label">10-year ASCVD risk</div><div class="hcalc-output-value" id="ascvd-value">—</div><button class="copy-btn" data-target="ascvd-value">Copy</button></div>
    <div class="hcalc-output"><div class="hcalc-output-label">Risk category</div><div class="hcalc-output-value" id="ascvd-class">—</div><button class="copy-btn" data-target="ascvd-class">Copy</button></div>
  </div>
</HealthCalc>
<script src="../tools/health/score-formula-ui.js"></script>
