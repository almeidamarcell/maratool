---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Bulk JPG to PNG Converter | maratool',
  description: 'Convert multiple JPG images to PNG at once in your browser. Drag in a batch of files and download every converted image. Free bulk tool, no upload.',
  canonical: 'https://maratool.com/bulk-jpg-to-png',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Bulk JPG to PNG Converter',
    url: 'https://maratool.com/bulk-jpg-to-png',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert multiple JPG images to PNG at once in your browser. Drag in a batch of files and download every converted image. Free bulk tool, no upload.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Can I convert more than one JPG at a time?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Drop or select the whole batch and every file is converted in one pass, with a separate download for each and a download-all for the set.' } },
      { '@type': 'Question', name: 'Will the PNG be smaller than the JPG?', acceptedAnswer: { '@type': 'Answer', text: 'Almost never. PNG is lossless, so a photo saved as PNG is usually several times larger than the JPG it came from. Convert for editing headroom or transparency support, not to save space.' } },
      { '@type': 'Question', name: 'Does converting to PNG restore quality the JPG lost?', acceptedAnswer: { '@type': 'Answer', text: 'No. Compression artefacts already baked into the JPG stay baked in. What PNG gives you is that no further quality is lost on each later save.' } },
      { '@type': 'Question', name: 'Are my images uploaded anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Decoding and re-encoding both happen on a canvas in your browser, so the files never leave your device.' } },
    ],
  },
}

const howTo = [
  'Drop in as many JPG files as you like — the whole batch loads at once.',
  'Click Convert to PNG. Every file in the batch is re-encoded, not just the first.',
  'Download each PNG on its own, or take the whole set with Download all.',
]

const faq = [
  { q: 'Can I convert more than one JPG at a time?', a: 'Yes. Drop or select the whole batch and every file is converted in one pass, with a separate download for each and a download-all for the set.' },
  { q: 'Will the PNG be smaller than the JPG?', a: 'Almost never. PNG is lossless, so a photo saved as PNG is usually several times larger than the JPG it came from. Convert for editing headroom or transparency support, not to save space.' },
  { q: 'Does converting to PNG restore quality the JPG lost?', a: 'No. Compression artefacts already baked into the JPG stay baked in. What PNG gives you is that no further quality is lost on each later save.' },
  { q: 'Are my images uploaded anywhere?', a: 'No. Decoding and re-encoding both happen on a canvas in your browser, so the files never leave your device.' },
]

const relatedTools = [
  { slug: 'bulk-png-to-jpg', name: 'Bulk PNG to JPG Converter' },
  { slug: 'image-converter', name: 'Image Converter' },
  { slug: 'image-compressor', name: 'Compress Image Online' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Format', href: '/converter/format' },
  { label: 'Bulk JPG to PNG Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="bulk-jpg-to-png" name="Bulk JPG to PNG Converter" description="Convert a whole batch of JPG files to PNG at once. Every file is re-encoded in your browser and downloads individually or as a set." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="image">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="bulk-jpg-to-png"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/bulk-jpg-to-png.js"></script>
