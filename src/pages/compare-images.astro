---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Compare Two Images Online | maratool',
  description: 'Compare two images online with side-by-side, slider, and difference views. Spot pixel-level changes instantly. Free, runs in your browser, no upload.',
  canonical: 'https://maratool.com/compare-images',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Compare Two Images Online',
    url: 'https://maratool.com/compare-images',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Compare two images online with side-by-side, slider, and difference views. Spot pixel-level changes instantly. Free, runs in your browser, no upload.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I tell whether two images are identical?', acceptedAnswer: { '@type': 'Answer', text: 'Use the Difference view. It subtracts one image from the other pixel by pixel, so anything that is not black is a real change. Two identical files come out completely black.' } },
      { '@type': 'Question', name: 'What does the slider view do?', acceptedAnswer: { '@type': 'Answer', text: 'It stacks both images and lets you drag a divider across them, which is the fastest way to judge a before and after crop or a retouch.' } },
      { '@type': 'Question', name: 'Do the two images need to be the same size?', acceptedAnswer: { '@type': 'Answer', text: 'For side by side, no. For slider and difference the comparison only makes sense when the dimensions match, since the views line the images up pixel for pixel.' } },
      { '@type': 'Question', name: 'Are the images uploaded to compare them?', acceptedAnswer: { '@type': 'Answer', text: 'No. Both are decoded and composited on a canvas in your browser.' } },
    ],
  },
}

const howTo = [
  'Drop in two images. They load together and the first view opens automatically.',
  'Switch between Side by side, Slider, and Difference using the tabs above the canvas.',
  'Drag the divider in Slider view, or read Difference to spot changes too small to see by eye.',
]

const faq = [
  { q: 'How do I tell whether two images are identical?', a: 'Use the Difference view. It subtracts one image from the other pixel by pixel, so anything that is not black is a real change. Two identical files come out completely black.' },
  { q: 'What does the slider view do?', a: 'It stacks both images and lets you drag a divider across them, which is the fastest way to judge a before and after crop or a retouch.' },
  { q: 'Do the two images need to be the same size?', a: 'For side by side, no. For slider and difference the comparison only makes sense when the dimensions match, since the views line the images up pixel for pixel.' },
  { q: 'Are the images uploaded to compare them?', a: 'No. Both are decoded and composited on a canvas in your browser.' },
]

const relatedTools = [
  { slug: 'image-compressor', name: 'Compress Image Online' },
  { slug: 'collage-maker', name: 'Collage Maker' },
  { slug: 'view-metadata', name: 'View Image Metadata' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image', href: '/image' },
  { label: 'Inspect', href: '/image/inspect' },
  { label: 'Compare Two Images Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="compare-images" name="Compare Two Images Online" description="Put two images side by side, drag a slider across them, or subtract one from the other to find changes too small to see." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="compare-images">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="compare-images"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/compare-images.js"></script>
