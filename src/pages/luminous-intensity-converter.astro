---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Luminous Intensity — Candela & Candlepower | maratool',
  description: 'Convert luminous intensity between candela, millicandela, and candlepower instantly — LED mcd ratings included. Free converter in your browser.',
  canonical: 'https://maratool.com/luminous-intensity-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Luminous Intensity Converter — Candela & Candlepower',
    url: 'https://maratool.com/luminous-intensity-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert luminous intensity between candela, millicandela, and candlepower instantly — LED mcd ratings included. Free converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Light', item: 'https://maratool.com/converter/light' },
      { '@type': 'ListItem', position: 4, name: 'Luminous Intensity Converter — Candela & Candlepower', item: 'https://maratool.com/luminous-intensity-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert millicandela to candela?', acceptedAnswer: { '@type': 'Answer', text: '1 millicandela = 0.001 candela. Choose "Millicandela (mcd)" as From and "Candela (cd)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'What does an LED’s 5000 mcd rating mean?', acceptedAnswer: { '@type': 'Answer', text: '5,000 mcd = 5 cd of intensity along its beam axis. Narrow-angle LEDs score high mcd with little total light — compare lumens for real output.' } },
      { '@type': 'Question', name: 'Is candlepower still a real unit?', acceptedAnswer: { '@type': 'Answer', text: 'Modern "candlepower" equals the candela exactly. Historical variants differ slightly: the international candle was 1.019 cd, the German Hefner candle 0.903 cd.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert millicandela to candela?', a: '1 millicandela = 0.001 candela. Choose "Millicandela (mcd)" as From and "Candela (cd)" as To, type a value, and the result updates instantly.' },
  { q: 'What does an LED’s 5000 mcd rating mean?', a: '5,000 mcd = 5 cd of intensity along its beam axis. Narrow-angle LEDs score high mcd with little total light — compare lumens for real output.' },
  { q: 'Is candlepower still a real unit?', a: 'Modern "candlepower" equals the candela exactly. Historical variants differ slightly: the international candle was 1.019 cd, the German Hefner candle 0.903 cd.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'luminous-flux-converter', name: 'Luminous Flux' },
  { slug: 'luminance-converter', name: 'Luminance Converter' },
  { slug: 'illuminance-converter', name: 'Lux to Foot-Candles' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Light', href: '/converter/light' },
  { label: 'Luminous Intensity' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="luminous-intensity-converter" name="Luminous Intensity Converter — Candela & Candlepower" description="Convert luminous intensity between candela, millicandela, kilocandela, and candlepower." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="lic-from-unit">From</label>
            <select id="lic-from-unit" class="uc-select"></select>
            <input type="number" id="lic-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="lic-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="lic-to-unit">To</label>
            <select id="lic-to-unit" class="uc-select"></select>
            <div class="uc-result" id="lic-result">&mdash;</div>
            <button class="copy-btn" id="lic-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Intensity is converted through the candela, the SI base photometric unit; historical candle factors follow <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/luminous-intensity-converter.js"></script>
