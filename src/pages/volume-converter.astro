---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Volume Converter — Liters, Gallons, Cups & More | maratool',
  description: 'Convert liters to gallons, cups to milliliters, and every common volume unit instantly. Free volume converter that runs entirely in your browser.',
  canonical: 'https://maratool.com/volume-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Volume Converter — Liters, Gallons, Cups & More',
    url: 'https://maratool.com/volume-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert liters to gallons, cups to milliliters, and every common volume unit instantly. Free volume converter that runs entirely in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Volume Converter — Liters, Gallons, Cups & More', item: 'https://maratool.com/volume-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert us gallon to liter?', acceptedAnswer: { '@type': 'Answer', text: '1 us gallon = 3.78541 liter. Choose "US gallon (gal)" as From and "Liter (L)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'Is a US gallon the same as a UK gallon?', acceptedAnswer: { '@type': 'Answer', text: 'No. A US gallon is exactly 3.785411784 L; an imperial (UK) gallon is exactly 4.54609 L — about 20% larger. This tool includes both.' } },
      { '@type': 'Question', name: 'How many milliliters are in a US cup?', acceptedAnswer: { '@type': 'Answer', text: 'A US customary cup is exactly 236.5882365 mL (1/16 of a gallon). US recipe "legal" cups are rounded to 240 mL on nutrition labels.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert us gallon to liter?', a: '1 us gallon = 3.78541 liter. Choose "US gallon (gal)" as From and "Liter (L)" as To, type a value, and the result updates instantly.' },
  { q: 'Is a US gallon the same as a UK gallon?', a: 'No. A US gallon is exactly 3.785411784 L; an imperial (UK) gallon is exactly 4.54609 L — about 20% larger. This tool includes both.' },
  { q: 'How many milliliters are in a US cup?', a: 'A US customary cup is exactly 236.5882365 mL (1/16 of a gallon). US recipe "legal" cups are rounded to 240 mL on nutrition labels.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'area-converter', name: 'Area Converter' },
  { slug: 'volumetric-flow-rate-converter', name: 'Flow Rate Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Volume Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="volume-converter" name="Volume Converter — Liters, Gallons, Cups & More" description="Convert between liters, US gallons, cups, fluid ounces, cubic meters, and more with exact NIST factors." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="vlc-from-unit">From</label>
            <select id="vlc-from-unit" class="uc-select"></select>
            <input type="number" id="vlc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="vlc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="vlc-to-unit">To</label>
            <select id="vlc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="vlc-result">&mdash;</div>
            <button class="copy-btn" id="vlc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the liter using exact US-customary and SI factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/volume-converter.js"></script>
