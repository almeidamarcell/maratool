---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Bulk AVIF to JPG Converter | maratool',
  description: 'Convert multiple AVIF images to JPG at once in your browser. Drop a batch of files, set quality, and download all. Free bulk converter with no upload.',
  canonical: 'https://maratool.com/bulk-avif-to-jpg',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Bulk AVIF to JPG Converter',
    url: 'https://maratool.com/bulk-avif-to-jpg',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert multiple AVIF images to JPG at once in your browser. Drop a batch of files, set quality, and download all. Free bulk converter with no upload.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Why convert AVIF to JPG at all?', acceptedAnswer: { '@type': 'Answer', text: 'AVIF compresses far better, but plenty of software still cannot open it — older photo editors, some print services, and a few content management systems. JPEG is the format everything reads.' } },
      { '@type': 'Question', name: 'Can I convert several AVIF files at once?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The whole batch converts in one pass, with a download per file and a download-all for the set.' } },
      { '@type': 'Question', name: 'Will the JPG be bigger than the AVIF?', acceptedAnswer: { '@type': 'Answer', text: 'Usually yes, often by a wide margin. AVIF is a much newer codec, so the same picture needs more bytes as JPEG to look equivalent.' } },
      { '@type': 'Question', name: 'Does my browser need AVIF support?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, because decoding uses the browser image decoder. Current versions of Chrome, Firefox, Edge and Safari all handle AVIF.' } },
    ],
  },
}

const howTo = [
  'Drop in as many AVIF files as you like — the whole batch loads at once.',
  'Set the JPEG quality slider, then click Convert to JPEG.',
  'Download each JPG on its own, or take the whole set with Download all.',
]

const faq = [
  { q: 'Why convert AVIF to JPG at all?', a: 'AVIF compresses far better, but plenty of software still cannot open it — older photo editors, some print services, and a few content management systems. JPEG is the format everything reads.' },
  { q: 'Can I convert several AVIF files at once?', a: 'Yes. The whole batch converts in one pass, with a download per file and a download-all for the set.' },
  { q: 'Will the JPG be bigger than the AVIF?', a: 'Usually yes, often by a wide margin. AVIF is a much newer codec, so the same picture needs more bytes as JPEG to look equivalent.' },
  { q: 'Does my browser need AVIF support?', a: 'Yes, because decoding uses the browser image decoder. Current versions of Chrome, Firefox, Edge and Safari all handle AVIF.' },
]

const relatedTools = [
  { slug: 'bulk-avif-to-png', name: 'Bulk AVIF to PNG Converter' },
  { slug: 'avif-maker', name: 'AVIF Maker' },
  { slug: 'image-converter', name: 'Image Converter' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Format', href: '/converter/format' },
  { label: 'Bulk AVIF to JPG Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="bulk-avif-to-jpg" name="Bulk AVIF to JPG Converter" description="Convert a whole batch of AVIF files to JPG at once. Every file is re-encoded in your browser and downloads individually or as a set." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="image">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="bulk-avif-to-jpg"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/bulk-avif-to-jpg.js"></script>
