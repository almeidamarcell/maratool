---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'GIF Frame Interpolation — Smooth Motion | maratool',
  description: 'Smooth choppy GIFs with frame interpolation. Generate in-between frames to raise the frame rate and export a fluid GIF. Runs in your browser, no upload.',
  canonical: 'https://maratool.com/interpolate-frames',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GIF Frame Interpolation',
    url: 'https://maratool.com/interpolate-frames',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Smooth choppy GIFs with frame interpolation. Generate in-between frames to raise the frame rate and export a fluid GIF. Runs in your browser, no upload.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Can I smooth a GIF with this?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Drop a GIF in and you get a GIF back, run through a palette pass so the extra frames do not wreck the colours.' } },
      { '@type': 'Question', name: 'How does it invent frames that were never filmed?', acceptedAnswer: { '@type': 'Answer', text: 'Motion interpolation estimates how each block of pixels moves between two real frames and renders the intermediate positions. It works well on smooth panning and poorly on cuts or fast, chaotic motion.' } },
      { '@type': 'Question', name: 'Why does the result look smeared in places?', acceptedAnswer: { '@type': 'Answer', text: 'Where motion is ambiguous the estimate is wrong and you get warping around edges. Lowering the target frame rate usually helps, since fewer frames have to be invented.' } },
      { '@type': 'Question', name: 'How high can I push the frame rate?', acceptedAnswer: { '@type': 'Answer', text: 'Up to sixty. Going far above the source rate multiplies both the artefacts and the processing time without adding real detail.' } },
    ],
  },
}

const howTo = [
  'Drop in a choppy GIF, or an MP4, WebM or MOV clip.',
  'Set the target frame rate and pick how the in-between frames are generated.',
  'Process, then download. A GIF comes back as a GIF; a video comes back as MP4.',
]

const faq = [
  { q: 'Can I smooth a GIF with this?', a: 'Yes. Drop a GIF in and you get a GIF back, run through a palette pass so the extra frames do not wreck the colours.' },
  { q: 'How does it invent frames that were never filmed?', a: 'Motion interpolation estimates how each block of pixels moves between two real frames and renders the intermediate positions. It works well on smooth panning and poorly on cuts or fast, chaotic motion.' },
  { q: 'Why does the result look smeared in places?', a: 'Where motion is ambiguous the estimate is wrong and you get warping around edges. Lowering the target frame rate usually helps, since fewer frames have to be invented.' },
  { q: 'How high can I push the frame rate?', a: 'Up to sixty. Going far above the source rate multiplies both the artefacts and the processing time without adding real detail.' },
]

const relatedTools = [
  { slug: 'fps-converter', name: 'FPS Converter' },
  { slug: 'gif-speed', name: 'Change GIF Speed' },
  { slug: 'video-speed', name: 'Change Video Speed' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Video', href: '/converter/video' },
  { label: 'GIF Frame Interpolation' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="interpolate-frames" name="GIF Frame Interpolation — Smooth Motion" description="Raise the frame rate of a choppy GIF or video by generating the missing in-between frames. GIF in, GIF out, or MP4 for video." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="interpolate-frames">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="interpolate-frames"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/interpolate-frames.js"></script>
