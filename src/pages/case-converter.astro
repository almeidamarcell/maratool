---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Case Converter — Uppercase, Lowercase & Title Case | maratool',
  description: 'Convert text to UPPERCASE, lowercase, Title Case, Sentence case, camelCase, snake_case, kebab-case or CONSTANT_CASE. Live output and one click to copy.',
  canonical: 'https://maratool.com/case-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Case Converter',
    url: 'https://maratool.com/case-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert text between uppercase, lowercase, title case, sentence case, camelCase, PascalCase, snake_case, kebab-case, CONSTANT_CASE and alternating case.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Text', item: 'https://maratool.com/text' },
      { '@type': 'ListItem', position: 3, name: 'Transform', item: 'https://maratool.com/text/transform' },
      { '@type': 'ListItem', position: 4, name: 'Case Converter', item: 'https://maratool.com/case-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert text to lowercase?', acceptedAnswer: { '@type': 'Answer', text: 'Paste the text in the input box and click lowercase. The output updates as you type, and the copy button puts the result on your clipboard.' } },
      { '@type': 'Question', name: 'What is the difference between title case and sentence case?', acceptedAnswer: { '@type': 'Answer', text: 'Title case capitalizes every significant word and leaves short words like a, the, of and in lowercase unless they open or close the line. Sentence case capitalizes only the first word after each period, question mark or exclamation mark.' } },
      { '@type': 'Question', name: 'Does the title case option capitalize small words?', acceptedAnswer: { '@type': 'Answer', text: 'No. It keeps a, an, the, and, but, or, for, nor, on, at, to, from, by, of and in lowercase, except when one of them is the first or last word of the line.' } },
      { '@type': 'Question', name: 'How does camelCase handle an existing identifier?', acceptedAnswer: { '@type': 'Answer', text: 'Each line is split into words on spaces, punctuation and existing case boundaries, so parse_html_value and parseHTMLValue both convert to parseHtmlValue.' } },
    ]
  }
}

const howTo = [
  'Paste or type your text in the input box.',
  'Click the case you want — UPPERCASE, Title Case, camelCase, snake_case and seven more.',
  'Read the converted text below and click Copy.',
]

const faq = [
  { q: 'How do I convert text to lowercase?', a: 'Paste the text in the input box and click <strong>lowercase</strong>. The output updates as you type, and the copy button puts the result on your clipboard.' },
  { q: 'What is the difference between title case and sentence case?', a: 'Title case capitalizes every significant word and leaves short words like <em>a</em>, <em>the</em>, <em>of</em> and <em>in</em> lowercase unless they open or close the line. Sentence case capitalizes only the first word after each period, question mark or exclamation mark.' },
  { q: 'Does the title case option capitalize small words?', a: 'No. It keeps <em>a, an, the, and, but, or, for, nor, on, at, to, from, by, of, in</em> lowercase, except when one of them is the first or last word of the line.' },
  { q: 'How does camelCase handle an existing identifier?', a: 'Each line is split into words on spaces, punctuation and existing case boundaries, so <code>parse_html_value</code> and <code>parseHTMLValue</code> both convert to <code>parseHtmlValue</code>.' },
]

const relatedTools = [
  { slug: 'sort-lines', name: 'Sort Lines Alphabetically' },
  { slug: 'remove-duplicate-lines', name: 'Remove Duplicate Lines' },
  { slug: 'text-line-tools', name: 'Sort, Dedupe & Convert Text Lines' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Text', href: '/text' },
  { label: 'Transform', href: '/text/transform' },
  { label: 'Case Converter' },
]

const modes = [
  { id: 'upper', label: 'UPPERCASE' },
  { id: 'lower', label: 'lowercase' },
  { id: 'title', label: 'Title Case' },
  { id: 'sentence', label: 'Sentence case' },
  { id: 'camel', label: 'camelCase' },
  { id: 'pascal', label: 'PascalCase' },
  { id: 'snake', label: 'snake_case' },
  { id: 'kebab', label: 'kebab-case' },
  { id: 'constant', label: 'CONSTANT_CASE' },
  { id: 'alternating', label: 'aLtErNaTiNg' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="case-converter" name="Case Converter" description="Convert text between uppercase, lowercase, title case, sentence case and six programmer cases. Output updates as you type." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:560px;">
        <label class="tool-label" for="cvc-input">Your text</label>
        <textarea id="cvc-input" class="tool-textarea" rows="7" placeholder="Paste the text you want to convert..." spellcheck="false"></textarea>

        <div class="tool-stats cvc-stats">
          <div class="tool-stat"><span class="tool-stat-value" id="cvc-chars">0</span><span class="tool-stat-label">Characters</span></div>
          <div class="tool-stat"><span class="tool-stat-value" id="cvc-words">0</span><span class="tool-stat-label">Words</span></div>
          <div class="tool-stat"><span class="tool-stat-value" id="cvc-lines">0</span><span class="tool-stat-label">Lines</span></div>
        </div>

        <span class="tool-label" id="cvc-mode-label">Convert to</span>
        <div class="cvc-modes" role="group" aria-labelledby="cvc-mode-label">
          {modes.map((m, i) => (
            <button type="button" class={`cvc-mode${i === 0 ? ' active' : ''}`} data-mode={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>{m.label}</button>
          ))}
        </div>

        <div class="cvc-output-head">
          <label class="tool-label" for="cvc-output" style="margin:0;">Result</label>
          <div class="cvc-output-actions">
            <button type="button" id="cvc-clear" class="copy-btn">Clear</button>
            <button type="button" id="cvc-copy" class="copy-btn">Copy</button>
          </div>
        </div>
        <textarea id="cvc-output" class="tool-textarea" rows="7" readonly spellcheck="false"></textarea>
      </div>
    </ToolShell>
  </Layout>
</Base>
<style is:global>
  .cvc-stats { margin-top: 1rem; }
  .cvc-modes { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.5rem 0 1.25rem; }
  .cvc-mode {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    padding: 7px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text-2);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .cvc-mode:hover { background: var(--bg-hover); color: var(--text); }
  .cvc-mode.active { border-color: var(--accent); color: var(--accent); background: var(--bg-soft); font-weight: 600; }
  .cvc-output-head { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .cvc-output-actions { display: flex; gap: 0.5rem; }
  @media (max-width: 600px) { .cvc-mode { font-size: 12px; padding: 6px 10px; } }
</style>
<script src="../tools/case-converter.js"></script>
