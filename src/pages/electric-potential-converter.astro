---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Electric Potential Converter — V, mV, kV | maratool',
  description: 'Convert electric potential between volts, millivolts, microvolts, kilovolts, and megavolts instantly. Free voltage unit converter in your browser.',
  canonical: 'https://maratool.com/electric-potential-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Electric Potential Converter — Volts, Millivolts & Kilovolts',
    url: 'https://maratool.com/electric-potential-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert electric potential between volts, millivolts, microvolts, kilovolts, and megavolts instantly. Free voltage unit converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Electrical', item: 'https://maratool.com/converter/electrical' },
      { '@type': 'ListItem', position: 4, name: 'Electric Potential Converter — Volts, Millivolts & Kilovolts', item: 'https://maratool.com/electric-potential-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert millivolt to volt?', acceptedAnswer: { '@type': 'Answer', text: '1 millivolt = 0.001 volt. Choose "Millivolt (mV)" as From and "Volt (V)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many millivolts are in a volt?', acceptedAnswer: { '@type': 'Answer', text: '1,000 mV. Sensor outputs and thermocouple signals sit in the mV range; a AA cell is 1,500 mV; distribution lines run at 11–33 kV.' } },
      { '@type': 'Question', name: 'Is this for travel voltage converters?', acceptedAnswer: { '@type': 'Answer', text: 'No — this converts units of electric potential (mV ↔ V ↔ kV). A 110/220 V travel adapter is a transformer device, not a unit conversion.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert millivolt to volt?', a: '1 millivolt = 0.001 volt. Choose "Millivolt (mV)" as From and "Volt (V)" as To, type a value, and the result updates instantly.' },
  { q: 'How many millivolts are in a volt?', a: '1,000 mV. Sensor outputs and thermocouple signals sit in the mV range; a AA cell is 1,500 mV; distribution lines run at 11–33 kV.' },
  { q: 'Is this for travel voltage converters?', a: 'No — this converts units of electric potential (mV ↔ V ↔ kV). A 110/220 V travel adapter is a transformer device, not a unit conversion.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'electric-current-converter', name: 'Electric Current' },
  { slug: 'electrical-resistance-converter', name: 'Resistance Converter' },
  { slug: 'energy-converter', name: 'Energy Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Electrical', href: '/converter/electrical' },
  { label: 'Electric Potential' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="electric-potential-converter" name="Electric Potential Converter — Volts, Millivolts & Kilovolts" description="Convert between volts, millivolts, microvolts, kilovolts, megavolts, and CGS potential units." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="epc-from-unit">From</label>
            <select id="epc-from-unit" class="uc-select"></select>
            <input type="number" id="epc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="epc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="epc-to-unit">To</label>
            <select id="epc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="epc-result">&mdash;</div>
            <button class="copy-btn" id="epc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the volt using exact SI prefixes; CGS units use factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/electric-potential-converter.js"></script>
