---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Electric Current Converter — A, mA, µA & kA | maratool',
  description: 'Convert electric current between amps, milliamps, microamps, and kiloamps instantly. Free A, mA, µA, and kA unit converter that runs in your browser.',
  canonical: 'https://maratool.com/electric-current-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Electric Current Converter — Amps, Milliamps & Kiloamps',
    url: 'https://maratool.com/electric-current-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert electric current between amps, milliamps, microamps, and kiloamps instantly. Free A, mA, µA, and kA unit converter that runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Electrical', item: 'https://maratool.com/converter/electrical' },
      { '@type': 'ListItem', position: 4, name: 'Electric Current Converter — Amps, Milliamps & Kiloamps', item: 'https://maratool.com/electric-current-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert milliampere to ampere?', acceptedAnswer: { '@type': 'Answer', text: '1 milliampere = 0.001 ampere. Choose "Milliampere (mA)" as From and "Ampere (A)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many mA is 1 A?', acceptedAnswer: { '@type': 'Answer', text: '1,000 mA. USB-A ports supply up to 500 mA (USB 2.0) or 900 mA (USB 3.0); USB-C PD chargers push 3–5 A.' } },
      { '@type': 'Question', name: 'What current levels are dangerous?', acceptedAnswer: { '@type': 'Answer', text: 'Across the chest, 10–20 mA AC can prevent letting go and ~100 mA can be fatal — which is why GFCI breakers trip at 5–6 mA. Currents in electronics (µA–mA) are far below household supply capability, but treat mains wiring with respect.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert milliampere to ampere?', a: '1 milliampere = 0.001 ampere. Choose "Milliampere (mA)" as From and "Ampere (A)" as To, type a value, and the result updates instantly.' },
  { q: 'How many mA is 1 A?', a: '1,000 mA. USB-A ports supply up to 500 mA (USB 2.0) or 900 mA (USB 3.0); USB-C PD chargers push 3–5 A.' },
  { q: 'What current levels are dangerous?', a: 'Across the chest, 10–20 mA AC can prevent letting go and ~100 mA can be fatal — which is why GFCI breakers trip at 5–6 mA. Currents in electronics (µA–mA) are far below household supply capability, but treat mains wiring with respect.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'electric-potential-converter', name: 'Electric Potential' },
  { slug: 'electrical-resistance-converter', name: 'Resistance Converter' },
  { slug: 'electric-charge-converter', name: 'Electric Charge' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Electrical', href: '/converter/electrical' },
  { label: 'Electric Current' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="electric-current-converter" name="Electric Current Converter — Amps, Milliamps & Kiloamps" description="Convert between amperes, milliamperes, microamperes, kiloamperes, and CGS current units." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="cuc-from-unit">From</label>
            <select id="cuc-from-unit" class="uc-select"></select>
            <input type="number" id="cuc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="cuc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="cuc-to-unit">To</label>
            <select id="cuc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="cuc-result">&mdash;</div>
            <button class="copy-btn" id="cuc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the ampere, the SI base unit for current defined in the <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener" target="_blank">BIPM SI Brochure</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/electric-current-converter.js"></script>
