---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Area Converter — Sq Ft, Sq M, Acres & Hectares | maratool',
  description: 'Convert square feet to square meters, acres to hectares, and every common area unit instantly. Free area converter that runs in your browser.',
  canonical: 'https://maratool.com/area-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Area Converter — Square Feet, Square Meters, Acres & Hectares',
    url: 'https://maratool.com/area-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert square feet to square meters, acres to hectares, and every common area unit instantly. Free area converter that runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Area Converter — Square Feet, Square Meters, Acres & Hectares', item: 'https://maratool.com/area-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert square foot to square meter?', acceptedAnswer: { '@type': 'Answer', text: '1 square foot = 0.092903 square meter. Choose "Square foot (ft²)" as From and "Square meter (m²)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many square feet are in an acre?', acceptedAnswer: { '@type': 'Answer', text: 'One acre equals exactly 43,560 square feet, or about 4,046.86 square meters. A hectare is larger: 10,000 m², roughly 2.47 acres.' } },
      { '@type': 'Question', name: 'Are these factors exact or rounded?', acceptedAnswer: { '@type': 'Answer', text: 'Exact. Area factors derive from the international foot (0.3048 m exactly), so ft², yd², acre, and mi² conversions carry no rounding error.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert square foot to square meter?', a: '1 square foot = 0.092903 square meter. Choose "Square foot (ft²)" as From and "Square meter (m²)" as To, type a value, and the result updates instantly.' },
  { q: 'How many square feet are in an acre?', a: 'One acre equals exactly 43,560 square feet, or about 4,046.86 square meters. A hectare is larger: 10,000 m², roughly 2.47 acres.' },
  { q: 'Are these factors exact or rounded?', a: 'Exact. Area factors derive from the international foot (0.3048 m exactly), so ft², yd², acre, and mi² conversions carry no rounding error.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'volume-converter', name: 'Volume Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' },
  { slug: 'screen-size-calculator', name: 'Screen Size Calculator' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Area Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="area-converter" name="Area Converter — Square Feet, Square Meters, Acres & Hectares" description="Convert between square feet, square meters, acres, hectares, and other area units with exact NIST factors." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="arc-from-unit">From</label>
            <select id="arc-from-unit" class="uc-select"></select>
            <input type="number" id="arc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="arc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="arc-to-unit">To</label>
            <select id="arc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="arc-result">&mdash;</div>
            <button class="copy-btn" id="arc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the square meter (SI base) using exact factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/area-converter.js"></script>
