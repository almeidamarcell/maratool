---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Passport Photo Maker Online | maratool',
  description: 'Make passport photos online. Crop your picture to standard passport and visa sizes and download a print-ready image. Free, no upload, runs in-browser.',
  canonical: 'https://maratool.com/passport-photo',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Passport Photo Maker Online',
    url: 'https://maratool.com/passport-photo',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Make passport photos online. Crop your picture to standard passport and visa sizes and download a print-ready image. Free, no upload, runs in-browser.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What size does it produce?', acceptedAnswer: { '@type': 'Answer', text: 'Pick from the preset list, which covers the common document sizes including US two by two inches and EU thirty-five by forty-five millimetres. The output is scaled to the exact proportions of the one you choose.' } },
      { '@type': 'Question', name: 'What are the guides for?', acceptedAnswer: { '@type': 'Answer', text: 'They mark where the top of the head and the eye line are supposed to fall. Most rejected photos fail on head size or eye height, so line yours up against them before downloading.' } },
      { '@type': 'Question', name: 'Does this guarantee my photo will be accepted?', acceptedAnswer: { '@type': 'Answer', text: 'No. It sizes and frames the photo correctly, but it cannot judge lighting, shadows, expression or glare on glasses, and it does not detect faces. Check the requirements your issuing authority publishes.' } },
      { '@type': 'Question', name: 'Is my photo uploaded?', acceptedAnswer: { '@type': 'Answer', text: 'No. The crop and resize happen on a canvas in your browser, which matters more than usual for an identity document.' } },
    ],
  },
}

const howTo = [
  'Drop in a head-and-shoulders photo taken against a plain wall.',
  'Pick the document size, then zoom and drag until your head sits inside the guides.',
  'Choose a white or light blue background and download the sized photo.',
]

const faq = [
  { q: 'What size does it produce?', a: 'Pick from the preset list, which covers the common document sizes including US two by two inches and EU thirty-five by forty-five millimetres. The output is scaled to the exact proportions of the one you choose.' },
  { q: 'What are the guides for?', a: 'They mark where the top of the head and the eye line are supposed to fall. Most rejected photos fail on head size or eye height, so line yours up against them before downloading.' },
  { q: 'Does this guarantee my photo will be accepted?', a: 'No. It sizes and frames the photo correctly, but it cannot judge lighting, shadows, expression or glare on glasses, and it does not detect faces. Check the requirements your issuing authority publishes.' },
  { q: 'Is my photo uploaded?', a: 'No. The crop and resize happen on a canvas in your browser, which matters more than usual for an identity document.' },
]

const relatedTools = [
  { slug: 'crop-image', name: 'Crop Image Online' },
  { slug: 'resize-image', name: 'Resize Image Online' },
  { slug: 'background-remover', name: 'Background Remover' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image', href: '/image' },
  { label: 'Transform', href: '/image/transform' },
  { label: 'Passport Photo Maker Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="passport-photo" name="Passport Photo Maker Online" description="Size a photo to a passport or visa format with head and eye-line guides, adjustable zoom and a white or light blue background." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="passport-photo">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="passport-photo"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/passport-photo.js"></script>
