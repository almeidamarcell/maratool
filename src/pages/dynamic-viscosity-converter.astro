---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Dynamic Viscosity Converter — Pa·s, Poise, cP | maratool',
  description: 'Convert dynamic viscosity between Pa·s, poise, centipoise, and lbf·s/ft² instantly with NIST factors. Free viscosity converter in your browser.',
  canonical: 'https://maratool.com/dynamic-viscosity-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Dynamic Viscosity Converter — Pa·s, Poise & Centipoise',
    url: 'https://maratool.com/dynamic-viscosity-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert dynamic viscosity between Pa·s, poise, centipoise, and lbf·s/ft² instantly with NIST factors. Free viscosity converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Science', item: 'https://maratool.com/converter/science' },
      { '@type': 'ListItem', position: 4, name: 'Dynamic Viscosity Converter — Pa·s, Poise & Centipoise', item: 'https://maratool.com/dynamic-viscosity-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert centipoise to pascal-second?', acceptedAnswer: { '@type': 'Answer', text: '1 centipoise = 0.001 pascal-second. Choose "Centipoise (cP)" as From and "Pascal-second (Pa·s)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'Why is centipoise so common?', acceptedAnswer: { '@type': 'Answer', text: 'Water at 20 °C has a viscosity of almost exactly 1 cP (1.002 mPa·s), which makes cP an intuitive scale: olive oil ≈ 80 cP, honey ≈ 10,000 cP.' } },
      { '@type': 'Question', name: 'Is mPa·s the same as cP?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, exactly: 1 cP = 1 mPa·s = 0.001 Pa·s. Datasheets use them interchangeably; SI style prefers mPa·s.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert centipoise to pascal-second?', a: '1 centipoise = 0.001 pascal-second. Choose "Centipoise (cP)" as From and "Pascal-second (Pa·s)" as To, type a value, and the result updates instantly.' },
  { q: 'Why is centipoise so common?', a: 'Water at 20 °C has a viscosity of almost exactly 1 cP (1.002 mPa·s), which makes cP an intuitive scale: olive oil ≈ 80 cP, honey ≈ 10,000 cP.' },
  { q: 'Is mPa·s the same as cP?', a: 'Yes, exactly: 1 cP = 1 mPa·s = 0.001 Pa·s. Datasheets use them interchangeably; SI style prefers mPa·s.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'kinematic-viscosity-converter', name: 'Kinematic Viscosity' },
  { slug: 'density-converter', name: 'Density Converter' },
  { slug: 'pressure-converter', name: 'Pressure Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Science', href: '/converter/science' },
  { label: 'Dynamic Viscosity' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="dynamic-viscosity-converter" name="Dynamic Viscosity Converter — Pa·s, Poise & Centipoise" description="Convert between pascal-seconds, poise, centipoise, and pound-based viscosity units using NIST factors." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="dvc-from-unit">From</label>
            <select id="dvc-from-unit" class="uc-select"></select>
            <input type="number" id="dvc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="dvc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="dvc-to-unit">To</label>
            <select id="dvc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="dvc-result">&mdash;</div>
            <button class="copy-btn" id="dvc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the pascal-second (SI) with factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/dynamic-viscosity-converter.js"></script>
