---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Bulk AVIF to PNG Converter | maratool',
  description: 'Convert multiple AVIF images to PNG in one batch, right in your browser. Drop files, convert, and download all at once. Free, no upload to servers.',
  canonical: 'https://maratool.com/bulk-avif-to-png',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Bulk AVIF to PNG Converter',
    url: 'https://maratool.com/bulk-avif-to-png',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert multiple AVIF images to PNG in one batch, right in your browser. Drop files, convert, and download all at once. Free, no upload to servers.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Does transparency survive the conversion?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Both AVIF and PNG carry an alpha channel, so transparent areas stay transparent.' } },
      { '@type': 'Question', name: 'Can I convert several AVIF files at once?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Drop the whole batch and each file is converted and offered as its own download, plus a download-all.' } },
      { '@type': 'Question', name: 'Why is the PNG so much larger?', acceptedAnswer: { '@type': 'Answer', text: 'PNG is lossless and AVIF is not. Expect the PNG to be several times the size for a photographic image. That is the cost of a format every program can open.' } },
      { '@type': 'Question', name: 'Are my images uploaded anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. The conversion happens in your browser and nothing is sent to a server.' } },
    ],
  },
}

const howTo = [
  'Drop in as many AVIF files as you like — the whole batch loads at once.',
  'Click Convert to PNG. Every file in the batch is re-encoded, not just the first.',
  'Download each PNG on its own, or take the whole set with Download all.',
]

const faq = [
  { q: 'Does transparency survive the conversion?', a: 'Yes. Both AVIF and PNG carry an alpha channel, so transparent areas stay transparent.' },
  { q: 'Can I convert several AVIF files at once?', a: 'Yes. Drop the whole batch and each file is converted and offered as its own download, plus a download-all.' },
  { q: 'Why is the PNG so much larger?', a: 'PNG is lossless and AVIF is not. Expect the PNG to be several times the size for a photographic image. That is the cost of a format every program can open.' },
  { q: 'Are my images uploaded anywhere?', a: 'No. The conversion happens in your browser and nothing is sent to a server.' },
]

const relatedTools = [
  { slug: 'bulk-avif-to-jpg', name: 'Bulk AVIF to JPG Converter' },
  { slug: 'avif-maker', name: 'AVIF Maker' },
  { slug: 'image-converter', name: 'Image Converter' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Format', href: '/converter/format' },
  { label: 'Bulk AVIF to PNG Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="bulk-avif-to-png" name="Bulk AVIF to PNG Converter" description="Convert a whole batch of AVIF files to PNG at once. Every file is re-encoded in your browser and downloads individually or as a set." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="image">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="bulk-avif-to-png"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/bulk-avif-to-png.js"></script>
