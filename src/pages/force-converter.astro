---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Force Converter — Newtons, kgf & lbf | maratool',
  description: 'Convert newtons to pounds-force, kilograms-force, dynes, and poundals instantly with exact NIST factors. Free force converter in your browser.',
  canonical: 'https://maratool.com/force-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Force Converter — Newtons, Kilograms-Force & Pounds-Force',
    url: 'https://maratool.com/force-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert newtons to pounds-force, kilograms-force, dynes, and poundals instantly with exact NIST factors. Free force converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Force Converter — Newtons, Kilograms-Force & Pounds-Force', item: 'https://maratool.com/force-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert kilogram-force to newton?', acceptedAnswer: { '@type': 'Answer', text: '1 kilogram-force = 9.80665 newton. Choose "Kilogram-force (kgf)" as From and "Newton (N)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'Is kilogram a unit of force?', acceptedAnswer: { '@type': 'Answer', text: 'Strictly no — the kilogram measures mass. The kilogram-force (kgf) is the weight of 1 kg under standard gravity: exactly 9.80665 N. Scales labeled "kg" report mass assuming that gravity.' } },
      { '@type': 'Question', name: 'What is a poundal?', acceptedAnswer: { '@type': 'Answer', text: 'The poundal is the force that accelerates 1 lb at 1 ft/s² — exactly 0.138254954376 N. It appears in older engineering texts using the absolute foot-pound-second system.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert kilogram-force to newton?', a: '1 kilogram-force = 9.80665 newton. Choose "Kilogram-force (kgf)" as From and "Newton (N)" as To, type a value, and the result updates instantly.' },
  { q: 'Is kilogram a unit of force?', a: 'Strictly no — the kilogram measures mass. The kilogram-force (kgf) is the weight of 1 kg under standard gravity: exactly 9.80665 N. Scales labeled "kg" report mass assuming that gravity.' },
  { q: 'What is a poundal?', a: 'The poundal is the force that accelerates 1 lb at 1 ft/s² — exactly 0.138254954376 N. It appears in older engineering texts using the absolute foot-pound-second system.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'torque-converter', name: 'Torque Converter' },
  { slug: 'pressure-converter', name: 'Pressure Converter' },
  { slug: 'acceleration-converter', name: 'Acceleration Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Force Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="force-converter" name="Force Converter — Newtons, Kilograms-Force & Pounds-Force" description="Convert between newtons, kilograms-force, pounds-force, dynes, and poundals using exact NIST factors." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="foc-from-unit">From</label>
            <select id="foc-from-unit" class="uc-select"></select>
            <input type="number" id="foc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="foc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="foc-to-unit">To</label>
            <select id="foc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="foc-result">&mdash;</div>
            <button class="copy-btn" id="foc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the newton (SI) with exact factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/force-converter.js"></script>
