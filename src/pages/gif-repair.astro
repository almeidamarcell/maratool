---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Repair Corrupted GIF Online | maratool',
  description: 'Repair a corrupted GIF online. Rebuild a broken animated GIF so it plays again, then download the fixed file in seconds. No upload, no watermark.',
  canonical: 'https://maratool.com/gif-repair',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Repair Corrupted GIF Online',
    url: 'https://maratool.com/gif-repair',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Repair a corrupted GIF online. Rebuild a broken animated GIF so it plays again, then download the fixed file in seconds. No upload, no watermark.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What can it actually repair?', acceptedAnswer: { '@type': 'Answer', text: 'A missing or truncated trailer, junk before the header or after the terminator, a missing or malformed Netscape loop block, frames with a zero or absurd delay, and a missing colour table. Frames whose pixel data was cut off get dropped and everything before them is kept.' } },
      { '@type': 'Question', name: 'Why will my GIF not animate?', acceptedAnswer: { '@type': 'Answer', text: 'Usually a missing Netscape looping block, or delays of zero that leave viewers guessing at a frame rate. The scan names which one it is, and the rebuilt file gets a real loop block and sane delays.' } },
      { '@type': 'Question', name: 'What if the file cannot be recovered?', acceptedAnswer: { '@type': 'Answer', text: 'You get the specific reason: it is a PNG with a .gif name, the header stops after six bytes, the first frame never finished downloading. Never a generic invalid file message.' } },
      { '@type': 'Question', name: 'Is there a file size limit?', acceptedAnswer: { '@type': 'Answer', text: 'GIF tools: up to 50 MB. Very large GIFs are scaled down to fit browser memory.' } },
    ],
  },
}

const howTo = [
  'Drop in the GIF that will not open or will not animate.',
  'Read the scan — it lists every problem it found and what the rebuild will do about each one.',
  'Click Repair GIF and download the rebuilt file.',
]

const faq = [
  { q: 'What can it actually repair?', a: 'A missing or truncated trailer, junk before the header or after the terminator, a missing or malformed Netscape loop block, frames with a zero or absurd delay, and a missing colour table. Frames whose pixel data was cut off get dropped and everything before them is kept.' },
  { q: 'Why will my GIF not animate?', a: 'Usually a missing Netscape looping block, or delays of zero that leave viewers guessing at a frame rate. The scan names which one it is, and the rebuilt file gets a real loop block and sane delays.' },
  { q: 'What if the file cannot be recovered?', a: 'You get the specific reason: it is a PNG with a .gif name, the header stops after six bytes, the first frame never finished downloading. Never a generic "invalid file".' },
  { q: 'Is there a file size limit?', a: 'GIF: 50 MB. Very large GIFs are scaled down to fit browser memory, and the tool tells you when that happens.' },
]

const relatedTools = [
  { slug: 'gif-loop-count', name: 'Change GIF Loop Count' },
  { slug: 'gif-compressor', name: 'GIF Compressor' },
  { slug: 'gif-maker', name: 'GIF Maker' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image', href: '/image' },
  { label: 'Animated', href: '/image/animated' },
  { label: 'Repair Corrupted GIF Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="gif-repair" name="Repair Corrupted GIF Online" description="Repair Corrupted GIF Online. Free, runs in your browser — no upload to servers." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;">
        <div class="ga-dropzone tool-dropzone" id="ga-dropzone">
          <input type="file" id="ga-file-input" accept="image/gif" hidden />
          <p>Drop a GIF or click to upload</p>
        </div>
        <div id="ga-settings" hidden>
          <img id="ga-preview" alt="Preview" style="max-width:100%;max-height:200px;" />
          <label class="tool-label" for="ga-loopCount">Loop count for the rebuilt file (0 = loop forever)</label>
          <input class="tool-input" id="ga-loopCount" type="number" min="0" data-ga-opt="loopCount" value="0" />
          <button type="button" class="tool-btn" id="ga-process" style="margin-top:1rem;">Repair GIF</button>
        </div>
        <div id="ga-progress" class="tool-progress" hidden>
          <p id="ga-progress-text" class="tool-progress-text">Processing...</p>
          <div class="tool-progress-bar"><div id="ga-progress-fill" class="tool-progress-fill"></div></div>
          <p id="ga-progress-detail" class="tool-progress-detail"></p>
        </div>
        <div id="ga-result" hidden>
          <img id="ga-result-img" alt="Result" style="max-width:100%;" />
          <button type="button" class="tool-btn" id="ga-download" style="margin-top:1rem;">Download</button>
        </div>
        <p id="ga-error" class="tool-error" hidden><span id="ga-error-text"></span></p>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/gif-repair.js"></script>
