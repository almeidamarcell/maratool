---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Acceleration Converter — m/s², G-Force & More | maratool',
  description: 'Convert m/s² to g-force, ft/s², Gal, and km/h per second instantly with exact NIST factors. Free acceleration unit converter in your browser.',
  canonical: 'https://maratool.com/acceleration-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Acceleration Converter — m/s², G-Force & More',
    url: 'https://maratool.com/acceleration-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert m/s² to g-force, ft/s², Gal, and km/h per second instantly with exact NIST factors. Free acceleration unit converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Acceleration Converter — m/s², G-Force & More', item: 'https://maratool.com/acceleration-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert standard gravity to meter per second squared?', acceptedAnswer: { '@type': 'Answer', text: '1 standard gravity = 9.80665 meter per second squared. Choose "Standard gravity (g)" as From and "Meter per second squared (m/s²)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many m/s² is 1 g?', acceptedAnswer: { '@type': 'Answer', text: 'Standard gravity is exactly 9.80665 m/s². A car pulling 0.9 g in a corner is accelerating laterally at about 8.83 m/s².' } },
      { '@type': 'Question', name: 'What is the Gal unit?', acceptedAnswer: { '@type': 'Answer', text: 'The Gal (galileo) is 1 cm/s² = 0.01 m/s², used in gravimetry and seismology. Earth-surface gravity variations are measured in milligals.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert standard gravity to meter per second squared?', a: '1 standard gravity = 9.80665 meter per second squared. Choose "Standard gravity (g)" as From and "Meter per second squared (m/s²)" as To, type a value, and the result updates instantly.' },
  { q: 'How many m/s² is 1 g?', a: 'Standard gravity is exactly 9.80665 m/s². A car pulling 0.9 g in a corner is accelerating laterally at about 8.83 m/s².' },
  { q: 'What is the Gal unit?', a: 'The Gal (galileo) is 1 cm/s² = 0.01 m/s², used in gravimetry and seismology. Earth-surface gravity variations are measured in milligals.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'force-converter', name: 'Force Converter' },
  { slug: 'wind-speed-converter', name: 'Wind Speed Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Acceleration Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="acceleration-converter" name="Acceleration Converter — m/s², G-Force & More" description="Convert between meters per second squared, standard gravity (g), feet per second squared, and Gal." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="acc-from-unit">From</label>
            <select id="acc-from-unit" class="uc-select"></select>
            <input type="number" id="acc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="acc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="acc-to-unit">To</label>
            <select id="acc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="acc-result">&mdash;</div>
            <button class="copy-btn" id="acc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the meter per second squared (SI) with exact factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/acceleration-converter.js"></script>
