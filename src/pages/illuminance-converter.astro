---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Lux to Foot-Candles Converter — Illuminance | maratool',
  description: 'Convert illuminance between lux, foot-candles, and phots instantly — 1 fc = 10.764 lx exactly. Free lighting unit converter in your browser.',
  canonical: 'https://maratool.com/illuminance-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Lux to Foot-Candles Converter — Illuminance',
    url: 'https://maratool.com/illuminance-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert illuminance between lux, foot-candles, and phots instantly — 1 fc = 10.764 lx exactly. Free lighting unit converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Light', item: 'https://maratool.com/converter/light' },
      { '@type': 'ListItem', position: 4, name: 'Lux to Foot-Candles Converter — Illuminance', item: 'https://maratool.com/illuminance-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert foot-candle to lux?', acceptedAnswer: { '@type': 'Answer', text: '1 foot-candle = 10.7639 lux. Choose "Foot-candle (fc)" as From and "Lux (lx)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many lux is one foot-candle?', acceptedAnswer: { '@type': 'Answer', text: '10.7639 lx — one lumen per square foot versus per square meter, so the ratio is exactly 1/0.09290304. Quick rule: multiply fc by ~10.8.' } },
      { '@type': 'Question', name: 'What illuminance levels are typical?', acceptedAnswer: { '@type': 'Answer', text: 'Office work: 300–500 lx (30–46 fc); detailed tasks: 750–1,000 lx; overcast daylight: ~1,000 lx; direct sun: over 100,000 lx.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert foot-candle to lux?', a: '1 foot-candle = 10.7639 lux. Choose "Foot-candle (fc)" as From and "Lux (lx)" as To, type a value, and the result updates instantly.' },
  { q: 'How many lux is one foot-candle?', a: '10.7639 lx — one lumen per square foot versus per square meter, so the ratio is exactly 1/0.09290304. Quick rule: multiply fc by ~10.8.' },
  { q: 'What illuminance levels are typical?', a: 'Office work: 300–500 lx (30–46 fc); detailed tasks: 750–1,000 lx; overcast daylight: ~1,000 lx; direct sun: over 100,000 lx.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'luminance-converter', name: 'Luminance Converter' },
  { slug: 'luminous-flux-converter', name: 'Luminous Flux' },
  { slug: 'luminous-intensity-converter', name: 'Luminous Intensity' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Light', href: '/converter/light' },
  { label: 'Lux to Foot-Candles' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="illuminance-converter" name="Lux to Foot-Candles Converter — Illuminance" description="Convert illuminance between lux, kilolux, foot-candles, and phots." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="ilc-from-unit">From</label>
            <select id="ilc-from-unit" class="uc-select"></select>
            <input type="number" id="ilc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="ilc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="ilc-to-unit">To</label>
            <select id="ilc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="ilc-result">&mdash;</div>
            <button class="copy-btn" id="ilc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Illuminance is converted through the lux; the foot-candle uses the exact square-foot relation from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/illuminance-converter.js"></script>
