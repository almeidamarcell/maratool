---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Magnetic Field Strength — A/m & Oersted | maratool',
  description: 'Convert magnetic field strength H between amperes per meter and oersteds instantly using 1 Oe = 1000/4π A/m. Free unit converter, runs in your browser.',
  canonical: 'https://maratool.com/magnetic-field-strength-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Magnetic Field Strength Converter — A/m & Oersted',
    url: 'https://maratool.com/magnetic-field-strength-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert magnetic field strength H between amperes per meter and oersteds instantly using 1 Oe = 1000/4π A/m. Free unit converter, runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Magnetism', item: 'https://maratool.com/converter/magnetism' },
      { '@type': 'ListItem', position: 4, name: 'Magnetic Field Strength Converter — A/m & Oersted', item: 'https://maratool.com/magnetic-field-strength-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert oersted to ampere per meter?', acceptedAnswer: { '@type': 'Answer', text: '1 oersted = 79.5775 ampere per meter. Choose "Oersted (Oe)" as From and "Ampere per meter (A/m)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'Why is the oersted factor 1000/4π?', acceptedAnswer: { '@type': 'Answer', text: 'CGS electromagnetic units absorb a 4π into the field definitions. Converting to SI reintroduces it: 1 Oe = 1000/(4π) ≈ 79.577 A/m.' } },
      { '@type': 'Question', name: 'Where is field strength used instead of flux density?', acceptedAnswer: { '@type': 'Answer', text: 'Magnet coercivity (Hc) and coil magnetizing fields are quoted in Oe or kA/m. Inside a material, B = µ₀(H + M) — H is what your coil applies, B is what results.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert oersted to ampere per meter?', a: '1 oersted = 79.5775 ampere per meter. Choose "Oersted (Oe)" as From and "Ampere per meter (A/m)" as To, type a value, and the result updates instantly.' },
  { q: 'Why is the oersted factor 1000/4π?', a: 'CGS electromagnetic units absorb a 4π into the field definitions. Converting to SI reintroduces it: 1 Oe = 1000/(4π) ≈ 79.577 A/m.' },
  { q: 'Where is field strength used instead of flux density?', a: 'Magnet coercivity (Hc) and coil magnetizing fields are quoted in Oe or kA/m. Inside a material, B = µ₀(H + M) — H is what your coil applies, B is what results.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'magnetic-field-converter', name: 'Tesla to Gauss' },
  { slug: 'magnetomotive-force-converter', name: 'Magnetomotive Force' },
  { slug: 'magnetic-flux-converter', name: 'Magnetic Flux' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Magnetism', href: '/converter/magnetism' },
  { label: 'Field Strength' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="magnetic-field-strength-converter" name="Magnetic Field Strength Converter — A/m & Oersted" description="Convert magnetizing field strength between amperes per meter, kiloamperes per meter, and oersteds." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="msc-from-unit">From</label>
            <select id="msc-from-unit" class="uc-select"></select>
            <input type="number" id="msc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="msc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="msc-to-unit">To</label>
            <select id="msc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="msc-result">&mdash;</div>
            <button class="copy-btn" id="msc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Field strength is converted through A/m; the oersted uses the exact 1000/4π relation given in <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/magnetic-field-strength-converter.js"></script>
