---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Apply Video Filters Online | maratool',
  description: 'Apply brightness, contrast, saturation, blur, and grayscale filters to video online. Preview live and export the result — free, no upload to servers.',
  canonical: 'https://maratool.com/video-filters',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Apply Video Filters Online',
    url: 'https://maratool.com/video-filters',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Apply brightness, contrast, saturation, blur, and grayscale filters to video online. Preview live and export the result — free, no upload to servers.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Can I set the values myself or only use presets?', acceptedAnswer: { '@type': 'Answer', text: 'Both. Each of the five controls is a slider you can set freely, and the three presets are starting points that fill the sliders in rather than locking you to a fixed look.' } },
      { '@type': 'Question', name: 'What is gamma for?', acceptedAnswer: { '@type': 'Answer', text: 'It shifts the midtones without moving black and white, which is the control you want when footage looks flat or washed out. Brightness moves everything at once and tends to crush the highlights.' } },
      { '@type': 'Question', name: 'Why is processing slow?', acceptedAnswer: { '@type': 'Answer', text: 'The video is re-encoded frame by frame by ffmpeg compiled to WebAssembly, running in your browser rather than on a server. Longer clips and higher resolutions take proportionally longer.' } },
      { '@type': 'Question', name: 'Does the audio survive?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Only the video stream is filtered; the audio is carried through unchanged.' } },
    ],
  },
}

const howTo = [
  'Drop in an MP4, WebM or MOV clip.',
  'Adjust brightness, contrast, saturation, gamma and blur, or start from the Vivid, Grayscale and Negative presets.',
  'Check the preview frame, then process and download.',
]

const faq = [
  { q: 'Can I set the values myself or only use presets?', a: 'Both. Each of the five controls is a slider you can set freely, and the three presets are starting points that fill the sliders in rather than locking you to a fixed look.' },
  { q: 'What is gamma for?', a: 'It shifts the midtones without moving black and white, which is the control you want when footage looks flat or washed out. Brightness moves everything at once and tends to crush the highlights.' },
  { q: 'Why is processing slow?', a: 'The video is re-encoded frame by frame by ffmpeg compiled to WebAssembly, running in your browser rather than on a server. Longer clips and higher resolutions take proportionally longer.' },
  { q: 'Does the audio survive?', a: 'Yes. Only the video stream is filtered; the audio is carried through unchanged.' },
]

const relatedTools = [
  { slug: 'video-speed', name: 'Change Video Speed' },
  { slug: 'compress-video', name: 'Compress Video' },
  { slug: 'video-stabilizer', name: 'Video Stabilizer' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Video', href: '/converter/video' },
  { label: 'Apply Video Filters Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="video-filters" name="Apply Video Filters Online" description="Grade a clip with brightness, contrast, saturation, gamma and blur sliders, or start from a preset. Runs in your browser, no upload." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="video-filters">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="video-filters"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/video-filters.js"></script>
