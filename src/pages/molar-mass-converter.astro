---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Molar Mass Converter — g/mol, kg/mol & Da | maratool',
  description: 'Convert molar mass between g/mol, kg/mol, kg/kmol, daltons, and lb/lb-mol instantly. Free molar mass unit converter that runs in your browser.',
  canonical: 'https://maratool.com/molar-mass-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Molar Mass Converter — g/mol & kg/mol',
    url: 'https://maratool.com/molar-mass-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert molar mass between g/mol, kg/mol, kg/kmol, daltons, and lb/lb-mol instantly. Free molar mass unit converter that runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Science', item: 'https://maratool.com/converter/science' },
      { '@type': 'ListItem', position: 4, name: 'Molar Mass Converter — g/mol & kg/mol', item: 'https://maratool.com/molar-mass-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert gram per mole to kilogram per mole?', acceptedAnswer: { '@type': 'Answer', text: '1 gram per mole = 0.001 kilogram per mole. Choose "Gram per mole (g/mol)" as From and "Kilogram per mole (kg/mol)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'Why do g/mol, kg/kmol, and lb/lb-mol have the same value?', acceptedAnswer: { '@type': 'Answer', text: 'Scaling both the mass and the amount unit by the same factor cancels out — water is 18.015 g/mol, 18.015 kg/kmol, and 18.015 lb/lb-mol. Only kg/mol shifts the decimal.' } },
      { '@type': 'Question', name: 'Is a dalton the same as g/mol?', acceptedAnswer: { '@type': 'Answer', text: 'Numerically yes: a molecule of mass 500 Da has a molar mass of 500 g/mol. The dalton describes one molecule; g/mol describes a mole of them.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert gram per mole to kilogram per mole?', a: '1 gram per mole = 0.001 kilogram per mole. Choose "Gram per mole (g/mol)" as From and "Kilogram per mole (kg/mol)" as To, type a value, and the result updates instantly.' },
  { q: 'Why do g/mol, kg/kmol, and lb/lb-mol have the same value?', a: 'Scaling both the mass and the amount unit by the same factor cancels out — water is 18.015 g/mol, 18.015 kg/kmol, and 18.015 lb/lb-mol. Only kg/mol shifts the decimal.' },
  { q: 'Is a dalton the same as g/mol?', a: 'Numerically yes: a molecule of mass 500 Da has a molar mass of 500 g/mol. The dalton describes one molecule; g/mol describes a mole of them.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'amount-of-substance-converter', name: 'Amount of Substance' },
  { slug: 'density-converter', name: 'Density Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Science', href: '/converter/science' },
  { label: 'Molar Mass Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="molar-mass-converter" name="Molar Mass Converter — g/mol & kg/mol" description="Convert between grams per mole, kilograms per mole, daltons, and pound-mass per pound-mole." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="mmc-from-unit">From</label>
            <select id="mmc-from-unit" class="uc-select"></select>
            <input type="number" id="mmc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="mmc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="mmc-to-unit">To</label>
            <select id="mmc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="mmc-result">&mdash;</div>
            <button class="copy-btn" id="mmc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Molar masses are converted through g/mol; equal-ratio units (kg/kmol, lb/lb-mol, Da) are exact identities per the <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener" target="_blank">BIPM SI Brochure</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/molar-mass-converter.js"></script>
