---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'View Image EXIF Metadata Online | maratool',
  description: 'View EXIF metadata in any photo: camera model, lens, ISO, shutter, aperture, GPS, and timestamps. Free viewer that never uploads your image.',
  canonical: 'https://maratool.com/view-metadata',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'View Image EXIF Metadata Online',
    url: 'https://maratool.com/view-metadata',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'View EXIF metadata in any photo: camera model, lens, ISO, shutter, aperture, GPS, and timestamps. Free viewer that never uploads your image.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What does EXIF actually contain?', acceptedAnswer: { '@type': 'Answer', text: 'Camera make and model, lens, ISO, shutter speed, aperture, focal length, orientation, and the date the shot was taken. Many phone photos also carry GPS coordinates.' } },
      { '@type': 'Question', name: 'Why does my image show no EXIF?', acceptedAnswer: { '@type': 'Answer', text: 'PNG and WebP files generally carry none, screenshots never do, and most social networks strip it on upload. A missing EXIF block means the data is not in the file, not that reading failed.' } },
      { '@type': 'Question', name: 'Can other people see the GPS location in my photos?', acceptedAnswer: { '@type': 'Answer', text: 'If the file still has EXIF, yes. Anyone who receives the original can read exactly where it was taken. Run it through the EXIF remover before sharing.' } },
      { '@type': 'Question', name: 'Is my photo uploaded to check it?', acceptedAnswer: { '@type': 'Answer', text: 'No. The file is parsed byte by byte in your browser. That is the point of using this rather than an online metadata viewer.' } },
    ],
  },
}

const howTo = [
  'Drop in a photo. Nothing is uploaded, so this is safe for images you would not hand to a web service.',
  'Read the File block for size and dimensions, and the EXIF block for camera, lens, exposure and location.',
  'Copy the whole readout as text if you need to paste it into a bug report or a listing.',
]

const faq = [
  { q: 'What does EXIF actually contain?', a: 'Camera make and model, lens, ISO, shutter speed, aperture, focal length, orientation, and the date the shot was taken. Many phone photos also carry GPS coordinates.' },
  { q: 'Why does my image show no EXIF?', a: 'PNG and WebP files generally carry none, screenshots never do, and most social networks strip it on upload. A missing EXIF block means the data is not in the file, not that reading failed.' },
  { q: 'Can other people see the GPS location in my photos?', a: 'If the file still has EXIF, yes. Anyone who receives the original can read exactly where it was taken. Run it through the EXIF remover before sharing.' },
  { q: 'Is my photo uploaded to check it?', a: 'No. The file is parsed byte by byte in your browser. That is the point of using this rather than an online metadata viewer.' },
]

const relatedTools = [
  { slug: 'exif-remover', name: 'EXIF Remover' },
  { slug: 'image-compressor', name: 'Compress Image Online' },
  { slug: 'image-converter', name: 'Image Converter' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image', href: '/image' },
  { label: 'Inspect', href: '/image/inspect' },
  { label: 'View Image EXIF Metadata Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="view-metadata" name="View Image EXIF Metadata Online" description="Read the EXIF a photo carries: camera, lens, exposure, orientation, date taken and GPS. Parsed in your browser, so the file goes nowhere." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="view-metadata">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="view-metadata"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/view-metadata.js"></script>
