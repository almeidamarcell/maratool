---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Capacitance Converter — Farads, µF, nF & pF | maratool',
  description: 'Convert capacitance between farads, microfarads, nanofarads, and picofarads instantly. Free capacitance unit converter that runs in your browser.',
  canonical: 'https://maratool.com/capacitance-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Capacitance Converter — Farads, µF, nF & pF',
    url: 'https://maratool.com/capacitance-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert capacitance between farads, microfarads, nanofarads, and picofarads instantly. Free capacitance unit converter that runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Electrical', item: 'https://maratool.com/converter/electrical' },
      { '@type': 'ListItem', position: 4, name: 'Capacitance Converter — Farads, µF, nF & pF', item: 'https://maratool.com/capacitance-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert microfarad to nanofarad?', acceptedAnswer: { '@type': 'Answer', text: '1 microfarad = 1000 nanofarad. Choose "Microfarad (µF)" as From and "Nanofarad (nF)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How do I read a capacitor marked 104?', acceptedAnswer: { '@type': 'Answer', text: 'Three-digit codes give picofarads: first two digits × 10^third. 104 = 10 × 10⁴ pF = 100,000 pF = 100 nF = 0.1 µF.' } },
      { '@type': 'Question', name: 'Why are real capacitors never a full farad?', acceptedAnswer: { '@type': 'Answer', text: 'A farad is enormous for electrostatics — typical circuit values run pF to µF. Supercapacitors are the exception, reaching hundreds of farads at low voltage.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert microfarad to nanofarad?', a: '1 microfarad = 1000 nanofarad. Choose "Microfarad (µF)" as From and "Nanofarad (nF)" as To, type a value, and the result updates instantly.' },
  { q: 'How do I read a capacitor marked 104?', a: 'Three-digit codes give picofarads: first two digits × 10^third. 104 = 10 × 10⁴ pF = 100,000 pF = 100 nF = 0.1 µF.' },
  { q: 'Why are real capacitors never a full farad?', a: 'A farad is enormous for electrostatics — typical circuit values run pF to µF. Supercapacitors are the exception, reaching hundreds of farads at low voltage.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'inductance-converter', name: 'Inductance Converter' },
  { slug: 'electric-charge-converter', name: 'Electric Charge' },
  { slug: 'electrical-resistance-converter', name: 'Resistance Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Electrical', href: '/converter/electrical' },
  { label: 'Capacitance Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="capacitance-converter" name="Capacitance Converter — Farads, µF, nF & pF" description="Convert between farads, millifarads, microfarads, nanofarads, and picofarads." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="cpc-from-unit">From</label>
            <select id="cpc-from-unit" class="uc-select"></select>
            <input type="number" id="cpc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="cpc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="cpc-to-unit">To</label>
            <select id="cpc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="cpc-result">&mdash;</div>
            <button class="copy-btn" id="cpc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the farad using exact SI prefixes; CGS units use factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/capacitance-converter.js"></script>
