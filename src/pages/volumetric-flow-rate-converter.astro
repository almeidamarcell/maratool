---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Flow Rate Converter — L/min, GPM & CFM | maratool',
  description: 'Convert volumetric flow between L/min, GPM, CFM, m³/h, and L/s using exact NIST factors. Free flow rate converter that runs right in your browser.',
  canonical: 'https://maratool.com/volumetric-flow-rate-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Flow Rate Converter — L/min, GPM & CFM',
    url: 'https://maratool.com/volumetric-flow-rate-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert volumetric flow between L/min, GPM, CFM, m³/h, and L/s using exact NIST factors. Free flow rate converter that runs right in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Science', item: 'https://maratool.com/converter/science' },
      { '@type': 'ListItem', position: 4, name: 'Flow Rate Converter — L/min, GPM & CFM', item: 'https://maratool.com/volumetric-flow-rate-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert us gallon per minute to liter per minute?', acceptedAnswer: { '@type': 'Answer', text: '1 us gallon per minute = 3.78541 liter per minute. Choose "US gallon per minute (GPM)" as From and "Liter per minute (L/min)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many L/min is 1 GPM?', acceptedAnswer: { '@type': 'Answer', text: '1 US GPM = 3.785 L/min exactly (the US gallon definition). A typical shower head flows 1.8–2.5 GPM, or about 7–9.5 L/min.' } },
      { '@type': 'Question', name: 'Is CFM a mass or volume flow?', acceptedAnswer: { '@type': 'Answer', text: 'Volume. CFM is cubic feet per minute of air at actual conditions; SCFM references standard temperature and pressure so it can act as a mass proxy. This tool converts the volumetric value.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert us gallon per minute to liter per minute?', a: '1 us gallon per minute = 3.78541 liter per minute. Choose "US gallon per minute (GPM)" as From and "Liter per minute (L/min)" as To, type a value, and the result updates instantly.' },
  { q: 'How many L/min is 1 GPM?', a: '1 US GPM = 3.785 L/min exactly (the US gallon definition). A typical shower head flows 1.8–2.5 GPM, or about 7–9.5 L/min.' },
  { q: 'Is CFM a mass or volume flow?', a: 'Volume. CFM is cubic feet per minute of air at actual conditions; SCFM references standard temperature and pressure so it can act as a mass proxy. This tool converts the volumetric value.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'mass-flow-rate-converter', name: 'Mass Flow Rate' },
  { slug: 'volume-converter', name: 'Volume Converter' },
  { slug: 'kinematic-viscosity-converter', name: 'Kinematic Viscosity' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Science', href: '/converter/science' },
  { label: 'Flow Rate Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="volumetric-flow-rate-converter" name="Flow Rate Converter — L/min, GPM & CFM" description="Convert between liters per minute, US gallons per minute, cubic feet per minute, and m³/h." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="vfc-from-unit">From</label>
            <select id="vfc-from-unit" class="uc-select"></select>
            <input type="number" id="vfc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="vfc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="vfc-to-unit">To</label>
            <select id="vfc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="vfc-result">&mdash;</div>
            <button class="copy-btn" id="vfc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every rate is converted through m³/s (SI) using exact US gallon and cubic-foot definitions from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/volumetric-flow-rate-converter.js"></script>
