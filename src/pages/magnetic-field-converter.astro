---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Tesla to Gauss Converter — Magnetic Field | maratool',
  description: 'Convert magnetic flux density between tesla, gauss, millitesla, and gamma instantly — 1 T = 10,000 G exactly. Free converter in your browser.',
  canonical: 'https://maratool.com/magnetic-field-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Tesla to Gauss Converter — Magnetic Field',
    url: 'https://maratool.com/magnetic-field-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert magnetic flux density between tesla, gauss, millitesla, and gamma instantly — 1 T = 10,000 G exactly. Free converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Magnetism', item: 'https://maratool.com/converter/magnetism' },
      { '@type': 'ListItem', position: 4, name: 'Tesla to Gauss Converter — Magnetic Field', item: 'https://maratool.com/magnetic-field-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert tesla to gauss?', acceptedAnswer: { '@type': 'Answer', text: '1 tesla = 10000 gauss. Choose "Tesla (T)" as From and "Gauss (G)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many gauss is 1 tesla?', acceptedAnswer: { '@type': 'Answer', text: 'Exactly 10,000 G. A 3 T MRI scanner is 30,000 G; a fridge magnet is ~50 G (5 mT); Earth’s field is ~0.5 G (50 µT).' } },
      { '@type': 'Question', name: 'Is this the same as magnetic field strength (H)?', acceptedAnswer: { '@type': 'Answer', text: 'No. This converts flux density B (tesla, gauss). Field strength H uses A/m and oersted — see the Magnetic Field Strength Converter for that quantity.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert tesla to gauss?', a: '1 tesla = 10000 gauss. Choose "Tesla (T)" as From and "Gauss (G)" as To, type a value, and the result updates instantly.' },
  { q: 'How many gauss is 1 tesla?', a: 'Exactly 10,000 G. A 3 T MRI scanner is 30,000 G; a fridge magnet is ~50 G (5 mT); Earth’s field is ~0.5 G (50 µT).' },
  { q: 'Is this the same as magnetic field strength (H)?', a: 'No. This converts flux density B (tesla, gauss). Field strength H uses A/m and oersted — see the Magnetic Field Strength Converter for that quantity.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'magnetic-field-strength-converter', name: 'Field Strength' },
  { slug: 'magnetic-flux-converter', name: 'Magnetic Flux' },
  { slug: 'inductance-converter', name: 'Inductance Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Magnetism', href: '/converter/magnetism' },
  { label: 'Tesla to Gauss' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="magnetic-field-converter" name="Tesla to Gauss Converter — Magnetic Field" description="Convert magnetic flux density between tesla, millitesla, microtesla, gauss, and gamma." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="mgc-from-unit">From</label>
            <select id="mgc-from-unit" class="uc-select"></select>
            <input type="number" id="mgc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="mgc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="mgc-to-unit">To</label>
            <select id="mgc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="mgc-result">&mdash;</div>
            <button class="copy-btn" id="mgc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Flux density is converted through the tesla; the gauss and gamma are exact CGS relations per <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/magnetic-field-converter.js"></script>
