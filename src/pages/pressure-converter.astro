---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Pressure Converter — PSI, Bar, kPa & Atm | maratool',
  description: 'Convert psi to bar, kPa to psi, atmospheres, torr, and mmHg instantly with NIST conversion factors. Free pressure converter, runs in your browser.',
  canonical: 'https://maratool.com/pressure-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Pressure Converter — PSI, Bar, kPa & Atm',
    url: 'https://maratool.com/pressure-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert psi to bar, kPa to psi, atmospheres, torr, and mmHg instantly with NIST conversion factors. Free pressure converter, runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Pressure Converter — PSI, Bar, kPa & Atm', item: 'https://maratool.com/pressure-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert psi to bar?', acceptedAnswer: { '@type': 'Answer', text: '1 psi = 0.0689476 bar. Choose "PSI (lbf/in²)" as From and "Bar (bar)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many psi is 1 bar?', acceptedAnswer: { '@type': 'Answer', text: '1 bar = 14.503774 psi, and 1 psi = 0.0689476 bar. Tire pressures around 32 psi are roughly 2.2 bar.' } },
      { '@type': 'Question', name: 'What is the difference between torr and mmHg?', acceptedAnswer: { '@type': 'Answer', text: 'They differ by less than 0.000015%. The torr is defined as exactly 1/760 atm; the conventional mmHg is 133.322387415 Pa. For lab work they are interchangeable.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert psi to bar?', a: '1 psi = 0.0689476 bar. Choose "PSI (lbf/in²)" as From and "Bar (bar)" as To, type a value, and the result updates instantly.' },
  { q: 'How many psi is 1 bar?', a: '1 bar = 14.503774 psi, and 1 psi = 0.0689476 bar. Tire pressures around 32 psi are roughly 2.2 bar.' },
  { q: 'What is the difference between torr and mmHg?', a: 'They differ by less than 0.000015%. The torr is defined as exactly 1/760 atm; the conventional mmHg is 133.322387415 Pa. For lab work they are interchangeable.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'force-converter', name: 'Force Converter' },
  { slug: 'energy-converter', name: 'Energy Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Pressure Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="pressure-converter" name="Pressure Converter — PSI, Bar, kPa & Atm" description="Convert between psi, bar, kilopascals, atmospheres, torr, and mmHg using NIST SP 811 factors." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="prc-from-unit">From</label>
            <select id="prc-from-unit" class="uc-select"></select>
            <input type="number" id="prc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="prc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="prc-to-unit">To</label>
            <select id="prc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="prc-result">&mdash;</div>
            <button class="copy-btn" id="prc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the pascal (SI) with conversion factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/pressure-converter.js"></script>
