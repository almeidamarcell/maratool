---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Mass Flow Rate Converter — kg/s, kg/h, lb/h | maratool',
  description: 'Convert mass flow between kg/s, kg/h, tonnes per hour, lb/s, and lb/h instantly with exact NIST factors. Free flow rate converter in your browser.',
  canonical: 'https://maratool.com/mass-flow-rate-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Mass Flow Rate Converter — kg/s, kg/h & lb/h',
    url: 'https://maratool.com/mass-flow-rate-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert mass flow between kg/s, kg/h, tonnes per hour, lb/s, and lb/h instantly with exact NIST factors. Free flow rate converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Science', item: 'https://maratool.com/converter/science' },
      { '@type': 'ListItem', position: 4, name: 'Mass Flow Rate Converter — kg/s, kg/h & lb/h', item: 'https://maratool.com/mass-flow-rate-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert kilogram per hour to pound per hour?', acceptedAnswer: { '@type': 'Answer', text: '1 kilogram per hour = 2.20462 pound per hour. Choose "Kilogram per hour (kg/h)" as From and "Pound per hour (lb/h)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How do I convert kg/h to lb/h?', acceptedAnswer: { '@type': 'Answer', text: 'Multiply by 2.20462: 100 kg/h = 220.46 lb/h. The factor is the exact pound definition, 1 lb = 0.45359237 kg.' } },
      { '@type': 'Question', name: 'How do I get mass flow from volumetric flow?', acceptedAnswer: { '@type': 'Answer', text: 'Multiply volumetric flow by density: ṁ = ρ × Q. Water at 10 L/min is about 10 kg/min; air at the same flow is roughly 800× less mass.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert kilogram per hour to pound per hour?', a: '1 kilogram per hour = 2.20462 pound per hour. Choose "Kilogram per hour (kg/h)" as From and "Pound per hour (lb/h)" as To, type a value, and the result updates instantly.' },
  { q: 'How do I convert kg/h to lb/h?', a: 'Multiply by 2.20462: 100 kg/h = 220.46 lb/h. The factor is the exact pound definition, 1 lb = 0.45359237 kg.' },
  { q: 'How do I get mass flow from volumetric flow?', a: 'Multiply volumetric flow by density: ṁ = ρ × Q. Water at 10 L/min is about 10 kg/min; air at the same flow is roughly 800× less mass.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'volumetric-flow-rate-converter', name: 'Flow Rate Converter' },
  { slug: 'density-converter', name: 'Density Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Science', href: '/converter/science' },
  { label: 'Mass Flow Rate' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="mass-flow-rate-converter" name="Mass Flow Rate Converter — kg/s, kg/h & lb/h" description="Convert between kilograms per second, kilograms per hour, tonnes per hour, and pounds per hour." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="mfc-from-unit">From</label>
            <select id="mfc-from-unit" class="uc-select"></select>
            <input type="number" id="mfc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="mfc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="mfc-to-unit">To</label>
            <select id="mfc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="mfc-result">&mdash;</div>
            <button class="copy-btn" id="mfc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every rate is converted through kg/s (SI); time factors are exact fractions and the pound uses the exact NIST definition in <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/mass-flow-rate-converter.js"></script>
