---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Sprite Sheet Cutter Online | maratool',
  description: 'Slice a sprite sheet into individual PNG frames online. Set rows, columns, or tile size and download every frame — free, no upload to any server.',
  canonical: 'https://maratool.com/sprite-cutter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Sprite Sheet Cutter Online',
    url: 'https://maratool.com/sprite-cutter',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Slice a sprite sheet into individual PNG frames online. Set rows, columns, or tile size and download every frame — free, no upload to any server.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How many tiles do I get?', acceptedAnswer: { '@type': 'Answer', text: 'Rows multiplied by columns, all of them. Set four by four and you get sixteen separate PNGs, not a sample.' } },
      { '@type': 'Question', name: 'What if the grid is uneven?', acceptedAnswer: { '@type': 'Answer', text: 'The sheet is divided into equal cells, so the rows and columns you enter have to match how the sheet was laid out. If tiles come out misaligned, the grid numbers are wrong.' } },
      { '@type': 'Question', name: 'Do the tiles keep transparency?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Each tile is written as a PNG with the alpha channel intact, which matters for game sprites drawn over a background.' } },
      { '@type': 'Question', name: 'Is there a limit on sheet size?', acceptedAnswer: { '@type': 'Answer', text: 'The practical limit is browser memory. Very large sheets cut more slowly because each tile is encoded separately, and progress is shown while that runs.' } },
    ],
  },
}

const howTo = [
  'Drop in the sprite sheet you want cut apart.',
  'Set the number of rows and columns to match the grid in the sheet.',
  'Every tile is cut and previewed. Download them one by one, or take all of them as a ZIP.',
]

const faq = [
  { q: 'How many tiles do I get?', a: 'Rows multiplied by columns, all of them. Set four by four and you get sixteen separate PNGs, not a sample.' },
  { q: 'What if the grid is uneven?', a: 'The sheet is divided into equal cells, so the rows and columns you enter have to match how the sheet was laid out. If tiles come out misaligned, the grid numbers are wrong.' },
  { q: 'Do the tiles keep transparency?', a: 'Yes. Each tile is written as a PNG with the alpha channel intact, which matters for game sprites drawn over a background.' },
  { q: 'Is there a limit on sheet size?', a: 'The practical limit is browser memory. Very large sheets cut more slowly because each tile is encoded separately, and progress is shown while that runs.' },
]

const relatedTools = [
  { slug: 'gif-to-sprite', name: 'GIF to Sprite Sheet' },
  { slug: 'image-splitter', name: 'Image Splitter' },
  { slug: 'gif-to-frames', name: 'GIF to Frames' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image', href: '/image' },
  { label: 'Animated', href: '/image/animated' },
  { label: 'Sprite Sheet Cutter Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="sprite-cutter" name="Sprite Sheet Cutter Online" description="Cut a sprite sheet into its individual tiles on a grid you set. Every tile is exported, downloadable one at a time or as a single ZIP." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="sprite-cutter">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="sprite-cutter"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/sprite-cutter.js"></script>
