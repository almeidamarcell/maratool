---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Bulk WebP to PNG Converter | maratool',
  description: 'Convert multiple WebP images to PNG at once, right in your browser. Drop a batch of files and download all converted PNGs. Free, no upload to servers.',
  canonical: 'https://maratool.com/bulk-webp-to-png',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Bulk WebP to PNG Converter',
    url: 'https://maratool.com/bulk-webp-to-png',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert multiple WebP images to PNG at once, right in your browser. Drop a batch of files and download all converted PNGs. Free, no upload to servers.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Can I convert a batch of WebP files in one go?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Select or drop them all and each one is converted, with an individual download and a download-all for the set.' } },
      { '@type': 'Question', name: 'Does transparency survive?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. WebP and PNG both support an alpha channel, so transparent areas come through intact.' } },
      { '@type': 'Question', name: 'What about animated WebP?', acceptedAnswer: { '@type': 'Answer', text: 'Only the first frame is converted, because PNG holds a single image. For the full animation use the WebP to GIF converter instead.' } },
      { '@type': 'Question', name: 'Are my images uploaded anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Decoding and encoding both happen locally in your browser.' } },
    ],
  },
}

const howTo = [
  'Drop in as many WebP files as you like — the whole batch loads at once.',
  'Click Convert to PNG. Every file in the batch is re-encoded, not just the first.',
  'Download each PNG on its own, or take the whole set with Download all.',
]

const faq = [
  { q: 'Can I convert a batch of WebP files in one go?', a: 'Yes. Select or drop them all and each one is converted, with an individual download and a download-all for the set.' },
  { q: 'Does transparency survive?', a: 'Yes. WebP and PNG both support an alpha channel, so transparent areas come through intact.' },
  { q: 'What about animated WebP?', a: 'Only the first frame is converted, because PNG holds a single image. For the full animation use the WebP to GIF converter instead.' },
  { q: 'Are my images uploaded anywhere?', a: 'No. Decoding and encoding both happen locally in your browser.' },
]

const relatedTools = [
  { slug: 'webp-maker', name: 'WebP Maker' },
  { slug: 'webp-to-gif', name: 'WebP to GIF Converter' },
  { slug: 'image-converter', name: 'Image Converter' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Format', href: '/converter/format' },
  { label: 'Bulk WebP to PNG Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="bulk-webp-to-png" name="Bulk WebP to PNG Converter" description="Convert a whole batch of WebP files to PNG at once. Every file is re-encoded in your browser and downloads individually or as a set." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="image">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="bulk-webp-to-png"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/bulk-webp-to-png.js"></script>
