---
import Base from '../../layouts/Base.astro'
import Layout from '../../components/Layout.astro'
import BlogPostShell from '../../components/BlogPostShell.astro'
import BlogToolEmbed from '../../components/BlogToolEmbed.astro'

const slug = 'pressure-converter'
const seo = {
  title: 'Pressure converter — psi, bar, kPa, atm | maratool',
  description: 'Convert psi, bar, kPa, atm, torr, and mmHg using NIST factors. Free browser pressure converter for tires, weather, and lab work.',
  canonical: `https://maratool.com/blog/${slug}`,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'How to convert PSI to bar, kPa, and atm',
    image: 'https://maratool.com/og/converter.svg',
    datePublished: '2026-07-25',
    dateModified: '2026-07-25',
    author: { '@type': 'Person', name: 'Marcell Almeida', url: 'https://marcell.com.br' },
    publisher: {
      '@type': 'Organization',
      name: 'maratool',
      url: 'https://maratool.com',
      logo: { '@type': 'ImageObject', url: 'https://maratool.com/favicon.svg' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://maratool.com/blog/${slug}` },
    url: `https://maratool.com/blog/${slug}`,
    description: 'Convert psi, bar, kPa, atm, torr, and mmHg using NIST factors. Free browser pressure converter for tires, weather, and lab work.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://maratool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'How to convert PSI to bar, kPa, and atm', item: `https://maratool.com/blog/${slug}` },
    ],
  },
}
---
<Base {...seo}>
  <Layout>
    <BlogPostShell
      title="How to convert PSI to bar, kPa, and atm"
      lead="Type a pressure in any unit — read psi, bar, kPa, atm, torr, or mmHg instantly."
      date="July 25, 2026"
      dateIso="2026-07-25"
    >
      <p>Tire gauges read psi, European specs read bar, weather reports read hPa, and vacuum systems read torr. The <a href="/pressure-converter">Pressure Converter</a> converts between all of them through the SI pascal.</p>

      <BlogToolEmbed slug="pressure-converter" title="Try it — convert pressure units" height={440} />

      <h2>How it works</h2>
      <ol>
        <li><strong>Pick units</strong> — "PSI (lbf/in²)" to "Bar (bar)", or any other pair.</li>
        <li><strong>Type a value</strong> — the result updates as you type, with swap and copy.</li>
        <li><strong>Copy</strong> — one click, with "Copied!" feedback.</li>
      </ol>

      <h2>Pressure conversion factors</h2>
      <p>Every unit converts through the pascal (the base unit). To convert A → B, multiply by A's factor and divide by B's:</p>
      <table>
        <thead><tr><th>Unit</th><th>= this many pascals</th></tr></thead>
        <tbody>
        <tr><td>Pascal (Pa)</td><td>1</td></tr>
        <tr><td>Kilopascal (kPa)</td><td>1,000</td></tr>
        <tr><td>Megapascal (MPa)</td><td>1,000,000</td></tr>
        <tr><td>Bar (bar)</td><td>100,000</td></tr>
        <tr><td>Millibar (mbar)</td><td>100</td></tr>
        <tr><td>PSI (lbf/in²)</td><td>6,894.757293168</td></tr>
        <tr><td>Atmosphere (atm)</td><td>101,325</td></tr>
        <tr><td>Torr (Torr)</td><td>133.322368421</td></tr>
        <tr><td>Millimeter of mercury (mmHg)</td><td>133.322387415</td></tr>
        <tr><td>Inch of mercury (inHg)</td><td>3,386.389</td></tr>
        <tr><td>Kilogram-force per cm² (kgf/cm²)</td><td>98,066.5</td></tr>
        </tbody>
      </table>

      <h2>When you need it</h2>
      <p>Everyday anchors: 1 bar ≈ 14.5 psi ≈ 100 kPa ≈ 0.987 atm. Car tires run around 2.0–2.5 bar (29–36 psi); standard atmosphere is exactly 101,325 Pa. Medical blood-pressure readings stay in mmHg by convention.</p>

      <h2>Sources & methodology</h2>
      <p>Conversion factors follow <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>; exact-by-definition factors are marked in the tool itself. All math runs client-side in your browser — nothing is uploaded.</p>

      <hr class="blog-divider" />
      <p class="blog-footer-note">The <a href="/pressure-converter">Pressure Converter</a> tool is free, runs locally, and never sends your data to a server. More <a href="/converter">converter tools</a> at <a href="/">maratool.com</a>.</p>
    </BlogPostShell>
  </Layout>
</Base>
