---
import Base from '../../layouts/Base.astro'
import Layout from '../../components/Layout.astro'
import BlogPostShell from '../../components/BlogPostShell.astro'
import BlogToolEmbed from '../../components/BlogToolEmbed.astro'

const slug = 'torque-converter'
const seo = {
  title: 'Torque converter — Nm to ft-lb, in-lb, kgf·m | maratool',
  description: 'Convert newton-meters to foot-pounds, inch-pounds, and kgf·m with exact NIST factors. Free browser torque converter.',
  canonical: `https://maratool.com/blog/${slug}`,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'How to convert Nm to ft-lb for torque specs',
    image: 'https://maratool.com/og/converter.svg',
    datePublished: '2026-07-25',
    dateModified: '2026-07-25',
    author: { '@type': 'Person', name: 'Marcell Almeida', url: 'https://marcell.com.br' },
    publisher: {
      '@type': 'Organization',
      name: 'maratool',
      url: 'https://maratool.com',
      logo: { '@type': 'ImageObject', url: 'https://maratool.com/favicon.svg' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://maratool.com/blog/${slug}` },
    url: `https://maratool.com/blog/${slug}`,
    description: 'Convert newton-meters to foot-pounds, inch-pounds, and kgf·m with exact NIST factors. Free browser torque converter.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://maratool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'How to convert Nm to ft-lb for torque specs', item: `https://maratool.com/blog/${slug}` },
    ],
  },
}
---
<Base {...seo}>
  <Layout>
    <BlogPostShell
      title="How to convert Nm to ft-lb for torque specs"
      lead="Type a torque value — read N·m, ft·lb, in·lb, or kgf·m instantly."
      date="July 25, 2026"
      dateIso="2026-07-25"
    >
      <p>Torque wrenches sold in the US read ft·lb, European service manuals spec N·m, and small fasteners use in·lb. The <a href="/torque-converter">Torque Converter</a> converts between all of them exactly.</p>

      <BlogToolEmbed slug="torque-converter" title="Try it — convert torque units" height={440} />

      <h2>How it works</h2>
      <ol>
        <li><strong>Pick units</strong> — "Newton-meter (N·m)" to "Foot-pound (ft·lbf)", or any other pair.</li>
        <li><strong>Type a value</strong> — the result updates as you type, with swap and copy.</li>
        <li><strong>Copy</strong> — one click, with "Copied!" feedback.</li>
      </ol>

      <h2>Torque conversion factors</h2>
      <p>Every unit converts through the newton-meter (the base unit). To convert A → B, multiply by A's factor and divide by B's:</p>
      <table>
        <thead><tr><th>Unit</th><th>= this many newton-meters</th></tr></thead>
        <tbody>
        <tr><td>Newton-meter (N·m)</td><td>1</td></tr>
        <tr><td>Newton-centimeter (N·cm)</td><td>0.01</td></tr>
        <tr><td>Foot-pound (ft·lbf)</td><td>1.355817948331</td></tr>
        <tr><td>Inch-pound (in·lbf)</td><td>0.112984829028</td></tr>
        <tr><td>Kilogram-force meter (kgf·m)</td><td>9.80665</td></tr>
        <tr><td>Kilogram-force centimeter (kgf·cm)</td><td>0.0980665</td></tr>
        </tbody>
      </table>

      <h2>When you need it</h2>
      <p>The one to memorize: 1 ft·lbf = 1.3558 N·m, so a 100 N·m spec is about 74 ft·lb. Small-electronics screws are often specced in in·lb — divide ft·lb by 12, or just convert directly above.</p>

      <h2>Sources & methodology</h2>
      <p>Conversion factors follow <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>; exact-by-definition factors are marked in the tool itself. All math runs client-side in your browser — nothing is uploaded.</p>

      <hr class="blog-divider" />
      <p class="blog-footer-note">The <a href="/torque-converter">Torque Converter</a> tool is free, runs locally, and never sends your data to a server. More <a href="/converter">converter tools</a> at <a href="/">maratool.com</a>.</p>
    </BlogPostShell>
  </Layout>
</Base>
