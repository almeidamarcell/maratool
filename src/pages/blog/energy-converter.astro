---
import Base from '../../layouts/Base.astro'
import Layout from '../../components/Layout.astro'
import BlogPostShell from '../../components/BlogPostShell.astro'
import BlogToolEmbed from '../../components/BlogToolEmbed.astro'

const slug = 'energy-converter'
const seo = {
  title: 'Energy converter — joules, calories, kWh, BTU | maratool',
  description: 'Convert joules, calories, kWh, BTU, and electronvolts with exact NIST factors. Free browser energy converter.',
  canonical: `https://maratool.com/blog/${slug}`,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'How to convert calories, joules, kWh, and BTU',
    image: 'https://maratool.com/og/converter.svg',
    datePublished: '2026-07-25',
    dateModified: '2026-07-25',
    author: { '@type': 'Person', name: 'Marcell Almeida', url: 'https://marcell.com.br' },
    publisher: {
      '@type': 'Organization',
      name: 'maratool',
      url: 'https://maratool.com',
      logo: { '@type': 'ImageObject', url: 'https://maratool.com/favicon.svg' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://maratool.com/blog/${slug}` },
    url: `https://maratool.com/blog/${slug}`,
    description: 'Convert joules, calories, kWh, BTU, and electronvolts with exact NIST factors. Free browser energy converter.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://maratool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'How to convert calories, joules, kWh, and BTU', item: `https://maratool.com/blog/${slug}` },
    ],
  },
}
---
<Base {...seo}>
  <Layout>
    <BlogPostShell
      title="How to convert calories, joules, kWh, and BTU"
      lead="Type an energy value in any unit — read joules, calories, kWh, BTU, or eV instantly."
      date="July 25, 2026"
      dateIso="2026-07-25"
    >
      <p>Nutrition labels use kcal, utility bills use kWh, furnaces use BTU, and physics uses joules and electronvolts. The <a href="/energy-converter/">Energy Converter</a> bridges all of them with exact NIST SP 811 factors.</p>

      <BlogToolEmbed slug="energy-converter" title="Try it — convert energy units" height={440} />

      <h2>How it works</h2>
      <ol>
        <li><strong>Pick units</strong> — "Kilocalorie / food Calorie (kcal)" to "Kilojoule (kJ)", or any other pair.</li>
        <li><strong>Type a value</strong> — the result updates as you type, with swap and copy.</li>
        <li><strong>Copy</strong> — one click, with "Copied!" feedback.</li>
      </ol>

      <h2>Energy conversion factors</h2>
      <p>Every unit converts through the joule (the base unit). To convert A → B, multiply by A's factor and divide by B's:</p>
      <table>
        <thead><tr><th>Unit</th><th>= this many joules</th></tr></thead>
        <tbody>
        <tr><td>Joule (J)</td><td>1</td></tr>
        <tr><td>Kilojoule (kJ)</td><td>1,000</td></tr>
        <tr><td>Megajoule (MJ)</td><td>1,000,000</td></tr>
        <tr><td>Watt-hour (Wh)</td><td>3,600</td></tr>
        <tr><td>Kilowatt-hour (kWh)</td><td>3,600,000</td></tr>
        <tr><td>Calorie, thermochemical (cal)</td><td>4.184</td></tr>
        <tr><td>Kilocalorie / food Calorie (kcal)</td><td>4,184</td></tr>
        <tr><td>BTU, International Table (BTU)</td><td>1,055.05585262</td></tr>
        <tr><td>Foot-pound (ft·lbf)</td><td>1.355817948331</td></tr>
        <tr><td>Electronvolt (eV)</td><td>1.6022 × 10^-19</td></tr>
        </tbody>
      </table>

      <h2>When you need it</h2>
      <p>Useful anchors: a 2,000 kcal daily diet is 8.37 MJ or 2.32 kWh — about the energy in 7,900 BTU. The thermochemical calorie (4.184 J exactly) is used here; the slightly different International Table calorie (4.1868 J) appears in some older steam tables.</p>

      <h2>Sources & methodology</h2>
      <p>Conversion factors follow <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>; exact-by-definition factors are marked in the tool itself. All math runs client-side in your browser — nothing is uploaded.</p>

      <h2>More conversion guides</h2>
      <ul>
        <li><a href="/blog/power-converter/">How to convert HP to kW (and why metric HP differs)</a></li>
        <li><a href="/blog/pressure-converter/">How to convert PSI to bar, kPa, and atm</a></li>
        <li><a href="/blog/area-converter/">How to convert square feet to square meters (and any area unit)</a></li>
      </ul>
      <p>Or browse everything at once in the <a href="/blog/new-unit-converters/">new unit &amp; sizing converters roundup</a>.</p>

      <hr class="blog-divider" />
      <p class="blog-footer-note">The <a href="/energy-converter/">Energy Converter</a> tool is free, runs locally, and never sends your data to a server. More <a href="/converter/">converter tools</a> at <a href="/">maratool.com</a>.</p>
    </BlogPostShell>
  </Layout>
</Base>
