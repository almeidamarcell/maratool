---
import Base from '../../layouts/Base.astro'
import Layout from '../../components/Layout.astro'
import BlogPostShell from '../../components/BlogPostShell.astro'
import BlogToolEmbed from '../../components/BlogToolEmbed.astro'

const slug = 'electrical-resistance-converter'
const seo = {
  title: 'Resistance converter — ohms, kΩ, MΩ | maratool',
  description: 'Convert ohms, kiloohms, megaohms, and milliohms instantly. Free browser electrical resistance converter.',
  canonical: `https://maratool.com/blog/${slug}`,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'How to convert ohms, kΩ, and MΩ resistor values',
    image: 'https://maratool.com/og/converter.svg',
    datePublished: '2026-07-25',
    dateModified: '2026-07-25',
    author: { '@type': 'Person', name: 'Marcell Almeida', url: 'https://marcell.com.br' },
    publisher: {
      '@type': 'Organization',
      name: 'maratool',
      url: 'https://maratool.com',
      logo: { '@type': 'ImageObject', url: 'https://maratool.com/favicon.svg' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://maratool.com/blog/${slug}` },
    url: `https://maratool.com/blog/${slug}`,
    description: 'Convert ohms, kiloohms, megaohms, and milliohms instantly. Free browser electrical resistance converter.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://maratool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'How to convert ohms, kΩ, and MΩ resistor values', item: `https://maratool.com/blog/${slug}` },
    ],
  },
}
---
<Base {...seo}>
  <Layout>
    <BlogPostShell
      title="How to convert ohms, kΩ, and MΩ resistor values"
      lead="Type a resistance — read mΩ, Ω, kΩ, MΩ, or GΩ instantly."
      date="July 25, 2026"
      dateIso="2026-07-25"
    >
      <p>Datasheets write 4K7, multimeters read 4.698 kΩ, and simulations want plain ohms. The <a href="/electrical-resistance-converter/">Resistance Converter</a> shifts prefixes exactly.</p>

      <BlogToolEmbed slug="electrical-resistance-converter" title="Try it — convert electrical resistance units" height={440} />

      <h2>How it works</h2>
      <ol>
        <li><strong>Pick units</strong> — "Kiloohm (kΩ)" to "Ohm (Ω)", or any other pair.</li>
        <li><strong>Type a value</strong> — the result updates as you type, with swap and copy.</li>
        <li><strong>Copy</strong> — one click, with "Copied!" feedback.</li>
      </ol>

      <h2>Electrical resistance conversion factors</h2>
      <p>Every unit converts through the ohm (the base unit). To convert A → B, multiply by A's factor and divide by B's:</p>
      <table>
        <thead><tr><th>Unit</th><th>= this many ohms</th></tr></thead>
        <tbody>
        <tr><td>Gigaohm (GΩ)</td><td>1.0000 × 10^9</td></tr>
        <tr><td>Megaohm (MΩ)</td><td>1,000,000</td></tr>
        <tr><td>Kiloohm (kΩ)</td><td>1,000</td></tr>
        <tr><td>Ohm (Ω)</td><td>1</td></tr>
        <tr><td>Milliohm (mΩ)</td><td>0.001</td></tr>
        <tr><td>Microohm (µΩ)</td><td>1.0000 × 10^-6</td></tr>
        <tr><td>Abohm (abΩ)</td><td>1.0000 × 10^-9</td></tr>
        <tr><td>Statohm (statΩ)</td><td>8.9876 × 10^11</td></tr>
        </tbody>
      </table>

      <h2>When you need it</h2>
      <p>Common ranges: pull-up resistors 1–100 kΩ, current shunts 1–100 mΩ, insulation resistance above 1 MΩ (megger tests read GΩ on good cable). Each prefix step is ×1,000.</p>

      <h2>Sources & methodology</h2>
      <p>Conversion factors follow <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>; exact-by-definition factors are marked in the tool itself. All math runs client-side in your browser — nothing is uploaded.</p>

      <h2>More conversion guides</h2>
      <ul>
        <li><a href="/blog/electrical-conductance-converter/">How to convert siemens, mho, and microsiemens</a></li>
        <li><a href="/blog/electric-current-converter/">How to convert milliamps to amps (and other current units)</a></li>
        <li><a href="/blog/electric-potential-converter/">How to convert volts, millivolts, and kilovolts</a></li>
      </ul>
      <p>Or browse everything at once in the <a href="/blog/new-unit-converters/">new unit &amp; sizing converters roundup</a>.</p>

      <hr class="blog-divider" />
      <p class="blog-footer-note">The <a href="/electrical-resistance-converter/">Resistance Converter</a> tool is free, runs locally, and never sends your data to a server. More <a href="/converter/">converter tools</a> at <a href="/">maratool.com</a>.</p>
    </BlogPostShell>
  </Layout>
</Base>
