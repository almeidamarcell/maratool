---
import Base from '../../layouts/Base.astro'
import Layout from '../../components/Layout.astro'
import BlogPostShell from '../../components/BlogPostShell.astro'
import BlogToolEmbed from '../../components/BlogToolEmbed.astro'

const slug = 'molar-mass-converter'
const seo = {
  title: 'Molar mass converter — g/mol, kg/mol, daltons | maratool',
  description: 'Convert g/mol, kg/mol, kg/kmol, and daltons instantly. Free browser molar mass unit converter.',
  canonical: `https://maratool.com/blog/${slug}`,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'How to convert molar mass units (g/mol, kg/mol, Da)',
    image: 'https://maratool.com/og/converter.svg',
    datePublished: '2026-07-25',
    dateModified: '2026-07-25',
    author: { '@type': 'Person', name: 'Marcell Almeida', url: 'https://marcell.com.br' },
    publisher: {
      '@type': 'Organization',
      name: 'maratool',
      url: 'https://maratool.com',
      logo: { '@type': 'ImageObject', url: 'https://maratool.com/favicon.svg' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://maratool.com/blog/${slug}` },
    url: `https://maratool.com/blog/${slug}`,
    description: 'Convert g/mol, kg/mol, kg/kmol, and daltons instantly. Free browser molar mass unit converter.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://maratool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'How to convert molar mass units (g/mol, kg/mol, Da)', item: `https://maratool.com/blog/${slug}` },
    ],
  },
}
---
<Base {...seo}>
  <Layout>
    <BlogPostShell
      title="How to convert molar mass units (g/mol, kg/mol, Da)"
      lead="Type a molar mass — read g/mol, kg/mol, kg/kmol, Da, or lb/lb-mol instantly."
      date="July 25, 2026"
      dateIso="2026-07-25"
    >
      <p>SI process calculations want kg/mol, bench chemistry uses g/mol, and proteomics reports daltons. The <a href="/molar-mass-converter">Molar Mass Converter</a> shifts between them without dropped decimals.</p>

      <BlogToolEmbed slug="molar-mass-converter" title="Try it — convert molar mass units" height={440} />

      <h2>How it works</h2>
      <ol>
        <li><strong>Pick units</strong> — "Gram per mole (g/mol)" to "Kilogram per mole (kg/mol)", or any other pair.</li>
        <li><strong>Type a value</strong> — the result updates as you type, with swap and copy.</li>
        <li><strong>Copy</strong> — one click, with "Copied!" feedback.</li>
      </ol>

      <h2>Molar mass conversion factors</h2>
      <p>Every unit converts through the gram per mole (the base unit). To convert A → B, multiply by A's factor and divide by B's:</p>
      <table>
        <thead><tr><th>Unit</th><th>= this many gram per moles</th></tr></thead>
        <tbody>
        <tr><td>Kilogram per mole (kg/mol)</td><td>1,000</td></tr>
        <tr><td>Gram per mole (g/mol)</td><td>1</td></tr>
        <tr><td>Milligram per mole (mg/mol)</td><td>0.001</td></tr>
        <tr><td>Kilogram per kilomole (kg/kmol)</td><td>1</td></tr>
        <tr><td>Pound per pound-mole (lb/lb-mol)</td><td>1</td></tr>
        <tr><td>Dalton (Da)</td><td>1</td></tr>
        </tbody>
      </table>

      <h2>When you need it</h2>
      <p>The useful identity: g/mol = kg/kmol = lb/lb-mol = Da, so most "conversions" are really sanity checks — only kg/mol moves the decimal three places. A 66.5 kDa protein is 66,500 g/mol or 0.0665 kg/mol.</p>

      <h2>Sources & methodology</h2>
      <p>Conversion factors follow <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener" target="_blank">BIPM SI Brochure</a>; exact-by-definition factors are marked in the tool itself. All math runs client-side in your browser — nothing is uploaded.</p>

      <hr class="blog-divider" />
      <p class="blog-footer-note">The <a href="/molar-mass-converter">Molar Mass Converter</a> tool is free, runs locally, and never sends your data to a server. More <a href="/converter">converter tools</a> at <a href="/">maratool.com</a>.</p>
    </BlogPostShell>
  </Layout>
</Base>
