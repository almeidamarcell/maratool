---
import Base from '../../layouts/Base.astro'
import Layout from '../../components/Layout.astro'
import BlogPostShell from '../../components/BlogPostShell.astro'
import BlogToolEmbed from '../../components/BlogToolEmbed.astro'

const slug = 'mass-flow-rate-converter'
const seo = {
  title: 'Mass flow rate converter — kg/s, kg/h, lb/h | maratool',
  description: 'Convert kg/s, kg/h, tonnes per hour, and lb/h with exact NIST factors. Free browser mass flow converter.',
  canonical: `https://maratool.com/blog/${slug}`,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'How to convert mass flow rates (kg/h, lb/h, t/h)',
    image: 'https://maratool.com/og/converter.svg',
    datePublished: '2026-07-25',
    dateModified: '2026-07-25',
    author: { '@type': 'Person', name: 'Marcell Almeida', url: 'https://marcell.com.br' },
    publisher: {
      '@type': 'Organization',
      name: 'maratool',
      url: 'https://maratool.com',
      logo: { '@type': 'ImageObject', url: 'https://maratool.com/favicon.svg' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://maratool.com/blog/${slug}` },
    url: `https://maratool.com/blog/${slug}`,
    description: 'Convert kg/s, kg/h, tonnes per hour, and lb/h with exact NIST factors. Free browser mass flow converter.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://maratool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'How to convert mass flow rates (kg/h, lb/h, t/h)', item: `https://maratool.com/blog/${slug}` },
    ],
  },
}
---
<Base {...seo}>
  <Layout>
    <BlogPostShell
      title="How to convert mass flow rates (kg/h, lb/h, t/h)"
      lead="Type a mass flow — read kg/s, kg/h, t/h, lb/s, or lb/h instantly."
      date="July 25, 2026"
      dateIso="2026-07-25"
    >
      <p>Process datasheets mix kg/h, t/h, and lb/h across vendors. The <a href="/mass-flow-rate-converter">Mass Flow Rate Converter</a> normalizes them through kg/s with exact time and pound factors.</p>

      <BlogToolEmbed slug="mass-flow-rate-converter" title="Try it — convert mass flow rate units" height={440} />

      <h2>How it works</h2>
      <ol>
        <li><strong>Pick units</strong> — "Kilogram per hour (kg/h)" to "Pound per hour (lb/h)", or any other pair.</li>
        <li><strong>Type a value</strong> — the result updates as you type, with swap and copy.</li>
        <li><strong>Copy</strong> — one click, with "Copied!" feedback.</li>
      </ol>

      <h2>Mass flow rate conversion factors</h2>
      <p>Every unit converts through the kilogram per second (the base unit). To convert A → B, multiply by A's factor and divide by B's:</p>
      <table>
        <thead><tr><th>Unit</th><th>= this many kilogram per seconds</th></tr></thead>
        <tbody>
        <tr><td>Kilogram per second (kg/s)</td><td>1</td></tr>
        <tr><td>Kilogram per minute (kg/min)</td><td>0.016666666667</td></tr>
        <tr><td>Kilogram per hour (kg/h)</td><td>0.000277777778</td></tr>
        <tr><td>Gram per second (g/s)</td><td>0.001</td></tr>
        <tr><td>Tonne per hour (t/h)</td><td>0.277777777778</td></tr>
        <tr><td>Pound per second (lb/s)</td><td>0.45359237</td></tr>
        <tr><td>Pound per minute (lb/min)</td><td>0.007559872833</td></tr>
        <tr><td>Pound per hour (lb/h)</td><td>0.000125997881</td></tr>
        </tbody>
      </table>

      <h2>When you need it</h2>
      <p>Steam boilers are often rated in lb/h in the US and t/h elsewhere — 10,000 lb/h is 4.536 t/h. For gas systems specced volumetrically (SCFM, Nm³/h), convert to mass with density first, or use the <a href="/volumetric-flow-rate-converter">Flow Rate Converter</a>.</p>

      <h2>Sources & methodology</h2>
      <p>Conversion factors follow <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>; exact-by-definition factors are marked in the tool itself. All math runs client-side in your browser — nothing is uploaded.</p>

      <hr class="blog-divider" />
      <p class="blog-footer-note">The <a href="/mass-flow-rate-converter">Mass Flow Rate</a> tool is free, runs locally, and never sends your data to a server. More <a href="/converter">converter tools</a> at <a href="/">maratool.com</a>.</p>
    </BlogPostShell>
  </Layout>
</Base>
