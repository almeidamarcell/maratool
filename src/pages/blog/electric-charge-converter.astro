---
import Base from '../../layouts/Base.astro'
import Layout from '../../components/Layout.astro'
import BlogPostShell from '../../components/BlogPostShell.astro'
import BlogToolEmbed from '../../components/BlogToolEmbed.astro'

const slug = 'electric-charge-converter'
const seo = {
  title: 'Electric charge converter — coulombs, Ah, mAh | maratool',
  description: 'Convert coulombs, ampere-hours, and mAh instantly. Free browser electric charge converter for battery math.',
  canonical: `https://maratool.com/blog/${slug}`,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'How to convert mAh to coulombs (battery charge units)',
    image: 'https://maratool.com/og/converter.svg',
    datePublished: '2026-07-25',
    dateModified: '2026-07-25',
    author: { '@type': 'Person', name: 'Marcell Almeida', url: 'https://marcell.com.br' },
    publisher: {
      '@type': 'Organization',
      name: 'maratool',
      url: 'https://maratool.com',
      logo: { '@type': 'ImageObject', url: 'https://maratool.com/favicon.svg' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://maratool.com/blog/${slug}` },
    url: `https://maratool.com/blog/${slug}`,
    description: 'Convert coulombs, ampere-hours, and mAh instantly. Free browser electric charge converter for battery math.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://maratool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'How to convert mAh to coulombs (battery charge units)', item: `https://maratool.com/blog/${slug}` },
    ],
  },
}
---
<Base {...seo}>
  <Layout>
    <BlogPostShell
      title="How to convert mAh to coulombs (battery charge units)"
      lead="Type a charge — read coulombs, Ah, mAh, or faradays instantly."
      date="July 25, 2026"
      dateIso="2026-07-25"
    >
      <p>Battery specs use mAh, physics uses coulombs, and electrochemistry uses faradays. The <a href="/electric-charge-converter">Electric Charge Converter</a> ties them together: 1 mAh = 3.6 C exactly.</p>

      <BlogToolEmbed slug="electric-charge-converter" title="Try it — convert electric charge units" height={440} />

      <h2>How it works</h2>
      <ol>
        <li><strong>Pick units</strong> — "Milliampere-hour (mAh)" to "Coulomb (C)", or any other pair.</li>
        <li><strong>Type a value</strong> — the result updates as you type, with swap and copy.</li>
        <li><strong>Copy</strong> — one click, with "Copied!" feedback.</li>
      </ol>

      <h2>Electric charge conversion factors</h2>
      <p>Every unit converts through the coulomb (the base unit). To convert A → B, multiply by A's factor and divide by B's:</p>
      <table>
        <thead><tr><th>Unit</th><th>= this many coulombs</th></tr></thead>
        <tbody>
        <tr><td>Kilocoulomb (kC)</td><td>1,000</td></tr>
        <tr><td>Coulomb (C)</td><td>1</td></tr>
        <tr><td>Millicoulomb (mC)</td><td>0.001</td></tr>
        <tr><td>Microcoulomb (µC)</td><td>1.0000 × 10^-6</td></tr>
        <tr><td>Nanocoulomb (nC)</td><td>1.0000 × 10^-9</td></tr>
        <tr><td>Ampere-hour (Ah)</td><td>3,600</td></tr>
        <tr><td>Milliampere-hour (mAh)</td><td>3.6</td></tr>
        <tr><td>Faraday (F)</td><td>96,485.33212</td></tr>
        <tr><td>Abcoulomb (abC)</td><td>10</td></tr>
        <tr><td>Statcoulomb (statC)</td><td>3.3356 × 10^-10</td></tr>
        </tbody>
      </table>

      <h2>When you need it</h2>
      <p>Charge tells you runtime, not energy: a 2,000 mAh cell delivers 2 A for one hour regardless of voltage, but the watt-hours depend on that voltage. Airlines limit lithium batteries by Wh — multiply Ah by nominal volts to check.</p>

      <h2>Sources & methodology</h2>
      <p>Conversion factors follow <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>; exact-by-definition factors are marked in the tool itself. All math runs client-side in your browser — nothing is uploaded.</p>

      <hr class="blog-divider" />
      <p class="blog-footer-note">The <a href="/electric-charge-converter">Electric Charge</a> tool is free, runs locally, and never sends your data to a server. More <a href="/converter">converter tools</a> at <a href="/">maratool.com</a>.</p>
    </BlogPostShell>
  </Layout>
</Base>
