---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Magnetic Flux Converter — Weber & Maxwell | maratool',
  description: 'Convert magnetic flux between webers, milliwebers, and maxwells instantly — 1 Wb = 10⁸ Mx exactly. Free flux unit converter in your browser.',
  canonical: 'https://maratool.com/magnetic-flux-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Magnetic Flux Converter — Weber & Maxwell',
    url: 'https://maratool.com/magnetic-flux-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert magnetic flux between webers, milliwebers, and maxwells instantly — 1 Wb = 10⁸ Mx exactly. Free flux unit converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Magnetism', item: 'https://maratool.com/converter/magnetism' },
      { '@type': 'ListItem', position: 4, name: 'Magnetic Flux Converter — Weber & Maxwell', item: 'https://maratool.com/magnetic-flux-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert weber to maxwell?', acceptedAnswer: { '@type': 'Answer', text: '1 weber = 1.0000e+8 maxwell. Choose "Weber (Wb)" as From and "Maxwell (Mx)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many maxwells are in a weber?', acceptedAnswer: { '@type': 'Answer', text: '10⁸ (100 million) — the maxwell is 1 gauss × cm² while the weber is 1 tesla × m², and both factors of 10⁴ multiply.' } },
      { '@type': 'Question', name: 'Why does a volt-second equal a weber?', acceptedAnswer: { '@type': 'Answer', text: 'Faraday’s law: EMF = −dΦ/dt. A flux change of 1 Wb in 1 s induces 1 V, so the weber is dimensionally a volt-second — useful when sizing transformer cores.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert weber to maxwell?', a: '1 weber = 1.0000e+8 maxwell. Choose "Weber (Wb)" as From and "Maxwell (Mx)" as To, type a value, and the result updates instantly.' },
  { q: 'How many maxwells are in a weber?', a: '10⁸ (100 million) — the maxwell is 1 gauss × cm² while the weber is 1 tesla × m², and both factors of 10⁴ multiply.' },
  { q: 'Why does a volt-second equal a weber?', a: 'Faraday’s law: EMF = −dΦ/dt. A flux change of 1 Wb in 1 s induces 1 V, so the weber is dimensionally a volt-second — useful when sizing transformer cores.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'magnetic-field-converter', name: 'Tesla to Gauss' },
  { slug: 'magnetic-field-strength-converter', name: 'Field Strength' },
  { slug: 'inductance-converter', name: 'Inductance Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Magnetism', href: '/converter/magnetism' },
  { label: 'Magnetic Flux' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="magnetic-flux-converter" name="Magnetic Flux Converter — Weber & Maxwell" description="Convert magnetic flux between webers, milliwebers, microwebers, maxwells, and volt-seconds." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="mxc-from-unit">From</label>
            <select id="mxc-from-unit" class="uc-select"></select>
            <input type="number" id="mxc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="mxc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="mxc-to-unit">To</label>
            <select id="mxc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="mxc-result">&mdash;</div>
            <button class="copy-btn" id="mxc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Flux is converted through the weber; the maxwell relation (10⁻⁸ Wb) is exact per <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/magnetic-flux-converter.js"></script>
