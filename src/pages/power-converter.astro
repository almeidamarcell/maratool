---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Power Converter — HP to kW, Watts & BTU/h | maratool',
  description: 'Convert horsepower to kilowatts, watts to BTU/h, and tons of refrigeration instantly with NIST factors. Free power converter in your browser.',
  canonical: 'https://maratool.com/power-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Power Converter — HP to kW, Watts & BTU/h',
    url: 'https://maratool.com/power-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert horsepower to kilowatts, watts to BTU/h, and tons of refrigeration instantly with NIST factors. Free power converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Unit', item: 'https://maratool.com/converter/unit' },
      { '@type': 'ListItem', position: 4, name: 'Power Converter — HP to kW, Watts & BTU/h', item: 'https://maratool.com/power-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert horsepower, mechanical to kilowatt?', acceptedAnswer: { '@type': 'Answer', text: '1 horsepower, mechanical = 0.7457 kilowatt. Choose "Horsepower, mechanical (hp)" as From and "Kilowatt (kW)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'What is the difference between hp and metric hp (PS)?', acceptedAnswer: { '@type': 'Answer', text: 'Mechanical hp is 745.70 W (550 ft·lbf/s); metric hp (PS/CV) is 735.50 W (75 kgf·m/s). European car specs usually quote PS — about 1.4% smaller than hp.' } },
      { '@type': 'Question', name: 'How many kW is a ton of air conditioning?', acceptedAnswer: { '@type': 'Answer', text: 'One ton of refrigeration is 12,000 BTU/h = 3.517 kW of cooling capacity. A typical home split unit is 1–2 tons.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert horsepower, mechanical to kilowatt?', a: '1 horsepower, mechanical = 0.7457 kilowatt. Choose "Horsepower, mechanical (hp)" as From and "Kilowatt (kW)" as To, type a value, and the result updates instantly.' },
  { q: 'What is the difference between hp and metric hp (PS)?', a: 'Mechanical hp is 745.70 W (550 ft·lbf/s); metric hp (PS/CV) is 735.50 W (75 kgf·m/s). European car specs usually quote PS — about 1.4% smaller than hp.' },
  { q: 'How many kW is a ton of air conditioning?', a: 'One ton of refrigeration is 12,000 BTU/h = 3.517 kW of cooling capacity. A typical home split unit is 1–2 tons.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'energy-converter', name: 'Energy Converter' },
  { slug: 'torque-converter', name: 'Torque Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Unit', href: '/converter/unit' },
  { label: 'Power Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="power-converter" name="Power Converter — HP to kW, Watts & BTU/h" description="Convert between horsepower (mechanical and metric), kilowatts, watts, BTU/h, and tons of refrigeration." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="pwc-from-unit">From</label>
            <select id="pwc-from-unit" class="uc-select"></select>
            <input type="number" id="pwc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="pwc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="pwc-to-unit">To</label>
            <select id="pwc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="pwc-result">&mdash;</div>
            <button class="copy-btn" id="pwc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the watt (SI) with conversion factors from <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/power-converter.js"></script>
