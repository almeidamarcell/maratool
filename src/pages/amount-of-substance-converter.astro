---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Mole Converter — mol, mmol, µmol & lb-mol | maratool',
  description: 'Convert moles to millimoles, micromoles, kilomoles, and pound-moles instantly. Free amount-of-substance converter that runs in your browser.',
  canonical: 'https://maratool.com/amount-of-substance-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Amount of Substance Converter — Moles & Millimoles',
    url: 'https://maratool.com/amount-of-substance-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert moles to millimoles, micromoles, kilomoles, and pound-moles instantly. Free amount-of-substance converter that runs in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Science', item: 'https://maratool.com/converter/science' },
      { '@type': 'ListItem', position: 4, name: 'Amount of Substance Converter — Moles & Millimoles', item: 'https://maratool.com/amount-of-substance-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert millimole to mole?', acceptedAnswer: { '@type': 'Answer', text: '1 millimole = 0.001 mole. Choose "Millimole (mmol)" as From and "Mole (mol)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'How many molecules are in a mole?', acceptedAnswer: { '@type': 'Answer', text: 'Exactly 6.02214076 × 10²³ elementary entities (the 2019 SI definition of the Avogadro constant). A millimole contains a thousandth of that.' } },
      { '@type': 'Question', name: 'What is a pound-mole?', acceptedAnswer: { '@type': 'Answer', text: 'A pound-mole is the amount of substance whose mass in pounds equals the molecular weight — exactly 453.59237 mol. US chemical-engineering texts use it alongside lb/ft³ and BTU.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert millimole to mole?', a: '1 millimole = 0.001 mole. Choose "Millimole (mmol)" as From and "Mole (mol)" as To, type a value, and the result updates instantly.' },
  { q: 'How many molecules are in a mole?', a: 'Exactly 6.02214076 × 10²³ elementary entities (the 2019 SI definition of the Avogadro constant). A millimole contains a thousandth of that.' },
  { q: 'What is a pound-mole?', a: 'A pound-mole is the amount of substance whose mass in pounds equals the molecular weight — exactly 453.59237 mol. US chemical-engineering texts use it alongside lb/ft³ and BTU.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'molar-mass-converter', name: 'Molar Mass Converter' },
  { slug: 'density-converter', name: 'Density Converter' },
  { slug: 'unit-converter', name: 'Unit Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Science', href: '/converter/science' },
  { label: 'Amount of Substance' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="amount-of-substance-converter" name="Amount of Substance Converter — Moles & Millimoles" description="Convert between moles, millimoles, micromoles, nanomoles, kilomoles, and pound-moles." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="aoc-from-unit">From</label>
            <select id="aoc-from-unit" class="uc-select"></select>
            <input type="number" id="aoc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="aoc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="aoc-to-unit">To</label>
            <select id="aoc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="aoc-result">&mdash;</div>
            <button class="copy-btn" id="aoc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the mole, the SI base unit for amount of substance defined in the <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener" target="_blank">BIPM SI Brochure</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/amount-of-substance-converter.js"></script>
