---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Split GIF into Parts Online | maratool',
  description: 'Split a GIF into parts online. Cut an animated GIF into separate segments by frame range and download each piece. Free, no upload, no watermark.',
  canonical: 'https://maratool.com/gif-split',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Split GIF into Parts Online',
    url: 'https://maratool.com/gif-split',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Split a GIF into parts online. Cut an animated GIF into separate segments by frame range and download each piece. Free, no upload, no watermark.',
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Do the parts stay animated?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Every part is written as its own animated GIF, keeping the original per-frame delays and the same loop setting as the file you uploaded.' } },
      { '@type': 'Question', name: 'Can I split at exact frames?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Type ranges like 1-12, 13-24 — the first frame is 1 and both ends are included — or click any frame on the timeline to start a new part there.' } },
      { '@type': 'Question', name: 'How do I get separate images instead?', acceptedAnswer: { '@type': 'Answer', text: 'Use GIF to Frames. It writes every frame as a PNG. This page cuts one animation into shorter animations.' } },
      { '@type': 'Question', name: 'Is there a file size limit?', acceptedAnswer: { '@type': 'Answer', text: 'GIF tools: up to 50 MB. Very large GIFs are scaled down so they fit in browser memory.' } },
    ],
  },
}

const howTo = [
  'Drop your GIF in — every frame shows up on the timeline.',
  'Choose equal parts, a frame count per part, typed ranges, or click the timeline to place your own cut points.',
  'Click Split GIF, then download each part or take all of them as a ZIP.',
]

const faq = [
  { q: 'Do the parts stay animated?', a: 'Yes. Every part is written as its own animated GIF, keeping the original per-frame delays and the same loop setting as the file you uploaded.' },
  { q: 'Can I split at exact frames?', a: 'Yes. Type ranges like 1-12, 13-24 — the first frame is 1 and both ends are included — or click any frame on the timeline to start a new part there.' },
  { q: 'How do I get separate images instead?', a: 'Use GIF to Frames. It writes every frame as a PNG. This page cuts one animation into shorter animations.' },
  { q: 'Is there a file size limit?', a: 'GIF: 50 MB. Very large GIFs are scaled down so they fit in browser memory, and the tool says so when it does that.' },
]

const relatedTools = [
  { slug: 'gif-to-frames', name: 'GIF to Frames' },
  { slug: 'gif-cut', name: 'Cut GIF' },
  { slug: 'gif-compressor', name: 'GIF Compressor' },
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Image', href: '/image' },
  { label: 'Animated', href: '/image/animated' },
  { label: 'Split GIF into Parts Online' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="gif-split" name="Split GIF into Parts Online" description="Split GIF into Parts Online. Free, runs in your browser — no upload to servers." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:420px;" data-ui="gif-ext">
        <p class="tool-hint">Upload a file to get started. Processing runs entirely in your browser.</p>
        <div id="ez-root" data-slug="gif-split"></div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .ga-dropzone, .ef-dropzone { border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; }
  .ga-dropzone:hover, .ef-dropzone:hover { background: var(--bg-hover); }
</style>

<script src="../tools/gif-split.js"></script>
