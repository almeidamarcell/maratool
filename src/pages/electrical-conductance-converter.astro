---
import Base from '../layouts/Base.astro'
import Layout from '../components/Layout.astro'
import ToolShell from '../components/ToolShell.astro'

const seo = {
  title: 'Conductance Converter — Siemens, Mho, µS | maratool',
  description: 'Convert electrical conductance between siemens, millisiemens, microsiemens, and mho instantly. Free conductance unit converter in your browser.',
  canonical: 'https://maratool.com/electrical-conductance-converter',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Electrical Conductance Converter — Siemens & Mho',
    url: 'https://maratool.com/electrical-conductance-converter',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Convert electrical conductance between siemens, millisiemens, microsiemens, and mho instantly. Free conductance unit converter in your browser.',
  },
  breadcrumbSchema: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maratool.com' },
      { '@type': 'ListItem', position: 2, name: 'Converter', item: 'https://maratool.com/converter' },
      { '@type': 'ListItem', position: 3, name: 'Electrical', item: 'https://maratool.com/converter/electrical' },
      { '@type': 'ListItem', position: 4, name: 'Electrical Conductance Converter — Siemens & Mho', item: 'https://maratool.com/electrical-conductance-converter' },
    ],
  },
  faqSchema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I convert microsiemens to millisiemens?', acceptedAnswer: { '@type': 'Answer', text: '1 microsiemens = 0.001 millisiemens. Choose "Microsiemens (µS)" as From and "Millisiemens (mS)" as To, type a value, and the result updates instantly.' } },
      { '@type': 'Question', name: 'Is a mho the same as a siemens?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — mho ("ohm" backwards) is the pre-SI name. 1 ℧ = 1 S exactly. Older US schematics and tube datasheets still show µmhos.' } },
      { '@type': 'Question', name: 'What does µS/cm mean on a water meter?', acceptedAnswer: { '@type': 'Answer', text: 'That is conductivity (conductance × cell geometry), not plain conductance. Drinking water runs 50–800 µS/cm; deionized water is below 1 µS/cm. Convert the numeric prefix here; the /cm stays.' } },
      { '@type': 'Question', name: 'Is my data sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' } }
    ]
  }
}

const howTo = [
  'Choose the units to convert from and to.',
  'Enter a value — the converted result updates instantly.',
  'Click Copy to copy the result to your clipboard.'
]

const faq = [
  { q: 'How do I convert microsiemens to millisiemens?', a: '1 microsiemens = 0.001 millisiemens. Choose "Microsiemens (µS)" as From and "Millisiemens (mS)" as To, type a value, and the result updates instantly.' },
  { q: 'Is a mho the same as a siemens?', a: 'Yes — mho ("ohm" backwards) is the pre-SI name. 1 ℧ = 1 S exactly. Older US schematics and tube datasheets still show µmhos.' },
  { q: 'What does µS/cm mean on a water meter?', a: 'That is conductivity (conductance × cell geometry), not plain conductance. Drinking water runs 50–800 µS/cm; deionized water is below 1 µS/cm. Convert the numeric prefix here; the /cm stays.' },
  { q: 'Is my data sent to a server?', a: 'No. Conversions run entirely in your browser using fixed factors — nothing is uploaded or logged.' }
]

const relatedTools = [
  { slug: 'electrical-resistance-converter', name: 'Resistance Converter' },
  { slug: 'electric-current-converter', name: 'Electric Current' },
  { slug: 'capacitance-converter', name: 'Capacitance Converter' }
]

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Converter', href: '/converter' },
  { label: 'Electrical', href: '/converter/electrical' },
  { label: 'Conductance Converter' },
]
---
<Base {...seo}>
  <Layout>
    <ToolShell slug="electrical-conductance-converter" name="Electrical Conductance Converter — Siemens & Mho" description="Convert between siemens, millisiemens, microsiemens, kilosiemens, and mho." howTo={howTo} faq={faq} relatedTools={relatedTools} breadcrumbs={breadcrumbs}>
      <div class="tool-container" style="min-height:340px;">
        <div class="uc-converter">
          <div class="uc-col">
            <label class="tool-label" for="cdc-from-unit">From</label>
            <select id="cdc-from-unit" class="uc-select"></select>
            <input type="number" id="cdc-from-value" class="tool-input uc-value" placeholder="1" step="any" />
          </div>
          <div class="uc-swap-col">
            <button class="uc-swap-btn" id="cdc-swap" title="Swap units">&hArr;</button>
          </div>
          <div class="uc-col">
            <label class="tool-label" for="cdc-to-unit">To</label>
            <select id="cdc-to-unit" class="uc-select"></select>
            <div class="uc-result" id="cdc-result">&mdash;</div>
            <button class="copy-btn" id="cdc-copy">Copy</button>
          </div>
        </div>
        <div class="tool-note"><strong>How this conversion works.</strong> Every unit is converted through the siemens (Ω⁻¹); the mho is an exact synonym per <a href="https://www.nist.gov/pml/special-publication-811" rel="noopener" target="_blank">NIST Special Publication 811</a>.</div>
      </div>
    </ToolShell>
  </Layout>
</Base>

<style is:global>
  .uc-converter { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; }
  .uc-col { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .uc-select { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text); font-size: 14px; margin-bottom: 0.75rem; cursor: pointer; }
  .uc-value { width: 100%; font-size: 18px; font-family: var(--font-mono); }
  .uc-result { font-size: 24px; font-weight: 700; font-family: var(--font-mono); color: var(--text); margin-bottom: 0.5rem; min-height: 36px; word-break: break-all; }
  .uc-swap-col { display: flex; align-items: center; padding-top: 2rem; }
  .uc-swap-btn { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--text-2); font-size: 18px; cursor: pointer; transition: background 0.1s; }
  .uc-swap-btn:hover { background: var(--bg-soft); }
  @media (max-width: 600px) {
    .uc-converter { grid-template-columns: 1fr; }
    .uc-swap-col { justify-content: center; padding-top: 0; }
  }
</style>
<script src="../tools/electrical-conductance-converter.js"></script>
