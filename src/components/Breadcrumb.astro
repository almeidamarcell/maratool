---
interface Props {
  crumbs: Array<{ label: string; href?: string }>
}

const { crumbs: rawCrumbs } = Astro.props

// Internal paths must end with a trailing slash: Cloudflare Pages
// 308-redirects /foo to /foo/, so a slash-less link costs a redirect hop
// on every crawl. Normalize here so no caller can regress it.
const crumbs = rawCrumbs.map(c =>
  c.href && c.href.startsWith('/') && !c.href.endsWith('/')
    ? { ...c, href: c.href + '/' }
    : c
)
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  {crumbs.map((crumb, i) => (
    <span class="breadcrumb-item">
      {i > 0 && <span class="breadcrumb-sep" aria-hidden="true">/</span>}
      {crumb.href
        ? <a href={crumb.href} class="breadcrumb-link">{crumb.label}</a>
        : <span class="breadcrumb-current">{crumb.label}</span>
      }
    </span>
  ))}
</nav>
